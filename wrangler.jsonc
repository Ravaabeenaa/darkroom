{
	"main": "dist/_worker.js/index.js",
	"name": "darkroom",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "darkroom_db",
			"database_name": "darkroom-db",
			"database_id": "5d797876-7649-4278-b4b6-bc34a7a0ddda",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "darkroom_media",
			"bucket_name": "darkroom-media"
			// Optional for dev if you want to hit real R2:
			// "preview_bucket_name": "darkroom-media"
		}
	]
}