{
	"name": "darkroom",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "darkroom_db",
			"database_name": "darkroom-db",
			"database_id": "5d797876-7649-4278-b4b6-bc34a7a0ddda"
		}
	],
	"r2_buckets": [
		{
			"binding": "darkroom_media",
			"bucket_name": "darkroom-media"
		}
	]
}