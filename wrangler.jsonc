{
	"main": "dist/_worker.js/index.js",
	"name": "darkroom",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_R2_BASE_URL": "https://pub-da6e4b2286444b0ead95261c71155038.r2.dev"
	},
	"d1_databases": [
		{
			"binding": "darkroom_db",
			"database_name": "darkroom-db",
			"database_id": "5d797876-7649-4278-b4b6-bc34a7a0ddda"
		}
	],
	"r2_buckets": [
		{
			"binding": "darkroom_media",
			"bucket_name": "darkroom-media"
		}
	]
}
