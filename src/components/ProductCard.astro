---
const {
  id, // REQUIRED for cart controls
  href = "/shop/sample",
  image,
  name = "Product Name",
  priceCents, // number (cents)
  compareAtCents, // optional
  badge, // optional "SALE"
} = Astro.props;

if (!id) {
  throw new Error("ProductCard requires prop: id");
}
---

<article data-dr-product-card data-id={id} class="rounded-3xl border border-[var(--line)] bg-white/20 p-4">
  <a href={href} class="block overflow-hidden rounded-2xl border border-[var(--line)] bg-white/20">
    {image ? (
      <img src={image} alt={name} class="aspect-[4/3] w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex aspect-[4/3] w-full items-center justify-center text-xs" style="color: var(--muted);">
        No image
      </div>
    )}
  </a>

  <div class="mt-4 flex flex-col gap-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        {badge && (
          <span class="rounded-full bg-[var(--red)] px-2 py-0.5 text-[11px] text-black">{badge}</span>
        )}
        <a href={href} class="truncate text-sm font-semibold hover:opacity-70">{name}</a>
      </div>

      <div class="mt-1 text-sm">
        <span class="font-medium" data-price-cents={priceCents}></span>
        {compareAtCents && (
          <span class="ml-2 text-xs line-through" style="color: var(--muted);" data-compare-cents={compareAtCents}></span>
        )}
      </div>
    </div>

    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 rounded-[999px] border border-[var(--line)] bg-white/40 px-2 py-1">
        <button type="button" class="h-7 w-7 cursor-pointer rounded-full hover:bg-white/70" data-dec aria-label="Decrease">−</button>
        <span class="w-6 text-center text-sm tabular-nums" data-dr-cart-qty={id}>0</span>
        <button type="button" class="h-7 w-7 cursor-pointer rounded-full hover:bg-white/70" data-inc aria-label="Increase">+</button>
      </div>
      <span class="text-[11px]" style="color: var(--muted);">🛒 Add to cart</span>
    </div>
  </div>
</article>

<script is:inline>
  (function () {
    const card = document.currentScript?.previousElementSibling;
    if (!card) return;

    const id = card.getAttribute("data-id");
    if (!id) return;

    const incBtn = card.querySelector("[data-inc]");
    const decBtn = card.querySelector("[data-dec]");
    const qtyEl = card.querySelector(`[data-dr-cart-qty="${id}"]`);

    // Price formatting
    const priceEl = card.querySelector("[data-price-cents]");
    if (priceEl && window.DarkroomCart) {
      const cents = Number(priceEl.getAttribute("data-price-cents") || "0");
      priceEl.textContent = window.DarkroomCart.formatMVR(cents);
    }
    const compareEl = card.querySelector("[data-compare-cents]");
    if (compareEl && window.DarkroomCart) {
      const cents = Number(compareEl.getAttribute("data-compare-cents") || "0");
      compareEl.textContent = window.DarkroomCart.formatMVR(cents);
    }

    function render() {
      if (!window.DarkroomCart || !qtyEl) return;
      qtyEl.textContent = String(window.DarkroomCart.getQty(id));
    }

    incBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      window.DarkroomCart?.inc(id);
      window.DarkroomCart?.toast("Added to cart");
      render();
    });

    decBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const before = window.DarkroomCart?.getQty(id) || 0;
      window.DarkroomCart?.dec(id);
      const after = window.DarkroomCart?.getQty(id) || 0;
      if (before > 0 && after < before) window.DarkroomCart?.toast("Removed from cart");
      render();
    });

    window.addEventListener("dr-cart-changed", render);
    render();
  })();
</script>