---
type OptionGroup = { name: string; options: string[]; prices: string[] };

const {
  id,
  href = "/shop/sample",
  image,
  name = "Product Name",
  priceCents,
  compareAtCents,
  badge,
  outOfStock = false,
  serviceOptions = [] as OptionGroup[],
} = Astro.props;

if (!id) throw new Error("ProductCard requires prop: id");

// ── Default selections: first option of each group ─────────────────
const defaultSelections: Record<string, string> = {};
for (const g of serviceOptions) {
  if (g.options?.[0]) defaultSelections[g.name] = g.options[0];
}
const hasOptions = Object.keys(defaultSelections).length > 0;

// ── Composite cart key with defaults baked in ─────────────────────
function makeKey(selections: Record<string, string>): string {
  const groupNames = Object.keys(selections).sort();
  if (!groupNames.length) return id;
  return `${id}~${groupNames.map((g) => `${g}=${selections[g]}`).join("~")}`;
}
const cartKey = makeKey(defaultSelections);

// ── Display price = base + default option prices ──────────────────
function parseOptCents(str: string): number {
  return Math.round((parseFloat(str.replace(/^\+/, "")) || 0) * 100);
}
const displayPrice = priceCents + serviceOptions.reduce((sum: number, g: OptionGroup) => sum + (g.prices?.[0] ? parseOptCents(g.prices[0]) : 0), 0);

const defaultLabels = Object.values(defaultSelections);
---

<article data-dr-product-card data-id={cartKey} data-out-of-stock={outOfStock ? "1" : ""} class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-4 flex flex-col">
  <a href={href} class="block overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--panel)]">
    {image ? (
      <img src={image} alt={name} class="aspect-[4/3] w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex aspect-[4/3] w-full items-center justify-center text-xs" style="color: var(--muted);">
        No image
      </div>
    )}
  </a>

  <div class="mt-4 flex flex-1 flex-col gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex items-start gap-2">
        {badge && (
          <span class="mt-0.5 shrink-0 rounded-full bg-[var(--red)] px-2 py-0.5 text-xs text-black">{badge}</span>
        )}
        <a href={href} class="line-clamp-2 text-sm font-semibold leading-snug hover:opacity-70 active:opacity-70">{name}</a>
      </div>

      <div class="mt-1 text-sm">
        <span class="font-medium" data-price-cents={displayPrice}></span>
        {compareAtCents && (
          <span class="ml-2 text-xs line-through" style="color: var(--muted);" data-compare-cents={compareAtCents}></span>
        )}
      </div>

      {/* Default option chips */}
      {defaultLabels.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1">
          {defaultLabels.map(label => (
            <span class="rounded-full border border-[var(--line)] px-2 py-0.5 text-xs leading-tight" style="color: var(--muted);">
              {label}
            </span>
          ))}
        </div>
      )}
    </div>

    {outOfStock ? (
      <span class="rounded-full border border-[var(--line)] px-3 py-1.5 text-xs font-medium self-start" style="color: var(--muted);">
        Out of stock
      </span>
    ) : (
      <div class="space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-0.5 rounded-full border border-[var(--line)] bg-white/40 px-1 py-0.5" data-qty-wrap>
            <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-full hover:bg-white/70 active:bg-white/70 text-sm leading-none" data-dec aria-label="Decrease">−</button>
            <span class="w-5 text-center text-sm tabular-nums" data-pending-qty>1</span>
            <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-full hover:bg-white/70 active:bg-white/70 text-sm leading-none" data-inc aria-label="Increase">+</button>
          </div>
          <button type="button" class="cart-icon-btn flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center hover:opacity-75 active:opacity-75" data-add-to-cart aria-label="Add to cart">
            <span class="cart-icon-mask" aria-hidden="true"></span>
          </button>
        </div>
        <div class="flex items-center justify-between gap-2">
          <a href="/cart" class="text-xs underline underline-offset-2 hover:opacity-70 active:opacity-70" style="color: var(--muted);">
            View cart
          </a>
          {hasOptions && (
            <a href={href} class="text-xs underline underline-offset-2 hover:opacity-70 active:opacity-70" style="color: var(--muted);">
              Customise options →
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</article>

<style>
  .cart-icon-mask {
    width: 22px;
    height: 22px;
    background-color: var(--red);
    -webkit-mask-image: url('/icons/add_to_cart.png');
    mask-image: url('/icons/add_to_cart.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
</style>

<script is:inline>
  (function () {
    var card = document.currentScript?.previousElementSibling;
    if (!card) return;

    var cartKey = card.getAttribute("data-id");
    if (!cartKey) return;

    var incBtn    = card.querySelector("[data-inc]");
    var decBtn    = card.querySelector("[data-dec]");
    var pendingEl = card.querySelector("[data-pending-qty]");
    var addBtn    = card.querySelector("[data-add-to-cart]");

    // Price formatting
    var priceEl = card.querySelector("[data-price-cents]");
    if (priceEl && window.DarkroomCart) {
      priceEl.textContent = window.DarkroomCart.formatMVR(Number(priceEl.getAttribute("data-price-cents") || "0"));
    }
    var compareEl = card.querySelector("[data-compare-cents]");
    if (compareEl && window.DarkroomCart) {
      compareEl.textContent = window.DarkroomCart.formatMVR(Number(compareEl.getAttribute("data-compare-cents") || "0"));
    }

    var pending = 1;

    function renderPending() {
      if (pendingEl) pendingEl.textContent = String(pending);
    }

    var shopClosed  = document.body.dataset.shopClosed === "1";
    var isOutOfStock = card.dataset.outOfStock === "1";

    if (shopClosed || isOutOfStock) {
      if (incBtn) incBtn.disabled = true;
      if (decBtn) decBtn.disabled = true;
      if (addBtn) addBtn.disabled = true;
    } else {
      incBtn && incBtn.addEventListener("click", function (e) {
        e.preventDefault(); e.stopPropagation();
        pending++;
        renderPending();
      });

      decBtn && decBtn.addEventListener("click", function (e) {
        e.preventDefault(); e.stopPropagation();
        if (pending > 1) { pending--; renderPending(); }
      });

      addBtn && addBtn.addEventListener("click", function (e) {
        e.preventDefault(); e.stopPropagation();
        if (!window.DarkroomCart) return;
        var current = window.DarkroomCart.getQty(cartKey);
        window.DarkroomCart.setQty(cartKey, current + pending);
        window.DarkroomCart.toast("Added to cart");
        pending = 1;
        renderPending();
      });
    }

    renderPending();
  })();
</script>
