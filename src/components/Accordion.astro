---
const { items = [] } = Astro.props;
/**
 * items: [{ title: string, content: string }]
 */
---
<div class="divide-y" style="border-color: var(--line);">
  {items.map((it, idx) => (
    <details class="py-4" open={idx === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg">
        <span style="font-family: var(--font-serif);">{it.title}</span>
        <span class="text-xl" style="color: var(--muted);">+</span>
      </summary>
      <div class="mt-4 max-w-md text-sm leading-6" style="color: var(--muted);">
        {it.content}
      </div>
    </details>
  ))}
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  details[open] summary span:last-child { transform: rotate(45deg); display: inline-block; }
</style>
