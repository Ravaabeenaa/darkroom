---
/**
 * ServiceGallery
 *
 * Props:
 *   primary  – { src: string; alt: string } | null   — primary image
 *   gallery  – { src: string; alt: string }[]         — additional images (ordered)
 */

interface Props {
  primary: { src: string; alt: string } | null;
  gallery: { src: string; alt: string }[];
}

const { primary, gallery } = Astro.props;

// Build the full ordered image list: primary first, then gallery
const allImages = [
  ...(primary ? [primary] : []),
  ...gallery,
];

const hasImages = allImages.length > 0;
const showStrip  = allImages.length > 1;
---

<div class="sg-root">

  <!-- ── Main stage ─────────────────────────────────── -->
  <div class="sg-stage">
    {hasImages ? (
      <img
        id="sg-main"
        src={allImages[0].src}
        alt={allImages[0].alt}
        class="sg-main-img"
      />
    ) : (
      <div class="sg-empty">No image</div>
    )}

    <!-- index counter: 01 / 05 -->
    {allImages.length > 1 && (
      <div class="sg-counter" id="sg-counter">
        <span id="sg-counter-cur">01</span>
        <span class="sg-counter-sep">/</span>
        <span>{String(allImages.length).padStart(2, "0")}</span>
      </div>
    )}

    <!-- zoom hint -->
    {hasImages && (
      <div class="sg-zoom-hint" id="sg-zoom-hint">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M6 4v4M4 6h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        zoom
      </div>
    )}
  </div>

  <!-- ── Film-strip thumbnails ──────────────────────── -->
  {showStrip && (
    <div class="sg-strip-wrap">
      <!-- sprocket perforations top -->
      <div class="sg-perfs sg-perfs-top" aria-hidden="true">
        {Array.from({ length: 20 }).map(() => <span class="sg-perf" />)}
      </div>

      <div class="sg-strip" id="sg-strip">
        {allImages.map((img, i) => (
          <button
            type="button"
            class={`sg-thumb ${i === 0 ? "is-active" : ""}`}
            data-index={i}
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`View image ${i + 1}`}
          >
            <img src={img.src} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} />
            <span class="sg-thumb-num">{String(i + 1).padStart(2, "0")}</span>
          </button>
        ))}
      </div>

      <!-- sprocket perforations bottom -->
      <div class="sg-perfs sg-perfs-bottom" aria-hidden="true">
        {Array.from({ length: 20 }).map(() => <span class="sg-perf" />)}
      </div>
    </div>
  )}

</div>

<!-- ── Lightbox ──────────────────────────────────────── -->
<div class="sg-lb" id="sg-lb" role="dialog" aria-modal="true" aria-label="Image viewer" style="display:none">
  <div class="sg-lb-backdrop" id="sg-lb-backdrop"></div>

  <button class="sg-lb-close" id="sg-lb-close" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>

  <button class="sg-lb-nav sg-lb-prev" id="sg-lb-prev" aria-label="Previous image">
    <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M9 1L1 9l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="sg-lb-nav sg-lb-next" id="sg-lb-next" aria-label="Next image">
    <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M1 1l8 8-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <div class="sg-lb-stage">
    <img class="sg-lb-img" id="sg-lb-img" src="" alt="" />
  </div>

  <div class="sg-lb-counter" id="sg-lb-counter"></div>
</div>

<style>
  /* ── Root ─────────────────────────────────────────── */
  .sg-root {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Main stage ───────────────────────────────────── */
  .sg-stage {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--panel);
    cursor: zoom-in;
  }

  .sg-main-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.22s ease;
  }
  .sg-main-img.is-fading { opacity: 0; }

  .sg-empty {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-sans);
  }

  /* counter chip */
  .sg-counter {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: rgba(238,228,210,0.75);
    pointer-events: none;
  }
  .sg-counter-sep { opacity: 0.4; }

  /* zoom hint — desktop only (touch devices can't hover to open lightbox) */
  .sg-zoom-hint {
    display: none;
  }
  @media (min-width: 768px) {
    .sg-zoom-hint {
      display: flex;
      position: absolute;
      bottom: 12px;
      right: 12px;
      align-items: center;
      gap: 5px;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(6px);
      font-family: var(--font-sans);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(238,228,210,0.6);
      pointer-events: none;
      transition: opacity 0.2s;
    }
    .sg-stage:hover .sg-zoom-hint { opacity: 0; }
  }

  /* ── Film strip ───────────────────────────────────── */
  .sg-strip-wrap {
    margin-top: 10px;
    background: #0a0a0a;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
    position: relative;
  }

  /* sprocket holes */
  .sg-perfs {
    display: flex;
    gap: 0;
    padding: 0 4px;
    height: 8px;
    align-items: center;
    overflow: hidden;
  }
  .sg-perfs-top  { background: #111; border-bottom: 1px solid #1a1a1a; }
  .sg-perfs-bottom { background: #111; border-top: 1px solid #1a1a1a; }

  .sg-perf {
    flex: 0 0 18px;
    height: 4px;
    border-radius: 1px;
    background: #2a2a2a;
    margin-right: 10px;
  }

  /* scrollable row */
  .sg-strip {
    display: flex;
    gap: 3px;
    padding: 6px 6px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .sg-strip::-webkit-scrollbar { display: none; }

  /* individual thumb */
  .sg-thumb {
    flex: 0 0 68px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
    position: relative;
  }

  .sg-thumb img {
    display: block;
    width: 68px;
    height: 54px;
    object-fit: cover;
    border-radius: 3px;
    border: 2px solid transparent;
    transition: border-color 0.15s, opacity 0.15s;
    opacity: 0.55;
  }

  .sg-thumb:hover img { opacity: 0.85; border-color: rgba(238,228,210,0.3); }
  .sg-thumb.is-active img { opacity: 1; border-color: #ED1C24; }

  .sg-thumb-num {
    font-family: var(--font-sans);
    font-size: 8px;
    letter-spacing: 0.05em;
    color: rgba(238,228,210,0.25);
  }
  .sg-thumb.is-active .sg-thumb-num { color: rgba(238,228,210,0.6); }

  /* ── Lightbox ─────────────────────────────────────── */
  .sg-lb {
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .sg-lb-backdrop {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.96;
  }

  .sg-lb-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 60px) clamp(16px, 8vw, 80px);
    max-width: 100vw;
    max-height: 100vh;
  }

  .sg-lb-img {
    display: block;
    max-width: min(90vw, 1100px);
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.07);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .sg-lb-img.is-fading { opacity: 0; transform: scale(0.97); }

  /* nav arrows */
  .sg-lb-nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(238,228,210,0.8);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    outline: none;
  }
  .sg-lb-nav:hover {
    background: rgba(237,28,36,0.25);
    border-color: rgba(237,28,36,0.5);
    color: #fff;
  }
  .sg-lb-prev { left: 20px; }
  .sg-lb-next { right: 20px; }

  /* close button */
  .sg-lb-close {
    position: absolute;
    z-index: 2;
    top: max(16px, env(safe-area-inset-top));
    right: max(20px, env(safe-area-inset-right));
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(238,228,210,0.7);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    outline: none;
  }
  .sg-lb-close:hover { background: rgba(255,255,255,0.14); color: #fff; }

  /* lightbox counter */
  .sg-lb-counter {
    position: absolute;
    z-index: 2;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(238,228,210,0.35);
    pointer-events: none;
  }
</style>

<script define:vars={{ allImages }}>
  (function () {
    if (!allImages.length) return;

    const mainImg    = document.getElementById("sg-main");
    const counter    = document.getElementById("sg-counter-cur");
    const strip      = document.getElementById("sg-strip");
    const lb         = document.getElementById("sg-lb");
    const lbImg      = document.getElementById("sg-lb-img");
    const lbClose    = document.getElementById("sg-lb-close");
    const lbPrev     = document.getElementById("sg-lb-prev");
    const lbNext     = document.getElementById("sg-lb-next");
    const lbCounter  = document.getElementById("sg-lb-counter");
    const thumbBtns  = strip ? Array.from(strip.querySelectorAll(".sg-thumb")) : [];

    let activeIndex = 0;
    let lbOpen      = false;
    let lbIndex     = 0;

    // ── Thumbnail click → swap main image ─────────────
    function setActive(idx) {
      if (idx === activeIndex) return;
      activeIndex = idx;
      const img = allImages[idx];

      thumbBtns.forEach((b, i) => {
        b.classList.toggle("is-active", i === idx);
      });

      if (counter) counter.textContent = String(idx + 1).padStart(2, "0");

      if (mainImg && mainImg.tagName === "IMG") {
        mainImg.classList.add("is-fading");
        setTimeout(() => {
          mainImg.src = img.src;
          mainImg.alt = img.alt;
          mainImg.onload = () => mainImg.classList.remove("is-fading");
          // Fallback in case onload already fired (cached)
          if (mainImg.complete) mainImg.classList.remove("is-fading");
        }, 120);
      }
    }

    thumbBtns.forEach((btn, i) => {
      btn.addEventListener("click", () => setActive(i));
    });

    // ── Lightbox ───────────────────────────────────────
    function openLb(idx) {
      lbIndex = ((idx % allImages.length) + allImages.length) % allImages.length;
      lbImg.src = allImages[lbIndex].src;
      lbImg.alt = allImages[lbIndex].alt;
      updateLbCounter();
      lb.style.display = "flex";
      lbOpen = true;
      document.body.style.overflow = "hidden";
    }

    function closeLb() {
      lb.style.display = "none";
      lbOpen = false;
      document.body.style.overflow = "";
    }

    function lbNavigate(idx) {
      const next = ((idx % allImages.length) + allImages.length) % allImages.length;
      lbImg.classList.add("is-fading");
      setTimeout(() => {
        lbIndex = next;
        lbImg.src = allImages[lbIndex].src;
        lbImg.alt = allImages[lbIndex].alt;
        lbImg.onload = () => lbImg.classList.remove("is-fading");
        if (lbImg.complete) lbImg.classList.remove("is-fading");
        updateLbCounter();
      }, 110);
    }

    function updateLbCounter() {
      if (lbCounter) lbCounter.textContent = `${lbIndex + 1} / ${allImages.length}`;
    }

    if (mainImg) {
      mainImg.addEventListener("click", () => openLb(activeIndex));
    }

    lbClose?.addEventListener("click", closeLb);
    document.getElementById("sg-lb-backdrop")?.addEventListener("click", closeLb);
    lbPrev?.addEventListener("click", () => lbNavigate(lbIndex - 1));
    lbNext?.addEventListener("click", () => lbNavigate(lbIndex + 1));

    document.addEventListener("keydown", (e) => {
      if (!lbOpen) return;
      if (e.key === "Escape")     { e.preventDefault(); closeLb(); }
      if (e.key === "ArrowLeft")  { e.preventDefault(); lbNavigate(lbIndex - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); lbNavigate(lbIndex + 1); }
    });

    // Hide nav arrows when only one image
    if (allImages.length <= 1) {
      lbPrev?.style.setProperty("display", "none");
      lbNext?.style.setProperty("display", "none");
    }
  })();
</script>
