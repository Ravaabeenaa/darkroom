---
/**
 * ServiceGallery
 *
 * Props:
 *   primary  – { src: string; alt: string } | null   — primary image
 *   gallery  – { src: string; alt: string }[]         — additional images (ordered)
 */

interface Props {
  primary: { src: string; alt: string } | null;
  gallery: { src: string; alt: string }[];
}

const { primary, gallery } = Astro.props;

// Build the full ordered image list: primary first, then gallery
const allImages = [
  ...(primary ? [primary] : []),
  ...gallery,
];

const hasImages = allImages.length > 0;
const showStrip  = allImages.length > 1;
---

<div class="sg-root">

  <!-- ── Main stage ─────────────────────────────────── -->
  <div class="sg-stage" id="sg-stage">
    {hasImages ? (
      <img
        id="sg-main"
        src={allImages[0].src}
        alt={allImages[0].alt}
        class="sg-main-img"
      />
    ) : (
      <div class="sg-empty">No image</div>
    )}

    <!-- index counter: 01 / 05 -->
    {allImages.length > 1 && (
      <div class="sg-counter" id="sg-counter">
        <span id="sg-counter-cur">01</span>
        <span class="sg-counter-sep">/</span>
        <span>{String(allImages.length).padStart(2, "0")}</span>
      </div>
    )}

    <!-- zoom hint -->
    {hasImages && (
      <div class="sg-zoom-hint" id="sg-zoom-hint">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M6 4v4M4 6h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        zoom
      </div>
    )}

    <!-- arrow controls -->
    {allImages.length > 1 && (
      <>
        <button class="sg-arrow sg-arrow-l" id="sg-prev" aria-label="Previous image">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 2 4 7l5 5"/>
          </svg>
        </button>
        <button class="sg-arrow sg-arrow-r" id="sg-next" aria-label="Next image">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 2l5 5-5 5"/>
          </svg>
        </button>
      </>
    )}
  </div>

  <!-- ── Thumbnails ──────────────────────── -->
  {showStrip && (
    <div class="sg-strip-wrap">
      <div class="sg-strip" id="sg-strip">
        {allImages.map((img, i) => (
          <button
            type="button"
            class={`sg-thumb ${i === 0 ? "is-active" : ""}`}
            data-index={i}
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`View image ${i + 1}`}
          >
            <img src={img.src} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} />
          </button>
        ))}
      </div>
    </div>
  )}

</div>

<style>
  /* ── Root ─────────────────────────────────────────── */
  .sg-root {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Main stage ───────────────────────────────────── */
  .sg-stage {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--panel);
    cursor: zoom-in;
  }

  .sg-main-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--primary-image-aspect);
    object-fit: cover;
    transition: opacity 0.22s ease;
  }
  .sg-main-img.is-fading { opacity: 0; }

  .sg-empty {
    aspect-ratio: var(--primary-image-aspect);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-sans);
  }

  /* counter chip */
  .sg-counter {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: rgba(238,228,210,0.75);
    pointer-events: none;
  }
  .sg-counter-sep { opacity: 0.4; }

  /* zoom hint — desktop only (touch devices can't hover to open lightbox) */
  .sg-zoom-hint {
    display: none;
  }
  @media (min-width: 768px) {
    .sg-zoom-hint {
      display: flex;
      position: absolute;
      bottom: 12px;
      right: 12px;
      align-items: center;
      gap: 5px;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(6px);
      font-family: var(--font-sans);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(238,228,210,0.6);
      pointer-events: none;
      transition: opacity 0.2s;
    }
    .sg-stage:hover .sg-zoom-hint { opacity: 0; }
  }

  /* ── Arrow controls ───────────────────────────────── */
  .sg-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(238, 228, 210, 0.14);
    color: rgba(238, 228, 210, 0.9);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.22s ease, background 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .sg-arrow-l { left: 10px; }
  .sg-arrow-r { right: 10px; }

  .sg-stage:hover .sg-arrow,
  .sg-stage:focus-within .sg-arrow { opacity: 1; }
  .sg-arrow:hover,
  .sg-arrow:active { background: rgba(0, 0, 0, 0.72); }

  /* always visible on touch devices */
  @media (hover: none) {
    .sg-arrow { opacity: 0.7 !important; }
  }

  /* ── Thumbnails ───────────────────────────────────── */
  .sg-strip-wrap {
    margin-top: 10px;
  }

  /* scrollable row */
  .sg-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .sg-strip::-webkit-scrollbar { display: none; }

  /* individual thumb */
  .sg-thumb {
    flex: 0 0 68px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
  }

  .sg-thumb img {
    display: block;
    width: 68px;
    height: 54px;
    object-fit: cover;
    border-radius: 10px;
    border: 2px solid transparent;
    transition: border-color 0.15s, opacity 0.15s;
    opacity: 0.55;
  }

  .sg-thumb:hover img { opacity: 0.85; border-color: var(--muted); }
  .sg-thumb.is-active img { opacity: 1; border-color: var(--red); }
</style>

<script define:vars={{ allImages }}>
  (function () {
    if (!allImages.length) return;

    const stage      = document.getElementById("sg-stage");
    const mainImg    = document.getElementById("sg-main");
    const counter    = document.getElementById("sg-counter-cur");
    const strip      = document.getElementById("sg-strip");
    const prevBtn    = document.getElementById("sg-prev");
    const nextBtn    = document.getElementById("sg-next");
    const thumbBtns  = strip ? Array.from(strip.querySelectorAll(".sg-thumb")) : [];

    let activeIndex = 0;
    let swiped      = false;

    // ── Thumbnail click → swap main image ─────────────
    function setActive(idx) {
      if (idx === activeIndex) return;
      activeIndex = idx;
      const img = allImages[idx];

      thumbBtns.forEach((b, i) => {
        b.classList.toggle("is-active", i === idx);
      });

      if (counter) counter.textContent = String(idx + 1).padStart(2, "0");

      if (mainImg && mainImg.tagName === "IMG") {
        mainImg.classList.add("is-fading");
        setTimeout(() => {
          mainImg.src = img.src;
          mainImg.alt = img.alt;
          mainImg.onload = () => mainImg.classList.remove("is-fading");
          // Fallback in case onload already fired (cached)
          if (mainImg.complete) mainImg.classList.remove("is-fading");
        }, 120);
      }
    }

    thumbBtns.forEach((btn, i) => {
      btn.addEventListener("click", () => setActive(i));
    });

    // ── Arrow controls + swipe ──────────────────────────
    function goTo(idx) {
      setActive(((idx % allImages.length) + allImages.length) % allImages.length);
    }

    prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); goTo(activeIndex - 1); });
    nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); goTo(activeIndex + 1); });

    let touchX = 0;
    if (stage) {
      stage.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; swiped = false; }, { passive: true });
      stage.addEventListener("touchend", (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 44) { swiped = true; goTo(activeIndex + (dx < 0 ? 1 : -1)); }
      }, { passive: true });
    }

    // Open the shared lightbox (mounted once in BaseLayout) at the current image
    if (mainImg) {
      mainImg.addEventListener("click", () => {
        if (swiped || !window.DarkroomLightbox) return;
        window.DarkroomLightbox.open(allImages, activeIndex);
      });
    }
  })();
</script>
