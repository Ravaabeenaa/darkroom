---
interface Props {
  imageUrl: string;
  instagramUrl: string;
  caption?: string | null;
  class?: string;
}
const { imageUrl, instagramUrl, caption, class: cls } = Astro.props;
---

<a
  href={instagramUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`ig-post gallery-wrap ${cls ?? ""}`}
  aria-label={caption ? `View post: ${caption}` : "View on Instagram"}
>
  <img src={imageUrl} alt={caption ?? ""} class="gallery-img" loading="lazy" />
  <div class="gallery-overlay" aria-hidden="true"></div>
  <div class="ig-post-badge" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
    </svg>
  </div>
</a>

<style>
  .ig-post {
    display: block;
    text-decoration: none;
  }

  .ig-post-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 3;
    color: white;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5));
  }

  .ig-post:hover .ig-post-badge {
    opacity: 1;
    transform: translateY(0);
  }
</style>
