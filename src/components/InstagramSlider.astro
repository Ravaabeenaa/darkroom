---
/**
 * InstagramSlider — simple letterboxed photo viewer.
 *
 * Fixed-height stage, object-fit: contain so the full photo always shows
 * (never cropped) regardless of orientation, with true horizontal sliding
 * between posts (translateX), arrows, dots, and a caption line below.
 *
 * Data (photo/handle/caption) is entered manually in /admin/instagram since
 * Instagram's oEmbed API now requires a registered Meta app + access token.
 */
interface Post {
  url: string;
  accountHandle: string | null;
  caption: string | null;
  photoUrl: string | null;
}
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const total = posts.length;
---

{total > 0 && (
  <div class="igs" id="igs">

    <div class="igs-stage" id="igsStage">
      <div class="igs-track" id="igsTrack" style={`width:${total * 100}%;`}>
        {posts.map((p, i) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="igs-slide"
            style={`width:${100 / total}%;`}
            aria-label="View on Instagram"
          >
            {p.photoUrl ? (
              <img
                src={p.photoUrl}
                alt={p.caption ?? "Instagram post"}
                class="igs-img"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <svg class="igs-empty" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="15" rx="2"/>
                <circle cx="12" cy="12.5" r="4"/>
                <path d="M7 5l1.5-2h7L17 5"/>
              </svg>
            )}
          </a>
        ))}
      </div>

      {total > 1 && (
        <div class="igs-count" aria-hidden="true">
          <span id="igsNum">1</span> / {total}
        </div>
      )}

      {total > 1 && (
        <>
          <button class="igs-arrow igs-arrow-l" id="igsPrev" aria-label="Previous post">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2 4 7l5 5"/></svg>
          </button>
          <button class="igs-arrow igs-arrow-r" id="igsNext" aria-label="Next post">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2l5 5-5 5"/></svg>
          </button>
        </>
      )}
    </div>

    <div class="igs-foot">
      <a href={posts[0].url} target="_blank" rel="noopener noreferrer" class="igs-meta" id="igsMeta">
        <span class="igs-handle">@{posts[0].accountHandle ?? "darkroom"}</span>
        <span class="igs-caption" style={posts[0].caption ? "" : "display:none;"}>{posts[0].caption ?? ""}</span>
      </a>

      {total > 1 && (
        <div class="igs-dots" role="presentation">
          {posts.map((_, i) => (
            <button class={`igs-dot ${i === 0 ? "is-active" : ""}`} data-dot={i} aria-label={`Post ${i + 1}`}></button>
          ))}
        </div>
      )}
    </div>

  </div>
)}

<style>
  .igs {
    min-width: 0;
    width: 100%;
  }

  /* ── STAGE ─────────────────────────────────────────────────── */
  /* Fixed height; photos use object-fit: contain so they always show in full,
     letterboxed rather than cropped or forcing the widget to grow/shrink. */
  .igs-stage {
    position: relative;
    overflow: hidden;
    border-radius: 0.85rem;
    background: var(--panel2);
    border: 1px solid var(--line);
    height: 280px;
  }
  @media (min-width: 640px) {
    .igs-stage { height: 380px; }
  }
  @media (min-width: 1024px) {
    .igs-stage { height: 440px; }
  }

  .igs-track {
    display: flex;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .igs-slide {
    flex-shrink: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .igs-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .igs-empty {
    color: var(--muted);
    opacity: 0.5;
  }

  /* ── COUNT ─────────────────────────────────────────────────── */
  .igs-count {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* ── ARROWS ────────────────────────────────────────────────── */
  .igs-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--text);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .igs-arrow-l { left: 8px; }
  .igs-arrow-r { right: 8px; }
  .igs-arrow:hover { opacity: 1; background: var(--red); color: #000; border-color: var(--red); }

  /* ── FOOT (handle + caption + dots) ───────────────────────── */
  .igs-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 12px;
  }

  .igs-meta {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 12px;
  }
  .igs-handle {
    font-weight: 600;
    color: var(--text);
  }
  .igs-meta:hover .igs-handle { color: var(--red); }
  .igs-caption {
    margin-left: 8px;
    color: var(--muted);
  }

  .igs-dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .igs-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .igs-dot.is-active { background: var(--red); transform: scale(1.25); }
  .igs-dot:hover { background: var(--muted); }
</style>

<script is:inline define:vars={{ igsUrls: posts.map(p => p.url), igsHandles: posts.map(p => p.accountHandle), igsCaptions: posts.map(p => p.caption) }}>
  (function () {
    const stage = document.getElementById('igsStage');
    const track = document.getElementById('igsTrack');
    if (!track) return;

    const slides = Array.from(track.children);
    const total = slides.length;
    if (total <= 1) return;

    const numEl  = document.getElementById('igsNum');
    const metaEl = document.getElementById('igsMeta');
    const prevBtn = document.getElementById('igsPrev');
    const nextBtn = document.getElementById('igsNext');
    const dots = Array.from(document.querySelectorAll('#igs .igs-dot'));

    var cur = 0;

    function render() {
      track.style.transform = 'translateX(-' + (cur * (100 / total)) + '%)';
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === cur); });
      if (numEl) numEl.textContent = String(cur + 1);
      if (metaEl) {
        metaEl.href = igsUrls[cur] || '#';
        var handle = metaEl.querySelector('.igs-handle');
        var caption = metaEl.querySelector('.igs-caption');
        if (handle) handle.textContent = '@' + (igsHandles[cur] || 'darkroom');
        if (caption) {
          if (igsCaptions[cur]) { caption.textContent = igsCaptions[cur]; caption.style.display = ''; }
          else caption.style.display = 'none';
        }
      }
    }

    function goTo(i) {
      cur = ((i % total) + total) % total;
      render();
    }

    prevBtn && prevBtn.addEventListener('click', function (e) { e.preventDefault(); goTo(cur - 1); });
    nextBtn && nextBtn.addEventListener('click', function (e) { e.preventDefault(); goTo(cur + 1); });
    dots.forEach(function (d, i) { d.addEventListener('click', function (e) { e.preventDefault(); goTo(i); }); });

    var touchX = 0;
    stage && stage.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
    stage && stage.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 44) goTo(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>
