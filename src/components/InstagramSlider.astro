---
/**
 * InstagramSlider — "contact sheet on a light table"
 *
 * One post per slide: photo, account handle, caption (clamped to 2 lines).
 * Data is entered manually in /admin/instagram since Instagram's oEmbed API
 * now requires a registered Meta app + access token to fetch this automatically.
 */
interface Post {
  url: string;
  accountHandle: string | null;
  caption: string | null;
  photoUrl: string | null;
}
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const total = posts.length;
---

{total > 0 && (
  <div class="ig-sheet" id="igSheet">
    <div class="ig-sheet-stage" id="igStage">
      <div class="ig-sheet-track" id="igTrack" style={`width:${total * 100}%;`}>
        {posts.map((p, i) => (
          <div class="ig-frame" style={`width:${100 / total}%;`}>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="ig-frame-photo" aria-label="View on Instagram">
              {p.photoUrl ? (
                <img src={p.photoUrl} alt={p.caption ?? "Instagram post"} loading={i === 0 ? "eager" : "lazy"} />
              ) : (
                <div class="ig-frame-empty">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="15" rx="2"/>
                    <circle cx="12" cy="12.5" r="4"/>
                    <path d="M7 5l1.5-2h7L17 5"/>
                  </svg>
                </div>
              )}
              <span class="ig-frame-stamp">{String(i + 1).padStart(2, "0")}<span class="ig-frame-stamp-sep">/</span>{String(total).padStart(2, "0")}</span>
            </a>

            <div class="ig-frame-meta">
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="ig-handle">
                <span class="ig-handle-dot" aria-hidden="true"></span>
                @{p.accountHandle ?? "darkroom"}
              </a>
              {p.caption && <p class="ig-caption">{p.caption}</p>}
            </div>
          </div>
        ))}
      </div>

      {total > 1 && (
        <>
          <button class="ig-arrow ig-arrow-l" id="igPrev" aria-label="Previous post">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2 4 7l5 5"/></svg>
          </button>
          <button class="ig-arrow ig-arrow-r" id="igNext" aria-label="Next post">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2l5 5-5 5"/></svg>
          </button>
        </>
      )}
    </div>

    {total > 1 && (
      <div class="ig-dots" role="presentation">
        {posts.map((_, i) => (
          <button class={`ig-dot ${i === 0 ? "is-active" : ""}`} data-dot={i} aria-label={`Post ${i + 1}`}></button>
        ))}
      </div>
    )}
  </div>
)}

<style>
  /* ── Sheet (light-table backdrop) ──────────────────────────── */
  .ig-sheet {
    --grain: radial-gradient(circle at 1px 1px, rgba(238,228,210,0.05) 1px, transparent 0);
    position: relative;
    border-radius: 1.25rem;
    padding: 22px;
    background:
      var(--grain),
      radial-gradient(120% 140% at 15% 0%, rgba(237,28,36,0.10), transparent 55%),
      #0b0b0b;
    background-size: 3px 3px, auto, auto;
    border: 1px solid rgba(238,228,210,0.08);
  }

  .ig-sheet-stage {
    position: relative;
    overflow: hidden;
    border-radius: 0.85rem;
  }

  .ig-sheet-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Frame ─────────────────────────────────────────────────── */
  .ig-frame {
    flex-shrink: 0;
    display: grid;
    gap: 14px;
    padding: 4px;
  }
  @media (min-width: 640px) {
    .ig-frame {
      grid-template-columns: minmax(0, 280px) 1fr;
      align-items: center;
      gap: 28px;
    }
  }

  .ig-frame-photo {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    overflow: hidden;
    background: #161616;
    border: 1px solid rgba(238,228,210,0.14);
    box-shadow: 0 18px 40px -16px rgba(0,0,0,0.7);
  }
  .ig-frame-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ig-frame-photo:hover img { transform: scale(1.04); }

  .ig-frame-empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(238,228,210,0.25);
  }

  .ig-frame-stamp {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: rgba(238,228,210,0.7);
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    padding: 3px 7px;
    border-radius: 2px;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .ig-frame-stamp-sep { opacity: 0.4; }

  /* ── Meta (handle + caption) ──────────────────────────────── */
  .ig-frame-meta {
    min-width: 0;
    padding: 2px 8px 10px;
  }
  @media (min-width: 640px) {
    .ig-frame-meta { padding: 0; }
  }

  .ig-handle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--cream);
    text-transform: lowercase;
  }
  .ig-handle:hover { color: var(--red); }
  .ig-handle-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px rgba(237,28,36,0.18);
    flex-shrink: 0;
  }

  .ig-caption {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: rgba(238,228,210,0.55);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Arrows ────────────────────────────────────────────────── */
  .ig-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(238,228,210,0.14);
    color: rgba(238,228,210,0.9);
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
    backdrop-filter: blur(8px);
  }
  .ig-arrow-l { left: 6px; }
  .ig-arrow-r { right: 6px; }
  .ig-arrow:hover { background: rgba(237,28,36,0.45); }
  @media (min-width: 640px) {
    .ig-arrow-l { left: -14px; }
    .ig-arrow-r { right: -14px; }
  }

  /* ── Dots ──────────────────────────────────────────────────── */
  .ig-dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: 16px;
  }
  .ig-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(238,228,210,0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .ig-dot.is-active {
    background: var(--red);
    transform: scale(1.3);
  }
  .ig-dot:hover { background: rgba(238,228,210,0.45); }
</style>

<script>
  document.querySelectorAll(".ig-sheet").forEach((sheet) => {
    const track = sheet.querySelector(".ig-sheet-track");
    const frames = track ? Array.from(track.children) : [];
    const total = frames.length;
    if (!track || total <= 1) return;

    const prevBtn = sheet.querySelector("#igPrev") || sheet.querySelector(".ig-arrow-l");
    const nextBtn = sheet.querySelector("#igNext") || sheet.querySelector(".ig-arrow-r");
    const dots = Array.from(sheet.querySelectorAll(".ig-dot"));

    let index = 0;

    function render() {
      track.style.transform = `translateX(-${index * (100 / total)}%)`;
      dots.forEach((d, i) => d.classList.toggle("is-active", i === index));
    }

    function goTo(i) {
      index = ((i % total) + total) % total;
      render();
    }

    prevBtn?.addEventListener("click", () => goTo(index - 1));
    nextBtn?.addEventListener("click", () => goTo(index + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));

    let touchX = 0;
    const stage = sheet.querySelector(".ig-sheet-stage");
    stage?.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    stage?.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 44) goTo(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });
</script>
