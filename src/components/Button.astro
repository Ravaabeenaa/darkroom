---
const {
  href,
  type = "button",
  variant = "filled",   // "filled" | "outline"
  size = "md",          // "md" | "lg"
  class: className = "",
} = Astro.props;

/* Only treat as link if href is a real non-empty string */
const isLink =
  typeof href === "string" && href.trim().length > 0;

const base =
  "inline-flex items-center justify-center rounded-[999px] font-medium transition duration-200 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-black/20";

const sizes = {
  md: "h-12 px-10 text-sm",
  lg: "h-14 px-12 text-sm",
};

const variants = {
  filled:
    "bg-[var(--btn)] !text-white hover:brightness-110",
  outline:
    "bg-transparent text-[var(--text)] border border-[var(--line)] hover:bg-black/5",
};
---

{isLink ? (
  <a
    href={href}
    class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
  >
    <slot />
  </button>
)}
