---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact } from "../lib/contact";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

// We’ll render a shell; JS populates from localStorage cart.
type ServiceRow = {
  id: string;
  slug: string | null;
  name: string;
  price_cents: number;
  primary_image_key: string | null;
  service_group: string | null;
  bulk_discount_eligible: number;
  bulk_discount_percent: number;
  turnaround_options: string | null;
  turnaround_prices: string | null;
  pushpull_options: string | null;
  pushpull_prices: string | null;
};

const [svcRes, settingsRes] = await Promise.all([
  db.prepare(`
    SELECT id, slug, name, price_cents, primary_image_key, service_group, bulk_discount_eligible, bulk_discount_percent, turnaround_options, turnaround_prices, pushpull_options, pushpull_prices
    FROM services
    WHERE active = 1;
  `).all(),
  db.prepare(`SELECT key, value FROM settings WHERE key IN ('collection_options', 'shop_closed', 'shop_closed_message')`).all<{ key: string; value: string }>(),
]);

const services = (svcRes.results ?? []) as ServiceRow[];

const settingsMap: Record<string, string> = Object.fromEntries((settingsRes.results ?? []).map(r => [r.key, r.value]));
const shopClosed = settingsMap['shop_closed'] === '1';
const shopClosedMessage = settingsMap['shop_closed_message'] ?? 'We are currently closed.';

type CollectionOption = { label: string; price: number };
let collectionOptions: CollectionOption[] = [];
try { collectionOptions = JSON.parse(settingsMap['collection_options'] ?? '[]'); } catch {}

function imgUrl(key: string | null) {
  if (!key) return null;
  return base ? `${base}/${key}` : `/${key}`;
}
---

<BaseLayout title="Cart — DARKROOM">
  <section class="mt-10 grid gap-10 lg:grid-cols-2">
    <!-- SECTION 1: CART -->
    <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6">
      <h1 class="text-3xl md:text-4xl">Your cart</h1>
      <p class="mt-2 text-sm" style="color: var(--muted);">
        Review items and quantities.
      </p>

      <div id="cartEmpty" class="mt-8 rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-4 text-sm" style="display:none;color:var(--muted);">
        Your cart is empty.
      </div>

      <div id="cartList" class="mt-8 space-y-4"></div>

      {collectionOptions.length > 0 && (
        <div class="mt-4 rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-4">
          <label class="block text-sm font-medium">Collection</label>
          <select id="collectionSelect" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            {collectionOptions.map((opt) => (
              <option value={opt.label} data-cents={opt.cents}>
                {opt.label}{opt.price > 0 ? ` (+MVR ${Number(opt.price).toFixed(2)})` : ''}
              </option>
            ))}
          </select>
        </div>
      )}

      <div class="mt-6 flex items-center justify-between border-t border-[var(--line)] pt-4">
        <div class="text-sm" style="color: var(--muted);">Total</div>
        <div id="cartTotal" class="text-lg font-semibold">MVR 0.00</div>
      </div>
    </div>

    <!-- SECTION 2: CUSTOMER -->
    <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6">
      <h2 class="text-2xl md:text-3xl">Customer details</h2>
      {shopClosed ? (
        <p class="mt-3 text-sm font-medium" style="color: var(--red);">{shopClosedMessage}</p>
      ) : (
        <p class="mt-2 text-sm" style="color: var(--muted);">Required fields must be filled before checkout.</p>
      )}

      <div class="mt-8 space-y-4">
        <label class="block">
          <span class="text-sm font-medium">Name</span>
          <input id="custName" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none" />
        </label>

        <label class="block">
          <span class="text-sm font-medium">Phone</span>
          <input id="custPhone" inputmode="numeric" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none" placeholder="9607xxxxxx" />
          <div id="phoneErr" class="mt-2 text-sm" style="color:#b91c1c;display:none;">Phone must contain digits only.</div>
        </label>

        <label class="block">
          <span class="text-sm font-medium">Preferred contact method</span>
          <select id="custMethod" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            <option value="">Select…</option>
            <option value="Telegram">Telegram</option>
            <option value="Viber">Viber</option>
            <option value="WhatsApp">WhatsApp</option>
          </select>
        </label>

        <label class="block">
          <div class="flex items-baseline gap-2">
            <span class="text-sm font-medium">Email</span>
            <span class="text-xs" style="color: var(--muted);">optional</span>
          </div>
          <input id="custEmail" type="email" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none" />
        </label>

        <label class="block">
          <div class="flex items-baseline gap-2">
            <span class="text-sm font-medium">Notes</span>
            <span class="text-xs" style="color: var(--muted);">optional</span>
          </div>
          <textarea id="custNotes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none"></textarea>
        </label>

        <button
          id="checkoutBtn"
          type="button"
          class="mt-4 w-full cursor-pointer rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
          disabled
        >
          Checkout
        </button>

        <div id="checkoutStatus" class="text-sm" style="color: var(--muted);"></div>
      </div>

      <!-- Order confirmation -->
      <div id="confirmWrap" class="mt-10 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6" style="display:none;">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-base font-bold" style="background: var(--red); color: #000;">✓</span>
          <div>
            <div class="text-lg font-semibold">Order placed</div>
            <div id="confirmRef" class="font-mono text-sm" style="color: var(--muted);"></div>
          </div>
        </div>
        <div id="confirmItems" class="mt-5 space-y-0 divide-y" style="border-color: var(--line);"></div>
        <div class="mt-4 flex items-center justify-between border-t pt-3" style="border-color: var(--line);">
          <span class="text-sm" style="color: var(--muted);">Estimated total</span>
          <span id="confirmTotal" class="font-mono text-base font-semibold"></span>
        </div>
        <p class="mt-5 rounded-2xl border border-[var(--line)] p-4 text-xs leading-5" style="color: var(--muted);">
          Prices shown are estimates and subject to change. A final invoice will be confirmed and sent to you via <span id="confirmMethod" class="font-medium" style="color: var(--text);"></span>.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{
    servicesJson: services.map(s => ({
      ...s,
      image_url: imgUrl(s.primary_image_key),
      shop_href: `/shop/${s.slug ?? s.id}`,
      service_group: s.service_group ?? null,
      bulk_discount_eligible: s.bulk_discount_eligible,
      bulk_discount_percent: s.bulk_discount_percent ?? 5,
      turnaround_options: s.turnaround_options ? JSON.parse(s.turnaround_options) : [],
      turnaround_prices: s.turnaround_prices ? JSON.parse(s.turnaround_prices) : [],
      pushpull_options: s.pushpull_options ? JSON.parse(s.pushpull_options) : [],
      pushpull_prices: s.pushpull_prices ? JSON.parse(s.pushpull_prices) : [],
    })),
    collectionOptionsData: collectionOptions,
    isShopClosed: shopClosed,
    contact,
  }}>
    const services = servicesJson;
    const byId = new Map(services.map(s => [s.id, s]));
    const collectionOptions = collectionOptionsData;

    const cartList = document.getElementById("cartList");
    const cartEmpty = document.getElementById("cartEmpty");
    const cartTotalEl = document.getElementById("cartTotal");

    const nameEl = document.getElementById("custName");
    const phoneEl = document.getElementById("custPhone");
    const methodEl = document.getElementById("custMethod");
    const emailEl = document.getElementById("custEmail");
    const notesEl = document.getElementById("custNotes");
    const phoneErr = document.getElementById("phoneErr");
    const checkoutBtn = document.getElementById("checkoutBtn");
    const checkoutStatus = document.getElementById("checkoutStatus");
    const CUSTOMER_KEY = "dr_customer_v1";

    

    function loadCustomer() {
      try {
        return JSON.parse(localStorage.getItem(CUSTOMER_KEY) || "{}") || {};
      } catch {
        return {};
      }
    }

    function saveCustomer(partial) {
      const cur = loadCustomer();
      const next = { ...cur, ...partial };
      localStorage.setItem(CUSTOMER_KEY, JSON.stringify(next));
    }

    // autofill customer details
    const saved = loadCustomer();
    if (saved.name) nameEl.value = saved.name;
    if (saved.phone) phoneEl.value = saved.phone;
    if (saved.method) methodEl.value = saved.method;
    if (saved.email) emailEl.value = saved.email;
    if (saved.notes) notesEl.value = saved.notes;
    
    function digitsOnlyStr(s) {
      return String(s || "").replace(/\D+/g, "");
    }

    function onlyDigits(s) { return /^[0-9]+$/.test(s); }

    function getCart() {
      return window.DarkroomCart.load();
    }

    function getCartItems() {
      const cart = getCart();
      return Object.entries(cart)
        .map(([key, qty]) => {
          const { serviceId, turnaround, pushpull } = window.DarkroomCart.parseKey(key);
          return { key, id: serviceId, qty: Number(qty) || 0, turnaround, pushpull };
        })
        .filter(x => x.qty > 0);
    }

    function getOptionPriceCents(opts, prices, selected) {
      if (!selected || !opts?.length || !prices?.length) return 0;
      const idx = opts.indexOf(selected);
      if (idx === -1 || !prices[idx]) return 0;
      const n = parseFloat(String(prices[idx]).replace(/^\+/, "")) || 0;
      return Math.round(n * 100);
    }

    function unitPriceCents(svc, it) {
      return svc.price_cents
        + getOptionPriceCents(svc.turnaround_options, svc.turnaround_prices, it.turnaround)
        + getOptionPriceCents(svc.pushpull_options,   svc.pushpull_prices,   it.pushpull);
    }

    function getSelectedCollection() {
      const sel = document.getElementById("collectionSelect");
      if (!sel || !collectionOptions.length) return { label: null, cents: 0 };
      const idx = sel.selectedIndex;
      const opt = collectionOptions[idx] ?? collectionOptions[0];
      return { label: opt?.label ?? null, cents: Math.round((opt?.price ?? 0) * 100) };
    }

    function calcDiscounts(items) {
      const discounts = [];

      // Mode 1: group-level — aggregate by service_group for eligible=1 items
      const groupMap = new Map(); // group → { totalQty, totalCents, minPct }
      for (const it of items) {
        const svc = byId.get(it.id);
        if (!svc || svc.bulk_discount_eligible !== 1 || !svc.service_group) continue;
        const g   = svc.service_group;
        const pct = svc.bulk_discount_percent ?? 5;
        const prev = groupMap.get(g) ?? { totalQty: 0, totalCents: 0, minPct: pct };
        groupMap.set(g, {
          totalQty:   prev.totalQty   + it.qty,
          totalCents: prev.totalCents + unitPriceCents(svc, it) * it.qty,
          minPct:     Math.min(prev.minPct, pct),
        });
      }
      for (const [group, { totalQty, totalCents, minPct }] of groupMap) {
        if (totalQty >= 5) {
          discounts.push({ name: `Bulk discount (${group})`, cents: -Math.round(totalCents * minPct / 100) });
        }
      }

      // Mode 2: item-level — per cart entry (same service + same options) for eligible=2 items
      for (const it of items) {
        const svc = byId.get(it.id);
        if (!svc || svc.bulk_discount_eligible !== 2) continue;
        if (it.qty >= 5) {
          const pct      = svc.bulk_discount_percent ?? 5;
          const lineCents = unitPriceCents(svc, it) * it.qty;
          discounts.push({ name: `Bulk discount (${svc.name})`, cents: -Math.round(lineCents * pct / 100) });
        }
      }

      return discounts;
    }

    function calcTotal(items) {
      let t = 0;
      for (const it of items) {
        const s = byId.get(it.id);
        if (!s) continue;
        t += unitPriceCents(s, it) * it.qty;
      }
      const discounts = calcDiscounts(items);
      t += discounts.reduce((s, d) => s + d.cents, 0);
      t += getSelectedCollection().cents;
      return t;
    }

    function renderCart() {
      const items = getCartItems();
      cartList.innerHTML = "";

      if (!items.length) {
        cartEmpty.style.display = "block";
        cartTotalEl.textContent = window.DarkroomCart.formatMVR(0);
        return;
      }
      cartEmpty.style.display = "none";

      for (const it of items) {
        const s = byId.get(it.id);
        if (!s) continue;

        const unit = unitPriceCents(s, it);
        const line = unit * it.qty;

        const row = document.createElement("div");
        row.className = "flex gap-4 rounded-2xl border border-[var(--line)] bg-white/30 p-4";

        const optLabel = [it.turnaround, it.pushpull].filter(Boolean).join(' · ');
        row.innerHTML = `
          <div class="h-16 w-16 overflow-hidden rounded-xl border border-[var(--line)] bg-white/20">
            ${s.image_url ? `<img src="${s.image_url}" alt="${s.name}" class="h-full w-full object-cover" />` : `<div class="flex h-full w-full items-center justify-center text-[10px]" style="color: var(--muted);">No image</div>`}
          </div>

          <div class="min-w-0 flex-1">
            <a href="${s.shop_href}" class="text-sm font-semibold hover:opacity-70">${s.name}</a>
            ${optLabel ? `<div class="mt-0.5 text-xs" style="color: var(--muted);">${optLabel}</div>` : ''}
            <div class="mt-1 text-xs" style="color: var(--muted);">${window.DarkroomCart.formatMVR(unit)} each</div>

            <div class="mt-3 flex items-center gap-2">
              <button class="h-10 w-10 cursor-pointer rounded-full border border-[var(--line)] bg-white/40 hover:bg-white/70 active:bg-white/70" data-dec="${it.key}">−</button>
              <span class="w-10 text-center text-sm tabular-nums" data-dr-cart-qty="${it.key}">${window.DarkroomCart.getQty(it.key)}</span>
              <button class="h-10 w-10 cursor-pointer rounded-full border border-[var(--line)] bg-white/40 hover:bg-white/70 active:bg-white/70" data-inc="${it.key}">+</button>
            </div>
          </div>

          <div class="text-right">
            <div class="text-sm font-semibold">${window.DarkroomCart.formatMVR(line)}</div>
            <button class="mt-3 rounded-lg px-2 py-1.5 text-sm hover:opacity-70 active:opacity-70" style="color:var(--muted);" data-remove="${it.key}">Remove</button>
          </div>
        `;

        cartList.appendChild(row);
      }

      // discount line items
      const discounts = calcDiscounts(items);
      for (const disc of discounts) {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between gap-4 rounded-2xl border border-[var(--line)] bg-[var(--panel)] px-4 py-3";
        row.innerHTML = `
          <div class="text-sm" style="color: var(--muted);">${disc.name}</div>
          <div class="text-sm font-semibold" style="color: var(--red);">−${window.DarkroomCart.formatMVR(-disc.cents)}</div>
        `;
        cartList.appendChild(row);
      }

      // bind buttons
      cartList.querySelectorAll("[data-inc]").forEach(btn => {
        btn.addEventListener("click", () => {
          window.DarkroomCart.inc(btn.getAttribute("data-inc"));
          window.DarkroomCart.toast("Added to cart");
        });
      });
      cartList.querySelectorAll("[data-dec]").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-dec");
          const before = window.DarkroomCart.getQty(id);
          window.DarkroomCart.dec(id);
          const after = window.DarkroomCart.getQty(id);
          if (before > 0 && after < before) window.DarkroomCart.toast("Removed from cart");
        });
      });
      cartList.querySelectorAll("[data-remove]").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-remove");
          window.DarkroomCart.setQty(id, 0);
          window.DarkroomCart.toast("Removed from cart");
        });
      });

      const total = calcTotal(items);
      cartTotalEl.textContent = window.DarkroomCart.formatMVR(total);
    }

    function validate() {
      const items = getCartItems();
      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const method = methodEl.value.trim();

      let ok = true;
      if (!name) ok = false;
      if (!phone || !onlyDigits(phone)) ok = false;
      if (!method) ok = false;
      if (!items.length) ok = false;

      phoneErr.style.display = (phone && !onlyDigits(phone)) ? "block" : "none";
      checkoutBtn.disabled = !ok;
    }

    async function drawInvoicePng(payload) {
      const order = payload.order ?? payload.data?.order ?? payload;
      const items  = payload.items ?? payload.data?.items ?? [];

      // ── palette ──────────────────────────────────────────────
      const BLACK  = "#000000";
      const CREAM  = "#EEE4D2";
      const RED    = "#ED1C24";
      const MUTED_DARK  = "rgba(0,0,0,0.38)";
      const MUTED_LIGHT = "rgba(238,228,210,0.45)";

      // ── layout constants ──────────────────────────────────────
      const W       = 680;
      const PAD     = 40;
      const HEADER_H  = 88;
      const STRIP_H   = 5;
      const INFO_H    = 128;
      const COL_LABEL_H = 40;  // height of table column headers
      const ROW_H     = 52;
      const TABLE_PAD_TOP = 28;
      const TOTAL_H   = 64;
      const CONTACT_H = 52;
      const FOOTER_H  = 72;

      const H = HEADER_H + STRIP_H + INFO_H
              + TABLE_PAD_TOP + COL_LABEL_H + items.length * ROW_H
              + TOTAL_H + CONTACT_H + FOOTER_H;

      const SCALE = 2; // 2× resolution for crisp output
      const canvas = document.createElement("canvas");
      canvas.width  = W * SCALE;
      canvas.height = H * SCALE;
      const ctx = canvas.getContext("2d");
      ctx.scale(SCALE, SCALE);

      // ── ensure fonts are loaded ───────────────────────────────
      await Promise.all([
        document.fonts.load("400 16px 'League Gothic'"),
        document.fonts.load("400 16px 'JetBrains Mono'"),
      ]).catch(() => null);

      // ── load logo ─────────────────────────────────────────────
      const logoImg = new Image();
      await new Promise((res) => {
        logoImg.onload = res;
        logoImg.onerror = res;
        logoImg.src = "/images/logos/logo-light.png";
      });

      // ── helpers ───────────────────────────────────────────────
      function mvr(cents) {
        return (Number(cents || 0) / 100)
          .toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function hline(y, alpha = 0.12) {
        ctx.save();
        ctx.strokeStyle = `rgba(0,0,0,${alpha})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(PAD, y);
        ctx.lineTo(W - PAD, y);
        ctx.stroke();
        ctx.restore();
      }

      // ── canvas cream base ─────────────────────────────────────
      ctx.fillStyle = CREAM;
      ctx.fillRect(0, 0, W, H);

      // ═══════════════════════════════════════════════════════════
      // 1. BLACK HEADER BAND
      // ═══════════════════════════════════════════════════════════
      ctx.fillStyle = BLACK;
      ctx.fillRect(0, 0, W, HEADER_H);

      // logo
      if (logoImg.naturalWidth > 0) {
        const lh = 32;
        const lw = logoImg.naturalWidth * (lh / logoImg.naturalHeight);
        ctx.drawImage(logoImg, PAD, (HEADER_H - lh) / 2, lw, lh);
      }

      // "INVOICE" right-aligned
      ctx.fillStyle = CREAM;
      ctx.font = "400 40px 'League Gothic', sans-serif";
      ctx.textAlign = "right";
      ctx.fillText("INVOICE", W - PAD, HEADER_H / 2 + 8);

      // ref + date below
      ctx.font = "400 10px 'JetBrains Mono', monospace";
      ctx.fillStyle = MUTED_LIGHT;
      const dateStr = order.created_at
        ? new Date(order.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
        : new Date().toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
      ctx.fillText(`${order.order_ref ?? ""}  ·  ${dateStr}`, W - PAD, HEADER_H / 2 + 26);

      // ═══════════════════════════════════════════════════════════
      // 2. RED STRIP
      // ═══════════════════════════════════════════════════════════
      ctx.fillStyle = RED;
      ctx.fillRect(0, HEADER_H, W, STRIP_H);

      // ═══════════════════════════════════════════════════════════
      // 3. INFO GRID  (2 columns: Billed to | From)
      // ═══════════════════════════════════════════════════════════
      const infoTop = HEADER_H + STRIP_H + 28;
      const col2X   = W / 2 + 8;

      function drawInfoBlock(x, label, lines) {
        // column label
        ctx.font = "400 9px 'JetBrains Mono', monospace";
        ctx.fillStyle = MUTED_DARK;
        ctx.textAlign = "left";
        ctx.fillText(label, x, infoTop);

        // first line bold (name)
        ctx.font = "700 13px 'JetBrains Mono', monospace";
        ctx.fillStyle = BLACK;
        ctx.fillText(lines[0] ?? "", x, infoTop + 20);

        // remaining lines normal
        ctx.font = "400 12px 'JetBrains Mono', monospace";
        ctx.fillStyle = "rgba(0,0,0,0.6)";
        for (let i = 1; i < lines.length; i++) {
          ctx.fillText(lines[i], x, infoTop + 20 + i * 18);
        }
      }

      const billedLines = [
        order.customer_name ?? "",
        order.customer_phone ? `+960 ${order.customer_phone}` : "",
        order.contact_method ?? "",
        order.customer_email ?? "",
      ].filter(Boolean);

      drawInfoBlock(PAD, "BILLED TO", billedLines);
      drawInfoBlock(col2X, "FROM", ["Darkroom", contact.email, contact.phone]);

      // bottom border of info section
      const infoBottomY = HEADER_H + STRIP_H + INFO_H;
      hline(infoBottomY);

      // ═══════════════════════════════════════════════════════════
      // 4. TABLE
      // ═══════════════════════════════════════════════════════════
      let y = infoBottomY + TABLE_PAD_TOP;

      // column header row
      ctx.font = "400 9px 'JetBrains Mono', monospace";
      ctx.fillStyle = MUTED_DARK;
      ctx.textAlign = "left";
      ctx.fillText("SERVICE", PAD, y + 22);
      ctx.textAlign = "right";
      ctx.fillText("QTY", W - PAD - 140, y + 22);
      ctx.fillText("AMOUNT", W - PAD, y + 22);

      y += COL_LABEL_H;
      hline(y);

      // rows
      for (const it of items) {
        const name  = String(it.service_name || it.name || "");
        const group = String(it.service_group || "");
        const isDiscount = it.service_id == null && (it.line_total_cents < 0);
        const qty   = isDiscount ? "" : String(it.quantity ?? it.qty ?? 0);
        const amt   = isDiscount
          ? `−MVR ${mvr(-it.line_total_cents)}`
          : `MVR ${mvr(it.line_total_cents)}`;

        ctx.font = "500 13px 'JetBrains Mono', monospace";
        ctx.fillStyle = isDiscount ? RED : BLACK;
        ctx.textAlign = "left";
        ctx.fillText(name, PAD, y + 22);

        if (group) {
          ctx.font = "400 10px 'JetBrains Mono', monospace";
          ctx.fillStyle = MUTED_DARK;
          ctx.fillText(group.toUpperCase(), PAD, y + 36);
        }

        ctx.font = "400 13px 'JetBrains Mono', monospace";
        ctx.fillStyle = isDiscount ? RED : BLACK;
        ctx.textAlign = "right";
        if (qty) ctx.fillText(qty, W - PAD - 140, y + 22);
        ctx.fillText(amt, W - PAD, y + 22);

        y += ROW_H;
        hline(y, 0.07);
      }

      // ═══════════════════════════════════════════════════════════
      // 5. TOTAL BAND (black)
      // ═══════════════════════════════════════════════════════════
      ctx.fillStyle = BLACK;
      ctx.fillRect(0, y, W, TOTAL_H);

      ctx.font = "400 10px 'JetBrains Mono', monospace";
      ctx.fillStyle = MUTED_LIGHT;
      ctx.textAlign = "left";
      ctx.fillText("GRAND TOTAL", PAD, y + TOTAL_H / 2 + 4);

      ctx.font = "400 34px 'League Gothic', sans-serif";
      ctx.fillStyle = CREAM;
      ctx.textAlign = "right";
      ctx.fillText(`MVR  ${mvr(order.total_price_cents)}`, W - PAD, y + TOTAL_H / 2 + 12);

      y += TOTAL_H;

      // ═══════════════════════════════════════════════════════════
      // 6. CONTACT MESSAGE
      // ═══════════════════════════════════════════════════════════
      ctx.font = "400 11px 'JetBrains Mono', monospace";
      ctx.fillStyle = "rgba(0,0,0,0.55)";
      ctx.textAlign = "left";
      ctx.fillText(
        `smolbo1 will contact you on ${order.contact_method ?? "your preferred method"} soon.`,
        PAD, y + CONTACT_H / 2 + 4
      );

      y += CONTACT_H;
      hline(y, 0.08);

      // ═══════════════════════════════════════════════════════════
      // 7. FOOTER
      // ═══════════════════════════════════════════════════════════
      ctx.font = "400 9px 'JetBrains Mono', monospace";
      ctx.fillStyle = "rgba(0,0,0,0.3)";
      ctx.textAlign = "left";
      ctx.fillText(contact.email + "  ·  " + contact.phone, PAD, y + 26);
      ctx.fillText("TELEGRAM  ·  INSTAGRAM", PAD, y + 44);

      ctx.textAlign = "right";
      ctx.fillText("Thank you for choosing", W - PAD, y + 26);
      ctx.fillText("darkroom by smolbo1", W - PAD, y + 44);

      return canvas.toDataURL("image/png");
    }

    async function checkout() {
      validate();
      if (checkoutBtn.disabled) return;

      checkoutBtn.disabled = true;
      checkoutStatus.textContent = "Placing order…";

      if (isShopClosed) {
        checkoutStatus.textContent = "Shop is currently closed.";
        validate();
        return;
      }

      const { label: collectionLabel, cents: collectionCents } = getSelectedCollection();

      const payload = {
        customer_name: nameEl.value.trim(),
        customer_phone: phoneEl.value.trim(),
        contact_method: methodEl.value.trim(),
        customer_email: emailEl.value.trim() || null,
        customer_notes: notesEl.value.trim() || null,
        collection_option: collectionLabel,
        cart: getCartItems().map(it => ({
          service_id: it.id,
          qty: it.qty,
          turnaround_option: it.turnaround || null,
          pushpull_option: it.pushpull || null,
        })),
      };

      const res = await fetch("/api/orders/create", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        checkoutStatus.textContent = data?.error || `Checkout failed (${res.status})`;
        validate();
        return;
      }

      window.DarkroomCart.save({});
      window.DarkroomCart.toast("Order placed");

      const orderRef = data.order?.order_ref ?? data.order_ref ?? "(order)";
      checkoutStatus.textContent = "";
      checkoutBtn.style.display = "none";

      const confirmWrap = document.getElementById("confirmWrap");
      const confirmRef  = document.getElementById("confirmRef");
      const confirmItemsEl = document.getElementById("confirmItems");
      const confirmTotal = document.getElementById("confirmTotal");
      const confirmMethod = document.getElementById("confirmMethod");

      if (confirmWrap && confirmRef && confirmItemsEl && confirmTotal) {
        confirmRef.textContent = orderRef;

        const fmt = (cents) => window.DarkroomCart.formatMVR(cents);
        const items = data.items ?? [];
        confirmItemsEl.innerHTML = items.map(it => {
          const isDiscount = it.line_total_cents < 0;
          return `<div class="flex items-start justify-between gap-4 py-3">
            <div class="min-w-0">
              <div class="text-sm font-medium" style="${isDiscount ? 'color:var(--red);' : ''}">${it.service_name}</div>
              ${it.service_group ? `<div class="mt-0.5 text-xs" style="color:var(--muted);">${it.service_group}</div>` : ''}
            </div>
            <div class="text-right shrink-0">
              ${it.quantity > 1 && !isDiscount ? `<div class="text-xs" style="color:var(--muted);">×${it.quantity}</div>` : ''}
              <div class="text-sm font-medium tabular-nums" style="${isDiscount ? 'color:var(--red);' : ''}">${fmt(it.line_total_cents)}</div>
            </div>
          </div>`;
        }).join('');

        confirmTotal.textContent = fmt(data.order.total_price_cents);
        if (confirmMethod) confirmMethod.textContent = data.order.contact_method ?? "your preferred contact method";

        confirmWrap.style.display = "block";
        confirmWrap.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    // Disable checkout entirely if shop is closed
    if (isShopClosed) {
      checkoutBtn.disabled = true;
    }

    // initial
    renderCart();
    validate();

    // react to cart changes
    window.addEventListener("dr-cart-changed", () => {
      renderCart();
      validate();
    });

    // update total when collection changes
    document.getElementById("collectionSelect")?.addEventListener("change", () => {
      const items = getCartItems();
      cartTotalEl.textContent = window.DarkroomCart.formatMVR(calcTotal(items));
    });

    // enforce digits-only phone
    nameEl.addEventListener("input", () => {
      saveCustomer({ name: nameEl.value });
      validate();
    });

    phoneEl.addEventListener("input", () => {
      // keep your digit-only enforcement if you already have it
      const d = String(phoneEl.value || "").replace(/\D+/g, "");
      if (phoneEl.value !== d) phoneEl.value = d;

      saveCustomer({ phone: phoneEl.value });
      validate();
    });

    methodEl.addEventListener("change", () => {
      saveCustomer({ method: methodEl.value });
      validate();
    });

    emailEl.addEventListener("input", () => {
      saveCustomer({ email: emailEl.value });
      validate();
    });

    notesEl.addEventListener("input", () => {
      saveCustomer({ notes: notesEl.value });
      validate();
    });

    checkoutBtn.addEventListener("click", checkout);
  </script>
</BaseLayout>