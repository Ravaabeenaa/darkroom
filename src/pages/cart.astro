---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

// We’ll render a shell; JS populates from localStorage cart.
type ServiceRow = {
  id: string;
  name: string;
  price_cents: number;
  primary_image_key: string | null;
};

const res = await db.prepare(`
  SELECT id, name, price_cents, primary_image_key
  FROM services
  WHERE active = 1;
`).all();

const services = (res.results ?? []) as ServiceRow[];

function imgUrl(key: string | null) {
  if (!key) return null;
  return base ? `${base}/${key}` : `/${key}`;
}
---

<BaseLayout title="Cart — DARKROOM">
  <section class="mt-10 grid gap-10 lg:grid-cols-2">
    <!-- SECTION 1: CART -->
    <div class="rounded-3xl border border-[var(--line)] bg-white/20 p-6">
      <h1 class="text-3xl md:text-4xl">Your cart</h1>
      <p class="mt-2 text-sm" style="color: var(--muted);">
        Review items and quantities.
      </p>

      <div id="cartEmpty" class="mt-8 rounded-2xl border border-[var(--line)] bg-white/40 p-4 text-sm" style="display:none;color:var(--muted);">
        Your cart is empty.
      </div>

      <div id="cartList" class="mt-8 space-y-4"></div>

      <div class="mt-8 flex items-center justify-between border-t border-[var(--line)] pt-4">
        <div class="text-sm" style="color: var(--muted);">Total</div>
        <div id="cartTotal" class="text-lg font-semibold">MVR 0.00</div>
      </div>
    </div>

    <!-- SECTION 2: CUSTOMER -->
    <div class="rounded-3xl border border-[var(--line)] bg-white/20 p-6">
      <h2 class="text-2xl md:text-3xl">Customer details</h2>
      <p class="mt-2 text-sm" style="color: var(--muted);">
        Required fields must be filled before checkout.
      </p>

      <div class="mt-8 space-y-4">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Name *</span>
          <input id="custName" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Phone (digits only) *</span>
          <input id="custPhone" inputmode="numeric" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="9607xxxxxx" />
          <div id="phoneErr" class="mt-2 text-xs" style="color:#b91c1c;display:none;">Phone must contain digits only.</div>
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Preferred contact method *</span>
          <select id="custMethod" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none">
            <option value="">Select…</option>
            <option value="Telegram">Telegram</option>
            <option value="Viber">Viber</option>
            <option value="WhatsApp">WhatsApp</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Email (optional)</span>
          <input id="custEmail" type="email" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Notes (optional)</span>
          <textarea id="custNotes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"></textarea>
        </label>

        <button
          id="checkoutBtn"
          type="button"
          class="mt-4 w-full rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
          disabled
        >
          Checkout
        </button>

        <div id="checkoutStatus" class="text-sm" style="color: var(--muted);"></div>
      </div>

      <!-- Invoice -->
      <div id="invoiceWrap" class="mt-10 rounded-3xl border border-[var(--line)] bg-white/30 p-6" style="display:none;">
        <div class="flex items-center justify-between gap-4">
          <div class="text-lg font-semibold">Invoice</div>
          <a id="downloadInvoice" class="rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-2 text-sm hover:bg-white/80" href="#" download>
            Download PNG
          </a>
        </div>
        <img id="invoiceImg" class="mt-4 w-full rounded-2xl border border-[var(--line)]" alt="Invoice image" />
      </div>
    </div>
  </section>

  <script define:vars={{ servicesJson: services.map(s => ({...s, image_url: imgUrl(s.primary_image_key)})) }}>
    const services = servicesJson;
    const byId = new Map(services.map(s => [s.id, s]));

    const cartList = document.getElementById("cartList");
    const cartEmpty = document.getElementById("cartEmpty");
    const cartTotalEl = document.getElementById("cartTotal");

    const nameEl = document.getElementById("custName");
    const phoneEl = document.getElementById("custPhone");
    const methodEl = document.getElementById("custMethod");
    const emailEl = document.getElementById("custEmail");
    const notesEl = document.getElementById("custNotes");
    const phoneErr = document.getElementById("phoneErr");
    const checkoutBtn = document.getElementById("checkoutBtn");
    const checkoutStatus = document.getElementById("checkoutStatus");
    const CUSTOMER_KEY = "dr_customer_v1";

    

    function loadCustomer() {
      try {
        return JSON.parse(localStorage.getItem(CUSTOMER_KEY) || "{}") || {};
      } catch {
        return {};
      }
    }

    function saveCustomer(partial) {
      const cur = loadCustomer();
      const next = { ...cur, ...partial };
      localStorage.setItem(CUSTOMER_KEY, JSON.stringify(next));
    }

    // autofill customer details
    const saved = loadCustomer();
    if (saved.name) nameEl.value = saved.name;
    if (saved.phone) phoneEl.value = saved.phone;
    if (saved.method) methodEl.value = saved.method;
    if (saved.email) emailEl.value = saved.email;
    if (saved.notes) notesEl.value = saved.notes;
    
    function digitsOnlyStr(s) {
      return String(s || "").replace(/\D+/g, "");
    }

    function onlyDigits(s) { return /^[0-9]+$/.test(s); }

    function getCart() {
      return window.DarkroomCart.load();
    }

    function getCartItems() {
      const cart = getCart();
      return Object.entries(cart)
        .map(([id, qty]) => ({ id, qty: Number(qty) || 0 }))
        .filter(x => x.qty > 0);
    }

    function calcTotal(items) {
      let t = 0;
      for (const it of items) {
        const s = byId.get(it.id);
        if (!s) continue;
        t += s.price_cents * it.qty;
      }
      return t;
    }

    function renderCart() {
      const items = getCartItems();
      cartList.innerHTML = "";

      if (!items.length) {
        cartEmpty.style.display = "block";
        cartTotalEl.textContent = window.DarkroomCart.formatMVR(0);
        return;
      }
      cartEmpty.style.display = "none";

      for (const it of items) {
        const s = byId.get(it.id);
        if (!s) continue;

        const line = s.price_cents * it.qty;

        const row = document.createElement("div");
        row.className = "flex gap-4 rounded-2xl border border-[var(--line)] bg-white/30 p-4";

        row.innerHTML = `
          <div class="h-16 w-16 overflow-hidden rounded-xl border border-[var(--line)] bg-white/20">
            ${s.image_url ? `<img src="${s.image_url}" alt="${s.name}" class="h-full w-full object-cover" />` : `<div class="flex h-full w-full items-center justify-center text-[10px]" style="color: var(--muted);">No image</div>`}
          </div>

          <div class="min-w-0 flex-1">
            <div class="text-sm font-semibold">${s.name}</div>
            <div class="mt-1 text-xs" style="color: var(--muted);">${window.DarkroomCart.formatMVR(s.price_cents)} each</div>

            <div class="mt-3 flex items-center gap-2">
              <button class="h-8 w-8 cursor-pointer rounded-full border border-[var(--line)] bg-white/40 hover:bg-white/70" data-dec="${s.id}">−</button>
              <span class="w-10 text-center text-sm tabular-nums" data-dr-cart-qty="${s.id}">${window.DarkroomCart.getQty(s.id)}</span>
              <button class="h-8 w-8 cursor-pointer rounded-full border border-[var(--line)] bg-white/40 hover:bg-white/70" data-inc="${s.id}">+</button>
            </div>
          </div>

          <div class="text-right">
            <div class="text-sm font-semibold">${window.DarkroomCart.formatMVR(line)}</div>
            <button class="mt-3 text-xs underline hover:opacity-70" data-remove="${s.id}">Remove</button>
          </div>
        `;

        cartList.appendChild(row);
      }

      // bind buttons
      cartList.querySelectorAll("[data-inc]").forEach(btn => {
        btn.addEventListener("click", () => {
          window.DarkroomCart.inc(btn.getAttribute("data-inc"));
          window.DarkroomCart.toast("Added to cart");
        });
      });
      cartList.querySelectorAll("[data-dec]").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-dec");
          const before = window.DarkroomCart.getQty(id);
          window.DarkroomCart.dec(id);
          const after = window.DarkroomCart.getQty(id);
          if (before > 0 && after < before) window.DarkroomCart.toast("Removed from cart");
        });
      });
      cartList.querySelectorAll("[data-remove]").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-remove");
          window.DarkroomCart.setQty(id, 0);
          window.DarkroomCart.toast("Removed from cart");
        });
      });

      const total = calcTotal(items);
      cartTotalEl.textContent = window.DarkroomCart.formatMVR(total);
    }

    function validate() {
      const items = getCartItems();
      const name = nameEl.value.trim();
      const phone = phoneEl.value.trim();
      const method = methodEl.value.trim();

      let ok = true;
      if (!name) ok = false;
      if (!phone || !onlyDigits(phone)) ok = false;
      if (!method) ok = false;
      if (!items.length) ok = false;

      phoneErr.style.display = (phone && !onlyDigits(phone)) ? "block" : "none";
      checkoutBtn.disabled = !ok;
    }

    async function drawInvoicePng(payload) {
      const order = payload.order ?? payload.data?.order ?? payload;
      const items = payload.items ?? payload.data?.items ?? [];

      const W = 1000;
      const rowH = 44;
      const headerH = 220;
      const tableH = (items.length + 1) * rowH + 80;
      const H = headerH + tableH + 80;

      const canvas = document.createElement("canvas");
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext("2d");

      function splitMvr(cents) {
        const n = Number(cents || 0) / 100;
        const amt = n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return { cur: "MVR", amt };
      }

      function drawMoney(cents, xCur, xAmtRight, y) {
        const { cur, amt } = splitMvr(cents);

        // currency left
        ctx.textAlign = "left";
        ctx.fillText(cur, xCur, y);

        // amount right (decimal aligned naturally because same font + right edge fixed)
        ctx.textAlign = "right";
        ctx.fillText(amt, xAmtRight, y);

        // restore default if you want (optional)
        ctx.textAlign = "left";
      }

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, W, H);

      ctx.fillStyle = "#111111";
      ctx.font = "bold 44px sans-serif";
      ctx.fillText("DARKROOM", 60, 80);

      ctx.font = "20px sans-serif";
      ctx.fillStyle = "#333333";
      ctx.fillText(`Invoice: ${order.order_ref ?? payload.order_ref ?? ""}`, 60, 120);
      ctx.fillText(`Date: ${order.created_at ? new Date(order.created_at).toLocaleString() : new Date().toLocaleString()}`, 60, 150);

      ctx.fillText(`Name: ${order.customer_name ?? ""}`, 60, 185);
      ctx.fillText(`Phone: ${order.customer_phone ?? ""}`, 60, 210);
      ctx.fillText(`Contact: ${order.contact_method ?? ""}`, 60, 235);

      let y = headerH;
      ctx.strokeStyle = "#dddddd";
      ctx.beginPath();
      ctx.moveTo(60, y);
      ctx.lineTo(W - 60, y);
      ctx.stroke();

      y += 35;
      ctx.fillStyle = "#111111";
      ctx.font = "bold 18px sans-serif";
      ctx.fillText("Item", 60, y);
      ctx.fillText("Qty", 650, y);
      ctx.fillText("Total", 820, y);

      y += 18;
      ctx.strokeStyle = "#eeeeee";
      ctx.beginPath();
      ctx.moveTo(60, y);
      ctx.lineTo(W - 60, y);
      ctx.stroke();

      ctx.font = "18px sans-serif";
      ctx.fillStyle = "#222222";

      y += 36;
      for (const it of items) {
        ctx.fillText(String(it.service_name || it.name || "").slice(0, 42), 60, y);
        ctx.fillText(String(it.quantity || it.qty || 0), 665, y);
        drawMoney(it.line_total_cents, 820, W - 60, y);
        y += rowH;
      }

      y += 10;
      ctx.strokeStyle = "#dddddd";
      ctx.beginPath();
      ctx.moveTo(60, y);
      ctx.lineTo(W - 60, y);
      ctx.stroke();

      y += 40;
      ctx.font = "bold 22px sans-serif";
      ctx.fillStyle = "#111111";
      ctx.fillText("Grand total", 650, y);
      drawMoney(order.total_price_cents, 820, W - 60, y);

      return canvas.toDataURL("image/png");
    }

    async function checkout() {
      validate();
      if (checkoutBtn.disabled) return;

      checkoutBtn.disabled = true;
      checkoutStatus.textContent = "Placing order…";

      const cart = getCart();

      const payload = {
        customer_name: nameEl.value.trim(),
        customer_phone: phoneEl.value.trim(),
        contact_method: methodEl.value.trim(),
        customer_email: emailEl.value.trim() || null,
        customer_notes: notesEl.value.trim() || null,
        cart,
      };

      const res = await fetch("/api/orders/create", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        checkoutStatus.textContent = data?.error || `Checkout failed (${res.status})`;
        validate();
        return;
      }

      window.DarkroomCart.save({});
      window.DarkroomCart.toast("Order placed");

      const orderRef = data.order?.order_ref ?? data.order_ref ?? "(order)";
      checkoutStatus.textContent = `Order placed: ${orderRef}`;

      // invoice
      const png = await drawInvoicePng(data);
      const wrap = document.getElementById("invoiceWrap");
      const img = document.getElementById("invoiceImg");
      const dl = document.getElementById("downloadInvoice");
      if (wrap && img && dl) {
        wrap.style.display = "block";
        img.src = png;
        dl.href = png;
        dl.download = `${orderRef}.png`;
      }
    }

    // initial
    renderCart();
    validate();

    // react to cart changes
    window.addEventListener("dr-cart-changed", () => {
      renderCart();
      validate();
    });

    // enforce digits-only phone
    nameEl.addEventListener("input", () => {
      saveCustomer({ name: nameEl.value });
      validate();
    });

    phoneEl.addEventListener("input", () => {
      // keep your digit-only enforcement if you already have it
      const d = String(phoneEl.value || "").replace(/\D+/g, "");
      if (phoneEl.value !== d) phoneEl.value = d;

      saveCustomer({ phone: phoneEl.value });
      validate();
    });

    methodEl.addEventListener("change", () => {
      saveCustomer({ method: methodEl.value });
      validate();
    });

    emailEl.addEventListener("input", () => {
      saveCustomer({ email: emailEl.value });
      validate();
    });

    notesEl.addEventListener("input", () => {
      saveCustomer({ notes: notesEl.value });
      validate();
    });

    checkoutBtn.addEventListener("click", checkout);
  </script>
</BaseLayout>