---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  tags: string | null;
  primary_image_key: string | null;
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=600");

const res = await db.prepare(`
  SELECT
    id, slug, service_group, name, description, price_cents, active, tags, primary_image_key
  FROM services
  WHERE active = 1
  ORDER BY service_group ASC, name ASC;
`).all();

const rows = (res.results ?? []) as ServiceRow[];

function money(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}

function imgUrl(key: string | null) {
  if (!key) return null;
  return base ? `${base}/${key}` : `/${key}`;
}

function hrefFor(s: ServiceRow) {
  return `/shop/${s.slug ?? s.id}`;
}
---

<BaseLayout title="Shop — DARKROOM">
  <section class="mx-auto mt-10 max-w-6xl px-6">
    <h1 class="text-4xl" style="font-family: var(--font-serif);">Shop</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">Film, cameras, and lab services.</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rows.map((s) => (
        <ProductCard
          href={hrefFor(s)}
          image={imgUrl(s.primary_image_key) ?? undefined}
          name={s.name}
          price={money(s.price_cents)}
        />
      ))}
    </div>
  </section>
</BaseLayout>