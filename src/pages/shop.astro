---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  out_of_stock: number;
  tags: string | null;
  primary_image_key: string | null;
  turnaround_options: string | null;
  turnaround_prices: string | null;
  pushpull_options: string | null;
  pushpull_prices: string | null;
  collection_options: string | null;
  collection_prices: string | null;
};

const res = await db.prepare(`
  SELECT id, slug, service_group, name, description, price_cents, active, out_of_stock, tags, primary_image_key,
         turnaround_options, turnaround_prices, pushpull_options, pushpull_prices, collection_options, collection_prices
  FROM services
  WHERE active = 1
  ORDER BY service_group ASC, name ASC;
`).all();

const rows = (res.results ?? []) as ServiceRow[];

function imgUrl(key: string | null) {
  if (!key) return undefined;
  return base ? `${base}/${key}` : `/${key}`;
}

function hrefFor(s: ServiceRow) {
  return `/shop/${s.slug ?? s.id}`;
}

function parseOpts(raw: string | null): string[] {
  try { return JSON.parse(raw || '[]'); } catch { return []; }
}
---

<BaseLayout title="Shop — DARKROOM">
  <section class="mt-10">
    <h1 class="text-4xl md:text-5xl">Shop</h1>
    <p class="mt-3 text-sm" style="color: var(--muted);">
      Film, cameras, and lab services.
    </p>

    <div class="mt-10 grid grid-cols-2 gap-4 md:gap-8 md:grid-cols-3">
      {rows.map((s) => (
        <ProductCard
          id={s.id}
          href={hrefFor(s)}
          image={imgUrl(s.primary_image_key)}
          name={s.name}
          priceCents={s.price_cents}
          outOfStock={s.out_of_stock === 1}
          turnaroundOptions={parseOpts(s.turnaround_options)}
          turnaroundPrices={parseOpts(s.turnaround_prices)}
          pushpullOptions={parseOpts(s.pushpull_options)}
          pushpullPrices={parseOpts(s.pushpull_prices)}
        />
      ))}
    </div>
  </section>
</BaseLayout>