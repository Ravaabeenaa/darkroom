---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  out_of_stock: number;
  tags: string | null;
  primary_image_key: string | null;
  service_options: string | null;
};

const res = await db.prepare(`
  SELECT id, slug, service_group, name, description, price_cents, active, out_of_stock, tags, primary_image_key, service_options
  FROM services
  WHERE active = 1
  ORDER BY service_group ASC, name ASC;
`).all();

const rows = (res.results ?? []) as ServiceRow[];

function imgUrl(key: string | null) {
  if (!key) return undefined;
  return base ? `${base}/${key}` : `/${key}`;
}

function hrefFor(s: ServiceRow) {
  return `/shop/${s.slug ?? s.id}`;
}

function parseServiceOptions(raw: string | null) {
  try {
    const arr = JSON.parse(raw || '[]');
    return Array.isArray(arr) ? arr : [];
  } catch { return []; }
}

const groups = [...new Set(rows.map((s) => s.service_group).filter(Boolean))].sort() as string[];
---

<BaseLayout title="Shop — DARKROOM">
  <section class="mt-10">
    <h1 class="text-4xl md:text-5xl">Shop</h1>
    <p class="mt-3 text-sm" style="color: var(--muted);">
      Film, cameras, and lab services.
    </p>

    {groups.length > 0 && (
      <div class="relative mt-6 inline-block">
        <button id="filterBtn" type="button" class="flex cursor-pointer items-center gap-2 rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-2 text-sm hover:bg-white/80">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          Filter
          <span id="filterCount" class="ml-1 inline-flex min-w-[18px] items-center justify-center rounded-full bg-[var(--red)] px-1.5 py-0.5 text-[10px] font-medium text-black" style="display:none;"></span>
        </button>

        <div id="filterMenu" class="absolute left-0 top-full z-20 mt-2 hidden w-64 rounded-2xl border border-[var(--line)] bg-[var(--bg)] p-4 shadow-lg">
          <div class="text-xs font-medium uppercase tracking-wide" style="color: var(--muted);">Group</div>
          <div class="mt-3 max-h-64 space-y-2 overflow-y-auto">
            {groups.map((g) => (
              <label class="flex cursor-pointer items-center gap-2 text-sm">
                <input type="checkbox" data-filter-group value={g} class="h-4 w-4 accent-[var(--red)]" />
                <span>{g}</span>
              </label>
            ))}
          </div>
          <button id="filterResetBtn" type="button" class="mt-4 w-full cursor-pointer rounded-[999px] border border-[var(--line)] bg-white/10 px-4 py-2 text-xs hover:bg-white/20">
            Reset filter
          </button>
        </div>
      </div>
    )}

    <div id="filterEmptyMsg" class="mt-10 rounded-2xl border border-[var(--line)] bg-white/20 p-6 text-sm" style="display:none;color:var(--muted);">
      No services match the selected filters.
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-8 md:grid-cols-3">
      {rows.map((s) => (
        <div data-service-group={s.service_group ?? ""}>
          <ProductCard
            id={s.id}
            href={hrefFor(s)}
            image={imgUrl(s.primary_image_key)}
            name={s.name}
            priceCents={s.price_cents}
            outOfStock={s.out_of_stock === 1}
            serviceOptions={parseServiceOptions(s.service_options)}
          />
        </div>
      ))}
    </div>
  </section>

  <script>
    (function () {
      const filterBtn = document.getElementById("filterBtn");
      const filterMenu = document.getElementById("filterMenu");
      const resetBtn = document.getElementById("filterResetBtn");
      const filterCountEl = document.getElementById("filterCount");
      const emptyMsg = document.getElementById("filterEmptyMsg");
      const checkboxes = Array.from(document.querySelectorAll("[data-filter-group]"));
      const cards = Array.from(document.querySelectorAll("[data-service-group]"));

      function selectedGroups() {
        return checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);
      }

      function applyFilter() {
        const selected = selectedGroups();
        let visibleCount = 0;

        cards.forEach((card) => {
          const show = selected.length === 0 || selected.includes(card.getAttribute("data-service-group"));
          card.style.display = show ? "" : "none";
          if (show) visibleCount++;
        });

        if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? "block" : "none";
        if (filterCountEl) {
          filterCountEl.textContent = selected.length > 0 ? String(selected.length) : "";
          filterCountEl.style.display = selected.length > 0 ? "inline-flex" : "none";
        }
      }

      filterBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        filterMenu?.classList.toggle("hidden");
      });

      document.addEventListener("click", (e) => {
        if (
          filterMenu &&
          !filterMenu.classList.contains("hidden") &&
          !filterMenu.contains(e.target) &&
          e.target !== filterBtn &&
          !filterBtn?.contains(e.target)
        ) {
          filterMenu.classList.add("hidden");
        }
      });

      checkboxes.forEach((cb) => cb.addEventListener("change", applyFilter));

      resetBtn?.addEventListener("click", () => {
        checkboxes.forEach((cb) => { cb.checked = false; });
        applyFilter();
      });

      applyFilter();
    })();
  </script>
</BaseLayout>