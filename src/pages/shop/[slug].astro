---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getProductBySlug, money } from "../../lib/db";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const slug = Astro.params.slug as string;

// Optional edge caching for product pages
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=120, stale-while-revalidate=1200"
);

const product = await getProductBySlug(db, slug);

if (!product) {
  return new Response("Not found", { status: 404 });
}
---

<BaseLayout title={`${product.title} — DARKROOM`}>
  <section class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
    <div class="overflow-hidden bg-white/20 rounded-3xl border border-[var(--line)]">
      <img
        src={product.image ?? "https://picsum.photos/1200/1200"}
        alt={product.title}
        class="aspect-[4/5] w-full object-cover"
        loading="eager"
      />
    </div>

    <div class="lg:pt-2">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-4xl md:text-5xl" style="font-family: var(--font-serif);">
          {product.title}
        </h1>

        {product.badge && (
          <span class="mt-2 inline-block bg-black px-3 py-1 text-[11px] font-medium tracking-wide text-white rounded-full">
            {product.badge}
          </span>
        )}
      </div>

      <div class="mt-3 flex items-baseline gap-3 text-xl">
        <span class={product.compare_at_cents ? "text-[var(--text)]" : ""}>
          {money(product.price_cents, product.currency)}
        </span>
        {product.compare_at_cents && (
          <span class="opacity-60 line-through">
            {money(product.compare_at_cents, product.currency)}
          </span>
        )}
      </div>

      {product.short && (
        <p class="mt-5 max-w-prose text-sm md:text-base" style="color: var(--muted);">
          {product.short}
        </p>
      )}

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/cart" variant="filled">Add to cart</Button>
        <Button href="/shop" variant="outline">Back to shop</Button>
      </div>

      <!-- Linsoul-style info density (we'll expand next) -->
      <div class="mt-10 grid gap-4">
        <details class="rounded-3xl border border-[var(--line)] bg-white/30 p-6" open>
          <summary class="cursor-pointer list-none text-lg font-semibold">
            Overview
          </summary>
          <p class="mt-3 text-sm leading-6" style="color: var(--muted);">
            {product.description ?? "Add a longer description for this product."}
          </p>
        </details>

        <details class="rounded-3xl border border-[var(--line)] bg-white/30 p-6">
          <summary class="cursor-pointer list-none text-lg font-semibold">
            Shipping & Returns
          </summary>
          <p class="mt-3 text-sm leading-6" style="color: var(--muted);">
            Add your policy here (turnaround times, delivery, returns).
          </p>
        </details>

        <details class="rounded-3xl border border-[var(--line)] bg-white/30 p-6">
          <summary class="cursor-pointer list-none text-lg font-semibold">
            FAQs
          </summary>
          <p class="mt-3 text-sm leading-6" style="color: var(--muted);">
            Add FAQs here (compatibility, processing, storage, etc.).
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
