---
// src/pages/shop/[slug].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { products } from "../../lib/products";

export const prerender = true;

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;

// (Optional) If you ever switch to SSR later, you can handle missing product here.
// For static builds, this won’t happen because only known slugs are generated.
if (!product) {
  throw new Error("Product not found");
}
---

<BaseLayout title={`${product.title} — DARKROOM`}>
  <main class="mx-auto max-w-6xl px-6 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-[var(--muted)]">
      <a class="hover:underline" href="/shop">Shop</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--text)]">{product.title}</span>
    </nav>

    <section class="mt-6 grid gap-10 lg:grid-cols-2">
      <!-- Gallery -->
      <div class="space-y-4">
        <div class="overflow-hidden rounded-3xl border border-[var(--line)] bg-white">
          <img
            src={product.images?.[0]}
            alt={product.title}
            class="aspect-square w-full object-cover"
            loading="eager"
          />
        </div>

        {product.images?.length > 1 && (
          <div class="grid grid-cols-4 gap-3">
            {product.images.slice(1).map((src) => (
              <div class="overflow-hidden rounded-2xl border border-[var(--line)] bg-white">
                <img src={src} alt="" class="aspect-square w-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div>
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-4xl leading-[1.05] tracking-tight">{product.title}</h1>

          {product.badge && (
            <span class="rounded-full bg-black px-3 py-1 text-xs font-semibold text-white">
              {product.badge}
            </span>
          )}
        </div>

        <div class="mt-3 flex items-baseline gap-3">
          <div class="text-2xl font-semibold">${product.price.toFixed(2)}</div>
          {product.compareAtPrice && (
            <div class="text-[var(--muted)] line-through">
              ${product.compareAtPrice.toFixed(2)}
            </div>
          )}
        </div>

        {product.short && <p class="mt-4 text-[var(--muted)] leading-relaxed">{product.short}</p>}

        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/cart" variant="filled">Add to cart</Button>
          <Button href="/shop" variant="outline">Back to shop</Button>
        </div>

        <div class="mt-10 grid gap-8">
          <!-- Description -->
          <section class="rounded-3xl border border-[var(--line)] bg-white p-6">
            <h2 class="text-lg font-semibold">Overview</h2>
            <p class="mt-3 text-[var(--text)] leading-relaxed">
              {product.description ?? "Add a description for this product."}
            </p>
          </section>

          <!-- Specs -->
          <section class="rounded-3xl border border-[var(--line)] bg-white p-6">
            <h2 class="text-lg font-semibold">Specs</h2>
            <div class="mt-4 divide-y divide-[var(--line)]">
              {(product.specs ?? []).map((s) => (
                <div class="flex items-center justify-between gap-6 py-3">
                  <div class="text-sm text-[var(--muted)]">{s.label}</div>
                  <div class="text-sm font-medium">{s.value}</div>
                </div>
              ))}
              {(!product.specs || product.specs.length === 0) && (
                <div class="py-3 text-sm text-[var(--muted)]">Add specs in products.ts</div>
              )}
            </div>
          </section>

          <!-- In the box -->
          <section class="rounded-3xl border border-[var(--line)] bg-white p-6">
            <h2 class="text-lg font-semibold">In the box</h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm">
              {(product.inTheBox ?? []).map((x) => <li>{x}</li>)}
              {(!product.inTheBox || product.inTheBox.length === 0) && (
                <li class="text-[var(--muted)]">Add inTheBox items in products.ts</li>
              )}
            </ul>
          </section>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
