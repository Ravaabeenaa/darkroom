---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceGallery from "../../components/ServiceGallery.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");
const slugOrId = Astro.params.slug as string;

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  out_of_stock: number;
  bulk_discount_eligible: number;
  bulk_discount_percent: number;
  bulk_discount_min: number;
  tags: string | null;
  requires_group: string | null;
  requires_service_id: string | null;
  notes: string | null;
  primary_image_key: string | null;
  turnaround_options: string | null;
  turnaround_prices: string | null;
  pushpull_options: string | null;
  pushpull_prices: string | null;
};

type ImgRow = {
  image_key: string;
  alt: string | null;
  sort_order: number;
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=120, stale-while-revalidate=1200");

function imgUrl(key: string) {
  return base ? `${base}/${key}` : `/${key}`;
}

let service = await db
  .prepare(
    `
  SELECT id, slug, service_group, name, description, price_cents, active, out_of_stock, bulk_discount_eligible, bulk_discount_percent, bulk_discount_min, tags, requires_group, requires_service_id, notes, primary_image_key, turnaround_options, turnaround_prices, pushpull_options, pushpull_prices
  FROM services
  WHERE active=1 AND slug = ?
  LIMIT 1;
`
  )
  .bind(slugOrId)
  .first<ServiceRow>();

if (!service) {
  const byId = await db
    .prepare(
      `
    SELECT id, slug, service_group, name, description, price_cents, active, out_of_stock, bulk_discount_eligible, bulk_discount_percent, bulk_discount_min, tags, requires_group, requires_service_id, notes, primary_image_key, turnaround_options, turnaround_prices, pushpull_options, pushpull_prices
    FROM services
    WHERE active=1 AND id = ?
    LIMIT 1;
  `
    )
    .bind(slugOrId)
    .first<ServiceRow>();

  if (!byId) return new Response("Not found", { status: 404 });
  if (byId.slug) return Astro.redirect(`/shop/${byId.slug}`, 302);
  service = byId;
}

const gallery = await db
  .prepare(
    `
  SELECT image_key, alt, sort_order
  FROM service_images
  WHERE service_id = ? AND kind = 'gallery'
  ORDER BY sort_order ASC, created_at DESC;
`
  )
  .bind(service.id)
  .all<ImgRow>();

const galleryRows = gallery.results ?? [];

function parseOpts(raw: string | null): string[] {
  try { return JSON.parse(raw || '[]'); } catch { return []; }
}
const turnaroundOpts = parseOpts(service.turnaround_options);
const turnaroundPrices = parseOpts(service.turnaround_prices);
const pushpullOpts = parseOpts(service.pushpull_options);
const pushpullPrices = parseOpts(service.pushpull_prices);
---

<BaseLayout title={`${service.name} — DARKROOM`}>
  <section class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
    <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6 lg:p-8">
      <div class="mb-4 text-xs tracking-wide uppercase" style="color: var(--muted);">
        {service.service_group ?? "service"}
      </div>
      <ServiceGallery
        primary={service.primary_image_key ? { src: imgUrl(service.primary_image_key), alt: service.name } : null}
        gallery={galleryRows.map(img => ({ src: imgUrl(img.image_key), alt: img.alt ?? service.name }))}
      />
    </div>

    <div class="lg:pt-2">
      <h1 class="text-4xl md:text-5xl">{service.name}</h1>

      <div class="mt-3 text-xl font-medium" id="priceMvr"></div>

      {service.description && (
        <p class="mt-5 max-w-prose text-sm md:text-base" style="color: var(--muted);">
          {service.description}
        </p>
      )}

      {service.bulk_discount_eligible > 0 && (
        <div class="mt-6 rounded-2xl border px-4 py-3 text-sm" style="border-color: color-mix(in srgb, var(--red) 40%, transparent); background: color-mix(in srgb, var(--red) 8%, transparent);">
          <span style="color: var(--red);">{service.bulk_discount_percent ?? 5}% bulk discount</span>
          {service.bulk_discount_eligible === 1
            ? <span style="color: var(--muted);"> Order {service.bulk_discount_min ?? 5} or more from the {service.service_group ?? "same group"} group.</span>
            : <span style="color: var(--muted);"> Order {service.bulk_discount_min ?? 5} or more of this service with the same options.</span>
          }
        </div>
      )}

      {turnaroundOpts.length > 0 && (
        <div class="mt-6">
          <label class="block text-sm" style="color: var(--muted);">Turnaround</label>
          <select id="turnaroundSelect" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            {turnaroundOpts.map((opt, i) => (
              <option value={opt} data-price={turnaroundPrices[i] ?? "+0"}>{opt}{turnaroundPrices[i] && turnaroundPrices[i] !== "+0" ? ` (+MVR ${turnaroundPrices[i].replace(/^\+/, "")})` : ""}</option>
            ))}
          </select>
        </div>
      )}

      {pushpullOpts.length > 0 && (
        <div class="mt-4">
          <label class="block text-sm" style="color: var(--muted);">Push/Pull</label>
          <select id="pushpullSelect" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            {pushpullOpts.map((opt, i) => (
              <option value={opt} data-price={pushpullPrices[i] ?? "+0"}>{opt}{pushpullPrices[i] && pushpullPrices[i] !== "+0" ? ` (+MVR ${pushpullPrices[i].replace(/^\+/, "")})` : ""}</option>
            ))}
          </select>
        </div>
      )}

      <!-- Cart controls -->
      <div class="mt-8">
        {service.out_of_stock === 1 ? (
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-[var(--line)] px-4 py-2.5 text-sm font-medium" style="color: var(--muted);">
              Out of stock
            </span>
            <a class="rounded-[999px] border border-[var(--line)] bg-white/40 px-5 py-2.5 text-sm hover:bg-white/70" href="/shop">
              Back to shop
            </a>
          </div>
        ) : (
          <>
            <div class="flex flex-wrap items-center gap-3">
              <div class="flex items-center rounded-[999px] border border-[var(--line)] bg-white/40 px-1.5 py-1" id="qtyWrap">
                <button type="button" class="h-11 w-11 cursor-pointer rounded-full hover:bg-white/70 active:bg-white/70 text-lg" id="decBtn">−</button>
                <span id="qtyDisplay" class="w-10 text-center text-base tabular-nums">1</span>
                <button type="button" class="h-11 w-11 cursor-pointer rounded-full hover:bg-white/70 active:bg-white/70 text-lg" id="incBtn">+</button>
              </div>

              <button type="button" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-7 py-2.5 text-sm font-medium text-[var(--btnText)] hover:opacity-90 active:opacity-90" id="addToCartBtn">
                Add to cart
              </button>

              <a class="rounded-[999px] border border-[var(--line)] bg-white/40 px-5 py-2.5 text-sm hover:bg-white/70" href="/cart">
                View cart
              </a>
            </div>

            <a class="mt-3 block text-xs hover:opacity-70" style="color: var(--muted);" href="/shop">
              ← Back to shop
            </a>
          </>
        )}
      </div>

      {service.notes && (
        <div class="mt-10">
          <details class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6">
            <summary class="cursor-pointer list-none text-lg font-semibold">Notes</summary>
            <p class="mt-3 text-sm leading-6" style="color: var(--muted);">{service.notes}</p>
          </details>
        </div>
      )}
    </div>
  </section>

  <script define:vars={{ serviceId: service.id, basePriceCents: service.price_cents }}>
    (function () {
      var priceEl      = document.getElementById("priceMvr");
      var qtyEl        = document.getElementById("qtyDisplay");
      var incBtn       = document.getElementById("incBtn");
      var decBtn       = document.getElementById("decBtn");
      var addToCartBtn = document.getElementById("addToCartBtn");
      var turnaroundEl = document.getElementById("turnaroundSelect");
      var pushpullEl   = document.getElementById("pushpullSelect");

      function selectedOptionPrice(selectEl) {
        if (!selectEl) return 0;
        var opt = selectEl.options[selectEl.selectedIndex];
        var raw = opt ? (opt.getAttribute("data-price") || "+0") : "+0";
        var n = parseFloat(raw.replace(/^\+/, "")) || 0;
        return Math.round(n * 100);
      }

      function currentUnitPrice() {
        return basePriceCents
          + selectedOptionPrice(turnaroundEl)
          + selectedOptionPrice(pushpullEl);
      }

      function getCurrentKey() {
        var t = turnaroundEl ? turnaroundEl.value || null : null;
        var p = pushpullEl   ? pushpullEl.value   || null : null;
        return window.DarkroomCart.makeKey(serviceId, t, p);
      }

      var pending = 1;

      function renderAll() {
        if (!window.DarkroomCart) return;
        if (priceEl) priceEl.textContent = window.DarkroomCart.formatMVR(currentUnitPrice());
        if (qtyEl) qtyEl.textContent = String(pending);
      }

      var shopClosed = document.body.dataset.shopClosed === "1";

      if (!shopClosed) {
        incBtn && incBtn.addEventListener("click", function (e) {
          e.preventDefault();
          pending++;
          renderAll();
        });

        decBtn && decBtn.addEventListener("click", function (e) {
          e.preventDefault();
          if (pending > 1) { pending--; renderAll(); }
        });

        addToCartBtn && addToCartBtn.addEventListener("click", function (e) {
          e.preventDefault();
          if (!window.DarkroomCart) return;
          var key = getCurrentKey();
          var current = window.DarkroomCart.getQty(key);
          window.DarkroomCart.setQty(key, current + pending);
          window.DarkroomCart.toast("Added to cart");
          pending = 1;
          renderAll();
        });
      } else {
        if (incBtn) incBtn.disabled = true;
        if (decBtn) decBtn.disabled = true;
        if (addToCartBtn) addToCartBtn.disabled = true;
      }

      turnaroundEl && turnaroundEl.addEventListener("change", renderAll);
      pushpullEl   && pushpullEl.addEventListener("change", renderAll);
      renderAll();
    })();
  </script>
</BaseLayout>