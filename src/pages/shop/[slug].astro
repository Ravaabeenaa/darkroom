---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const slugOrId = Astro.params.slug as string;

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  tags: string | null;
  requires_group: string | null;
  requires_service_id: string | null;
  notes: string | null;
};

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=120, stale-while-revalidate=1200"
);

function money(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}

// 1) Try by slug
let service = await db.prepare(
  `
  SELECT id, slug, service_group, name, description, price_cents, active, tags, requires_group, requires_service_id, notes
  FROM services
  WHERE active=1 AND slug = ?
  LIMIT 1;
`
).bind(slugOrId).first<ServiceRow>();

if (!service) {
  // 2) Try by id
  const byId = await db.prepare(
    `
    SELECT id, slug, service_group, name, description, price_cents, active, tags, requires_group, requires_service_id, notes
    FROM services
    WHERE active=1 AND id = ?
    LIMIT 1;
  `
  ).bind(slugOrId).first<ServiceRow>();

  if (!byId) {
    return new Response("Not found", { status: 404 });
  }

  // Redirect /shop/dev001 -> /shop/<slug>
  if (byId.slug) {
    return Astro.redirect(`/shop/${byId.slug}`, 302);
  }

  service = byId;
}
---

<BaseLayout title={`${service.name} — DARKROOM`}>
  <section class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start">
    <div class="rounded-3xl border border-[var(--line)] bg-white/20 p-10">
      <div class="text-xs tracking-wide uppercase" style="color: var(--muted);">
        {service.service_group ?? "service"}
      </div>
      <div class="mt-4 text-sm" style="color: var(--muted);">
        Image support for services comes next (we’ll add a table for service images).
      </div>
    </div>

    <div class="lg:pt-2">
      <h1 class="text-4xl md:text-5xl" style="font-family: var(--font-serif);">
        {service.name}
      </h1>

      <div class="mt-3 text-xl">
        {money(service.price_cents)}
      </div>

      {service.description && (
        <p class="mt-5 max-w-prose text-sm md:text-base" style="color: var(--muted);">
          {service.description}
        </p>
      )}

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/cart" variant="filled">Add to cart</Button>
        <Button href="/shop" variant="outline">Back to shop</Button>
      </div>

      <div class="mt-10 grid gap-4">
        <details class="rounded-3xl border border-[var(--line)] bg-white/30 p-6" open>
          <summary class="cursor-pointer list-none text-lg font-semibold">Details</summary>
          <div class="mt-3 text-sm leading-6" style="color: var(--muted);">
            <div><b>ID:</b> {service.id}</div>
            {service.tags && <div class="mt-2"><b>Tags:</b> {service.tags}</div>}
            {service.requires_group && <div class="mt-2"><b>Requires group:</b> {service.requires_group}</div>}
            {service.requires_service_id && <div class="mt-2"><b>Requires service:</b> {service.requires_service_id}</div>}
          </div>
        </details>

        {service.notes && (
          <details class="rounded-3xl border border-[var(--line)] bg-white/30 p-6">
            <summary class="cursor-pointer list-none text-lg font-semibold">Notes</summary>
            <p class="mt-3 text-sm leading-6" style="color: var(--muted);">{service.notes}</p>
          </details>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
