---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const id = Astro.params.id as string;

type OrderRow = {
  id: string;
  order_ref: string;
  customer_name: string;
  customer_phone: string;
  customer_email: string | null;
  contact_method: string | null;
  services_summary: string | null;
  original_services_summary: string | null;
  total_price_cents: number;
  original_total_price_cents: number | null;
  status: string;
  customer_notes: string | null;
  internal_notes: string | null;
  created_at: string | null;
  updated_at: string | null;
};

type ItemRow = {
  id: string;
  service_id: string | null;
  service_name: string;
  unit_price_cents: number;
  quantity: number;
  line_total_cents: number;
  service_group: string | null;
};

const order = await db
  .prepare(`
    SELECT id, order_ref, customer_name, customer_phone, customer_email, contact_method,
           services_summary, original_services_summary,
           total_price_cents, original_total_price_cents,
           status, customer_notes, internal_notes, created_at, updated_at
    FROM orders WHERE id = ? LIMIT 1;
  `)
  .bind(id)
  .first<OrderRow>();

if (!order) return new Response("Order not found", { status: 404 });

const [currentRes, originalRes] = await Promise.all([
  db.prepare(`SELECT id, service_id, service_name, unit_price_cents, quantity, line_total_cents, service_group FROM order_items WHERE order_id = ? ORDER BY service_group ASC, service_name ASC;`).bind(id).all<ItemRow>(),
  db.prepare(`SELECT id, service_id, service_name, unit_price_cents, quantity, line_total_cents, service_group FROM order_items_original WHERE order_id = ? ORDER BY service_group ASC, service_name ASC;`).bind(id).all<ItemRow>(),
]);

const items = currentRes.results ?? [];
const originalItems = originalRes.results ?? [];

// Detect if the order has been modified from the original
const isModified =
  originalItems.length > 0 &&
  (order.total_price_cents !== (order.original_total_price_cents ?? order.total_price_cents) ||
   order.services_summary !== (order.original_services_summary ?? order.services_summary));

function money(cents: number) {
  return `MVR ${(cents / 100).toFixed(2)}`;
}

const STATUS_OPTIONS = ["NEW", "IN_PROGRESS", "READY", "COMPLETED", "CANCELLED"];

const statusColour: Record<string, string> = {
  NEW: "bg-blue-100 text-blue-800",
  IN_PROGRESS: "bg-yellow-100 text-yellow-800",
  READY: "bg-green-100 text-green-800",
  COMPLETED: "bg-gray-100 text-gray-600",
  CANCELLED: "bg-red-100 text-red-700",
};

const badgeCls = statusColour[order.status] ?? "bg-gray-100 text-gray-600";
---

<BaseLayout title={`${order.order_ref} — Orders`}>
  <section class="mx-auto mt-10 max-w-3xl">
    <div class="flex flex-wrap items-center gap-4">
      <a href="/admin/orders" class="cursor-pointer rounded-[999px] border border-[var(--line)] bg-white/10 px-4 py-2 text-sm hover:bg-white/20">
        ← Orders
      </a>
      <h1 class="font-mono text-2xl font-semibold">{order.order_ref}</h1>
      <span class={`rounded-full px-3 py-1 text-xs font-medium ${badgeCls}`}>{order.status}</span>
      {isModified && (
        <span class="rounded-full border border-yellow-400/40 px-3 py-1 text-xs text-yellow-300">
          ✎ Modified from original
        </span>
      )}
      <button
        id="dlInvoiceBtn"
        class="ml-auto cursor-pointer rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90"
      >
        Download Invoice ↓
      </button>
    </div>

    <p class="mt-2 text-xs" style="color: var(--muted);">
      Placed {order.created_at ? new Date(order.created_at).toLocaleString() : "—"}
      {order.updated_at && order.updated_at !== order.created_at && ` · Updated ${new Date(order.updated_at).toLocaleString()}`}
    </p>

    <!-- Customer details -->
    <div class="mt-8 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Customer</h2>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-xs" style="color: var(--muted);">Name</dt>
          <dd class="mt-1 font-medium">{order.customer_name}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Phone</dt>
          <dd class="mt-1">{order.customer_phone}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Contact via</dt>
          <dd class="mt-1">{order.contact_method ?? "—"}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Email</dt>
          <dd class="mt-1">{order.customer_email ?? "—"}</dd>
        </div>
        {order.customer_notes && (
          <div class="sm:col-span-2">
            <dt class="text-xs" style="color: var(--muted);">Customer notes</dt>
            <dd class="mt-1 whitespace-pre-wrap">{order.customer_notes}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Current order items (editable) -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Current order</h2>
      <p class="mt-1 text-xs" style="color: var(--muted);">Edit quantities and prices below, then save. Original order is unaffected.</p>

      {items.length === 0 ? (
        <p class="mt-4 text-sm" style="color: var(--muted);">No items recorded.</p>
      ) : (
        <div class="mt-4 overflow-hidden rounded-2xl border border-[var(--line)]">
          <table class="w-full text-left text-sm" id="itemsTable">
            <thead class="bg-white/5">
              <tr>
                <th class="px-4 py-3">Service</th>
                <th class="px-4 py-3 text-right">Unit (MVR)</th>
                <th class="px-4 py-3 text-right">Qty</th>
                <th class="px-4 py-3 text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it) => (
                <tr class="border-t border-[var(--line)]" data-item-id={it.id}>
                  <td class="px-4 py-3">
                    <div class="font-medium">{it.service_name}</div>
                    {it.service_group && (
                      <div class="mt-0.5 text-xs" style="color: var(--muted);">{it.service_group}</div>
                    )}
                  </td>
                  <td class="px-4 py-2 text-right">
                    <input
                      type="number"
                      min="0"
                      step="0.01"
                      name="unit"
                      value={(it.unit_price_cents / 100).toFixed(2)}
                      class="w-24 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-2 py-1.5 text-right text-sm tabular-nums outline-none focus:border-[var(--red)]"
                    />
                  </td>
                  <td class="px-4 py-2 text-right">
                    <input
                      type="number"
                      min="0"
                      step="1"
                      name="qty"
                      value={it.quantity}
                      class="w-16 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-2 py-1.5 text-right text-sm tabular-nums outline-none focus:border-[var(--red)]"
                    />
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums font-medium item-line-total">
                    {money(it.line_total_cents)}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot class="border-t border-[var(--line)] bg-white/5">
              <tr>
                <td colspan="3" class="px-4 py-3 text-right text-sm font-semibold">Total</td>
                <td id="itemsTotal" class="px-4 py-3 text-right tabular-nums font-semibold">{money(order.total_price_cents)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      )}

      {items.length > 0 && (
        <div class="mt-4 flex items-center gap-4">
          <button id="saveItemsBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
            Save items
          </button>
          <span id="saveItemsStatus" class="text-sm" style="color: var(--muted);"></span>
        </div>
      )}
    </div>

    <!-- Original order (collapsible) -->
    {originalItems.length > 0 && (
      <details class="mt-4 rounded-3xl border border-[var(--line)] bg-white/5">
        <summary class="cursor-pointer list-none px-6 py-4 text-sm font-medium" style="color: var(--muted);">
          <span class="select-none">▸ Show original order</span>
          {isModified && (
            <span class="ml-3 text-xs text-yellow-300">differs from current</span>
          )}
        </summary>

        <div class="px-6 pb-6">
          <p class="mb-4 text-xs" style="color: var(--muted);">
            Immutable snapshot taken at the time the order was placed. Never changes.
          </p>
          <div class="overflow-hidden rounded-2xl border border-[var(--line)]">
            <table class="w-full text-left text-sm">
              <thead class="bg-white/5">
                <tr>
                  <th class="px-4 py-3">Service</th>
                  <th class="px-4 py-3 text-right">Unit</th>
                  <th class="px-4 py-3 text-right">Qty</th>
                  <th class="px-4 py-3 text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                {originalItems.map((it) => (
                  <tr class="border-t border-[var(--line)]">
                    <td class="px-4 py-3">
                      <div class="font-medium">{it.service_name}</div>
                      {it.service_group && (
                        <div class="mt-0.5 text-xs" style="color: var(--muted);">{it.service_group}</div>
                      )}
                    </td>
                    <td class="px-4 py-3 text-right tabular-nums">{money(it.unit_price_cents)}</td>
                    <td class="px-4 py-3 text-right tabular-nums">{it.quantity}</td>
                    <td class="px-4 py-3 text-right tabular-nums font-medium">{money(it.line_total_cents)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot class="border-t border-[var(--line)] bg-white/5">
                <tr>
                  <td colspan="3" class="px-4 py-3 text-right text-sm font-semibold">Total</td>
                  <td class="px-4 py-3 text-right tabular-nums font-semibold">
                    {money(order.original_total_price_cents ?? order.total_price_cents)}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </details>
    )}

    <!-- Status + internal notes -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Update order</h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs" style="color: var(--muted);">Status</span>
          <select id="statusSel" class="mt-2 w-full cursor-pointer rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            {STATUS_OPTIONS.map((s) => (
              <option value={s} selected={order.status === s}>{s}</option>
            ))}
          </select>
        </label>

        <label class="block sm:col-span-2">
          <span class="text-xs" style="color: var(--muted);">Internal notes</span>
          <textarea id="internalNotes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">{order.internal_notes ?? ""}</textarea>
        </label>
      </div>

      <div class="mt-4 flex items-center gap-4">
        <button id="saveBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
          Save
        </button>
        <span id="saveStatus" class="text-sm" style="color: var(--muted);"></span>
      </div>
    </div>
  </section>

  <script define:vars={{ orderId: order.id }}>
    // ── Status / notes save ──────────────────────────────────────
    const saveBtn = document.getElementById("saveBtn");
    const statusSel = document.getElementById("statusSel");
    const notesEl = document.getElementById("internalNotes");
    const saveStatus = document.getElementById("saveStatus");

    saveBtn?.addEventListener("click", async () => {
      saveBtn.textContent = "Saving…";
      saveBtn.disabled = true;

      const res = await fetch("/api/admin/orders/update-status", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          order_id: orderId,
          status: statusSel?.value,
          internal_notes: notesEl?.value ?? "",
        }),
      });

      const data = await res.json().catch(() => null);
      saveBtn.textContent = "Save";
      saveBtn.disabled = false;

      if (!res.ok || !data?.ok) {
        saveStatus.textContent = data?.error || "Failed to save";
        return;
      }

      saveStatus.textContent = "Saved";
      window.DarkroomCart?.toast("Order updated");
      setTimeout(() => (saveStatus.textContent = ""), 3000);
    });

    // ── Item editing ─────────────────────────────────────────────
    const table = document.getElementById("itemsTable");
    const saveItemsBtn = document.getElementById("saveItemsBtn");
    const saveItemsStatus = document.getElementById("saveItemsStatus");

    function formatMVR(cents) {
      return "MVR " + (cents / 100).toFixed(2);
    }

    // Live-update row totals as user types
    table?.querySelectorAll("tr[data-item-id]").forEach((row) => {
      const unitInput = row.querySelector("input[name='unit']");
      const qtyInput = row.querySelector("input[name='qty']");
      const totalCell = row.querySelector(".item-line-total");

      function recalcRow() {
        const unit = Math.round(parseFloat(unitInput.value || "0") * 100);
        const qty = Math.max(0, parseInt(qtyInput.value || "0", 10));
        totalCell.textContent = formatMVR(unit * qty);
        recalcOrderTotal();
      }

      unitInput?.addEventListener("input", recalcRow);
      qtyInput?.addEventListener("input", recalcRow);
    });

    function recalcOrderTotal() {
      let sum = 0;
      table?.querySelectorAll("tr[data-item-id]").forEach((row) => {
        const unit = Math.round(parseFloat(row.querySelector("input[name='unit']")?.value || "0") * 100);
        const qty = Math.max(0, parseInt(row.querySelector("input[name='qty']")?.value || "0", 10));
        sum += unit * qty;
      });
      const totalEl = document.getElementById("itemsTotal");
      if (totalEl) totalEl.textContent = formatMVR(sum);
    }

    saveItemsBtn?.addEventListener("click", async () => {
      const rows = table?.querySelectorAll("tr[data-item-id]");
      if (!rows || rows.length === 0) return;

      const items = Array.from(rows).map((row) => ({
        id: row.getAttribute("data-item-id"),
        unit_price_cents: Math.round(parseFloat(row.querySelector("input[name='unit']")?.value || "0") * 100),
        qty: Math.max(0, parseInt(row.querySelector("input[name='qty']")?.value || "0", 10)),
      }));

      saveItemsBtn.textContent = "Saving…";
      saveItemsBtn.disabled = true;

      const res = await fetch("/api/admin/orders/update-items", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ order_id: orderId, items }),
      });

      const data = await res.json().catch(() => null);
      saveItemsBtn.textContent = "Save items";
      saveItemsBtn.disabled = false;

      if (!res.ok || !data?.ok) {
        saveItemsStatus.textContent = data?.error || "Failed to save";
        return;
      }

      saveItemsStatus.textContent = "Saved";
      window.DarkroomCart?.toast("Items updated");
      setTimeout(() => (saveItemsStatus.textContent = ""), 3000);
    });
  </script>

  <script is:inline src="/invoice-draw.js"></script>
  <script define:vars={{ orderData: {
    id: order.id,
    order_ref: order.order_ref,
    created_at: order.created_at,
    customer_name: order.customer_name,
    customer_phone: order.customer_phone,
    contact_method: order.contact_method,
    customer_email: order.customer_email,
    total_price_cents: order.total_price_cents,
  }, itemsData: items.map(it => ({
    service_name: it.service_name,
    service_group: it.service_group,
    quantity: it.quantity,
    line_total_cents: it.line_total_cents,
  })) }}>
    document.getElementById("dlInvoiceBtn")?.addEventListener("click", async function () {
      this.textContent = "Generating…";
      this.disabled = true;
      try {
        const png = await window.darkroomDrawInvoice(orderData, itemsData);
        const a = document.createElement("a");
        a.href = png;
        a.download = `${orderData.order_ref}.png`;
        a.click();
      } catch (e) {
        alert("Invoice failed: " + e.message);
      } finally {
        this.textContent = "Download Invoice ↓";
        this.disabled = false;
      }
    });
  </script>
</BaseLayout>
