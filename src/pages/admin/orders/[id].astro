---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const id = Astro.params.id as string;

type OrderRow = {
  id: string;
  order_ref: string;
  customer_name: string;
  customer_phone: string;
  customer_email: string | null;
  contact_method: string | null;
  services_summary: string | null;
  original_services_summary: string | null;
  total_price_cents: number;
  original_total_price_cents: number | null;
  status: string;
  customer_notes: string | null;
  internal_notes: string | null;
  created_at: string | null;
  updated_at: string | null;
};

type ItemRow = {
  id: string;
  service_id: string | null;
  service_name: string;
  unit_price_cents: number;
  quantity: number;
  line_total_cents: number;
  service_group: string | null;
};

type DiscountRow = {
  id: string;
  label: string;
  scope: string;
  scope_ref: string | null;
  amount_type: string;
  amount: number;
  computed_cents: number;
};

const order = await db
  .prepare(`
    SELECT id, order_ref, customer_name, customer_phone, customer_email, contact_method,
           services_summary, original_services_summary,
           total_price_cents, original_total_price_cents,
           status, customer_notes, internal_notes, created_at, updated_at
    FROM orders WHERE id = ? LIMIT 1;
  `)
  .bind(id)
  .first<OrderRow>();

if (!order) return new Response("Order not found", { status: 404 });

const [currentRes, originalRes, discountsRes] = await Promise.all([
  db.prepare(`SELECT id, service_id, service_name, unit_price_cents, quantity, line_total_cents, service_group FROM order_items WHERE order_id = ? ORDER BY CASE WHEN line_total_cents < 0 THEN 2 WHEN service_id IS NULL THEN 1 ELSE 0 END ASC, service_group ASC, service_name ASC;`).bind(id).all<ItemRow>(),
  db.prepare(`SELECT id, service_id, service_name, unit_price_cents, quantity, line_total_cents, service_group FROM order_items_original WHERE order_id = ? ORDER BY CASE WHEN line_total_cents < 0 THEN 2 WHEN service_id IS NULL THEN 1 ELSE 0 END ASC, service_group ASC, service_name ASC;`).bind(id).all<ItemRow>(),
  db.prepare(`SELECT id, label, scope, scope_ref, amount_type, amount, computed_cents FROM order_discounts WHERE order_id = ? ORDER BY created_at ASC;`).bind(id).all<DiscountRow>(),
]);

const items = currentRes.results ?? [];
const originalItems = originalRes.results ?? [];
const discounts = discountsRes.results ?? [];

const serviceGroups = [...new Set(items.map(it => it.service_group).filter(Boolean))] as string[];
const itemsList = items.filter(it => it.service_id !== null).map(it => ({ id: it.id, name: it.service_name }));

// Detect if the order has been modified from the original
const isModified =
  originalItems.length > 0 &&
  (order.total_price_cents !== (order.original_total_price_cents ?? order.total_price_cents) ||
   order.services_summary !== (order.original_services_summary ?? order.services_summary));

function money(cents: number) {
  return `MVR ${(cents / 100).toFixed(2)}`;
}

const STATUS_OPTIONS = ["NEW", "IN_PROGRESS", "READY", "COMPLETED", "CANCELLED"];

const statusColour: Record<string, string> = {
  NEW: "bg-blue-100 text-blue-800",
  IN_PROGRESS: "bg-yellow-100 text-yellow-800",
  READY: "bg-green-100 text-green-800",
  COMPLETED: "bg-gray-100 text-gray-600",
  CANCELLED: "bg-red-100 text-red-700",
};

const badgeCls = statusColour[order.status] ?? "bg-gray-100 text-gray-600";
---

<BaseLayout title={`${order.order_ref} — Orders`}>
  <section class="mx-auto mt-10 max-w-3xl">
    <div class="flex flex-wrap items-center gap-4">
      <a href="/admin/orders" class="cursor-pointer rounded-[999px] border border-[var(--line)] bg-white/10 px-4 py-2 text-sm hover:bg-white/20">
        ← Orders
      </a>
      <h1 class="font-mono text-2xl font-semibold">{order.order_ref}</h1>
      <span class={`rounded-full px-3 py-1 text-xs font-medium ${badgeCls}`}>{order.status}</span>
      {isModified && (
        <span class="rounded-full border border-yellow-400/40 px-3 py-1 text-xs text-yellow-300">
          ✎ Modified from original
        </span>
      )}
      <div class="ml-auto flex gap-2">
        <button id="dlPngBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
          PNG ↓
        </button>
        <button id="dlPdfBtn" class="cursor-pointer rounded-[999px] border border-[var(--line)] bg-white/10 px-5 py-2 text-sm font-medium hover:bg-white/20">
          PDF ↓
        </button>
      </div>
    </div>

    <p class="mt-2 text-xs" style="color: var(--muted);">
      Placed {order.created_at ? new Date(order.created_at).toLocaleString() : "—"}
      {order.updated_at && order.updated_at !== order.created_at && ` · Updated ${new Date(order.updated_at).toLocaleString()}`}
    </p>

    <!-- Customer details -->
    <div class="mt-8 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Customer</h2>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-xs" style="color: var(--muted);">Name</dt>
          <dd class="mt-1 font-medium">{order.customer_name}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Phone</dt>
          <dd class="mt-1">{order.customer_phone}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Contact via</dt>
          <dd class="mt-1">{order.contact_method ?? "—"}</dd>
        </div>
        <div>
          <dt class="text-xs" style="color: var(--muted);">Email</dt>
          <dd class="mt-1">{order.customer_email ?? "—"}</dd>
        </div>
        {order.customer_notes && (
          <div class="sm:col-span-2">
            <dt class="text-xs" style="color: var(--muted);">Customer notes</dt>
            <dd class="mt-1 whitespace-pre-wrap">{order.customer_notes}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Current order items (editable) -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Current order</h2>
      <p class="mt-1 text-xs" style="color: var(--muted);">Edit quantities and prices below, then save. Original order is unaffected.</p>

      {items.length === 0 ? (
        <p class="mt-4 text-sm" style="color: var(--muted);">No items recorded.</p>
      ) : (
        <div class="mt-4 overflow-x-auto rounded-2xl border border-[var(--line)]">
          <table class="w-full min-w-[480px] text-left text-sm" id="itemsTable">
            <thead class="bg-white/5">
              <tr>
                <th class="px-4 py-3">Service</th>
                <th class="px-4 py-3 text-right">Unit (MVR)</th>
                <th class="px-4 py-3 text-right">Qty</th>
                <th class="px-4 py-3 text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it) => {
                const isBulk = it.service_id === null && it.service_name.startsWith("Bulk discount ");
                const bulkMatch = isBulk ? it.service_name.match(/^Bulk discount \((.+)\)$/) : null;
                const bulkScope = bulkMatch ? bulkMatch[1] : null;
                return (
                  <tr
                    class="border-t border-[var(--line)]"
                    data-item-id={it.id}
                    data-service-group={!isBulk ? (it.service_group ?? "") : undefined}
                    data-service-name={!isBulk ? it.service_name : undefined}
                    data-bulk-scope={bulkScope ?? undefined}
                  >
                    <td class="px-4 py-3">
                      <div class="font-medium" style={isBulk ? "color: var(--red);" : ""}>{it.service_name}</div>
                      {it.service_group && (
                        <div class="mt-0.5 text-xs" style="color: var(--muted);">{it.service_group}</div>
                      )}
                    </td>
                    <td class="px-4 py-2 text-right">
                      <input
                        type="number"
                        min={isBulk ? undefined : "0"}
                        step="0.01"
                        name="unit"
                        value={(it.unit_price_cents / 100).toFixed(2)}
                        readonly={isBulk}
                        class={`w-24 rounded-xl border border-[var(--line)] px-2 py-1.5 text-right text-sm tabular-nums outline-none ${isBulk ? "bg-white/5 cursor-default opacity-60" : "bg-[var(--input-bg)] focus:border-[var(--red)]"}`}
                      />
                    </td>
                    <td class="px-4 py-2 text-right">
                      <input
                        type="number"
                        min="0"
                        step="1"
                        name="qty"
                        value={it.quantity}
                        class="w-16 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-2 py-1.5 text-right text-sm tabular-nums outline-none focus:border-[var(--red)]"
                      />
                    </td>
                    <td class="px-4 py-3 text-right tabular-nums font-medium item-line-total" style={isBulk ? "color: var(--red);" : ""}>
                      {money(it.line_total_cents)}
                    </td>
                  </tr>
                );
              })}
            </tbody>
            <tfoot class="border-t border-[var(--line)] bg-white/5">
              <tr>
                <td colspan="3" class="px-4 py-3 text-right text-sm font-semibold">Total</td>
                <td id="itemsTotal" class="px-4 py-3 text-right tabular-nums font-semibold">{money(order.total_price_cents)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      )}

      {items.length > 0 && (
        <div class="mt-4 flex items-center gap-4">
          <button id="saveItemsBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
            Save items
          </button>
          <span id="saveItemsStatus" class="text-sm" style="color: var(--muted);"></span>
        </div>
      )}
    </div>

    <!-- Manual discounts -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Manual discounts</h2>

      <div id="discountsList" class="mt-4">
        {discounts.length === 0 ? (
          <p id="noDiscountsMsg" class="text-sm" style="color: var(--muted);">No manual discounts applied.</p>
        ) : (
          <div class="overflow-x-auto rounded-2xl border border-[var(--line)]" id="discountsTable">
            <table class="w-full min-w-[360px] text-left text-sm">
              <tbody>
                {discounts.map((d) => (
                  <tr class="border-t border-[var(--line)] first:border-0" data-discount-id={d.id}>
                    <td class="px-4 py-3">
                      <div class="font-medium">{d.label}</div>
                      <div class="mt-0.5 text-xs" style="color: var(--muted);">
                        {d.scope}{d.scope_ref ? ` · ${d.scope_ref}` : ""}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm" style="color: var(--muted);">
                      {d.amount_type === "percent" ? `${d.amount}%` : `MVR ${(d.amount / 100).toFixed(2)}`}
                    </td>
                    <td class="px-4 py-3 text-right font-medium tabular-nums" style="color: var(--red);">
                      −{money(d.computed_cents)}
                    </td>
                    <td class="px-4 py-3 text-right">
                      <button
                        class="remove-discount-btn cursor-pointer rounded-full border border-[var(--line)] px-3 py-1 text-xs hover:bg-white/10"
                        style="color: var(--muted);"
                        data-discount-id={d.id}
                      >
                        Remove
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <details class="mt-4 rounded-2xl border border-[var(--line)] bg-white/5">
        <summary class="cursor-pointer list-none px-4 py-3 text-sm font-medium">+ Add discount</summary>
        <div class="px-4 pb-4 pt-2">
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs" style="color: var(--muted);">Label</span>
              <input id="discLabel" type="text" placeholder="VIP discount" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 py-2 text-sm outline-none focus:border-[var(--red)]" />
            </label>
            <label class="block">
              <span class="text-xs" style="color: var(--muted);">Scope</span>
              <select id="discScope" class="mt-1 w-full cursor-pointer rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 py-2 text-sm outline-none">
                <option value="total">Whole bill</option>
                <option value="group">By group</option>
                <option value="item">Specific item</option>
              </select>
            </label>
            <label id="discScopeRefWrap" class="block hidden sm:col-span-2">
              <span id="discScopeRefLabel" class="text-xs" style="color: var(--muted);">Scope ref</span>
              <input id="discScopeRef" type="text" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 py-2 text-sm outline-none focus:border-[var(--red)]" list="discScopeRefList" />
              <datalist id="discScopeRefList"></datalist>
            </label>
            <label class="block">
              <span class="text-xs" style="color: var(--muted);">Type</span>
              <select id="discAmountType" class="mt-1 w-full cursor-pointer rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 py-2 text-sm outline-none">
                <option value="percent">Percent (%)</option>
                <option value="fixed">Fixed (MVR)</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs" style="color: var(--muted);">Amount</span>
              <input id="discAmount" type="number" min="0.01" step="0.01" placeholder="10" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 py-2 text-sm outline-none focus:border-[var(--red)]" />
            </label>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <button id="addDiscountBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90">Apply</button>
            <span id="discountStatus" class="text-sm" style="color: var(--muted);"></span>
          </div>
        </div>
      </details>
    </div>

    <!-- Original order (collapsible) -->
    {originalItems.length > 0 && (
      <details class="mt-4 rounded-3xl border border-[var(--line)] bg-white/5">
        <summary class="cursor-pointer list-none px-6 py-4 text-sm font-medium" style="color: var(--muted);">
          <span class="select-none">▸ Show original order</span>
          {isModified && (
            <span class="ml-3 text-xs text-yellow-300">differs from current</span>
          )}
        </summary>

        <div class="px-6 pb-6">
          <p class="mb-4 text-xs" style="color: var(--muted);">
            Immutable snapshot taken at the time the order was placed. Never changes.
          </p>
          <div class="overflow-x-auto rounded-2xl border border-[var(--line)]">
            <table class="w-full min-w-[360px] text-left text-sm">
              <thead class="bg-white/5">
                <tr>
                  <th class="px-4 py-3">Service</th>
                  <th class="px-4 py-3 text-right">Unit</th>
                  <th class="px-4 py-3 text-right">Qty</th>
                  <th class="px-4 py-3 text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                {originalItems.map((it) => (
                  <tr class="border-t border-[var(--line)]">
                    <td class="px-4 py-3">
                      <div class="font-medium">{it.service_name}</div>
                      {it.service_group && (
                        <div class="mt-0.5 text-xs" style="color: var(--muted);">{it.service_group}</div>
                      )}
                    </td>
                    <td class="px-4 py-3 text-right tabular-nums">{money(it.unit_price_cents)}</td>
                    <td class="px-4 py-3 text-right tabular-nums">{it.quantity}</td>
                    <td class="px-4 py-3 text-right tabular-nums font-medium">{money(it.line_total_cents)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot class="border-t border-[var(--line)] bg-white/5">
                <tr>
                  <td colspan="3" class="px-4 py-3 text-right text-sm font-semibold">Total</td>
                  <td class="px-4 py-3 text-right tabular-nums font-semibold">
                    {money(order.original_total_price_cents ?? order.total_price_cents)}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </details>
    )}

    <!-- Status + internal notes -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/5 p-6">
      <h2 class="text-lg font-semibold">Update order</h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs" style="color: var(--muted);">Status</span>
          <select id="statusSel" class="mt-2 w-full cursor-pointer rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">
            {STATUS_OPTIONS.map((s) => (
              <option value={s} selected={order.status === s}>{s}</option>
            ))}
          </select>
        </label>

        <label class="block sm:col-span-2">
          <span class="text-xs" style="color: var(--muted);">Internal notes</span>
          <textarea id="internalNotes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-[var(--input-bg)] px-4 py-3 text-sm outline-none">{order.internal_notes ?? ""}</textarea>
        </label>
      </div>

      <div class="mt-4 flex items-center gap-4">
        <button id="saveBtn" class="cursor-pointer rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
          Save
        </button>
        <span id="saveStatus" class="text-sm" style="color: var(--muted);"></span>
      </div>
    </div>
  </section>

  <script define:vars={{ orderId: order.id }}>
    // ── Status / notes save ──────────────────────────────────────
    const saveBtn = document.getElementById("saveBtn");
    const statusSel = document.getElementById("statusSel");
    const notesEl = document.getElementById("internalNotes");
    const saveStatus = document.getElementById("saveStatus");

    saveBtn?.addEventListener("click", async () => {
      saveBtn.textContent = "Saving…";
      saveBtn.disabled = true;

      const res = await fetch("/api/admin/orders/update-status", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          order_id: orderId,
          status: statusSel?.value,
          internal_notes: notesEl?.value ?? "",
        }),
      });

      const data = await res.json().catch(() => null);
      saveBtn.textContent = "Save";
      saveBtn.disabled = false;

      if (!res.ok || !data?.ok) {
        saveStatus.textContent = data?.error || "Failed to save";
        return;
      }

      saveStatus.textContent = "Saved";
      window.DarkroomCart?.toast("Order updated");
      setTimeout(() => (saveStatus.textContent = ""), 3000);
    });

    // ── Item editing ─────────────────────────────────────────────
    const table = document.getElementById("itemsTable");
    const saveItemsBtn = document.getElementById("saveItemsBtn");
    const saveItemsStatus = document.getElementById("saveItemsStatus");

    function formatMVR(cents) {
      return "MVR " + (cents / 100).toFixed(2);
    }

    function rowLineCents(row) {
      const unit = Math.round(parseFloat(row.querySelector("input[name='unit']")?.value || "0") * 100);
      const qty = Math.max(0, parseInt(row.querySelector("input[name='qty']")?.value || "0", 10));
      return unit * qty;
    }

    function recalcRow(row) {
      const totalCell = row.querySelector(".item-line-total");
      if (totalCell) totalCell.textContent = formatMVR(rowLineCents(row));
    }

    // Recalculate all bulk-discount rows based on their scope's current item totals
    function recalcAllBulkDiscounts() {
      table?.querySelectorAll("tr[data-bulk-scope]").forEach((discRow) => {
        const scope = discRow.getAttribute("data-bulk-scope");
        let scopeTotal = 0;

        // Sum regular items that match this scope (by group OR by service name)
        table?.querySelectorAll("tr[data-service-group]").forEach((itemRow) => {
          if (
            itemRow.getAttribute("data-service-group") === scope ||
            itemRow.getAttribute("data-service-name") === scope
          ) {
            scopeTotal += rowLineCents(itemRow);
          }
        });

        // Unit = -1% of scope total; qty = the discount percentage
        const unitCents = -Math.round(scopeTotal * 0.01);
        const unitInput = discRow.querySelector("input[name='unit']");
        if (unitInput) unitInput.value = (unitCents / 100).toFixed(2);
        recalcRow(discRow);
      });
    }

    function recalcOrderTotal() {
      let sum = 0;
      table?.querySelectorAll("tr[data-item-id]").forEach((row) => {
        sum += rowLineCents(row);
      });
      const totalEl = document.getElementById("itemsTotal");
      if (totalEl) totalEl.textContent = formatMVR(sum);
    }

    // Attach listeners
    table?.querySelectorAll("tr[data-item-id]").forEach((row) => {
      const isBulk = row.hasAttribute("data-bulk-scope");
      const unitInput = row.querySelector("input[name='unit']");
      const qtyInput  = row.querySelector("input[name='qty']");

      if (isBulk) {
        // Only qty is manually editable; unit is auto-calculated
        qtyInput?.addEventListener("input", () => {
          recalcRow(row);
          recalcOrderTotal();
        });
      } else {
        const onRegularChange = () => {
          recalcRow(row);
          recalcAllBulkDiscounts();
          recalcOrderTotal();
        };
        unitInput?.addEventListener("input", onRegularChange);
        qtyInput?.addEventListener("input", onRegularChange);
      }
    });

    // Seed correct bulk-discount units on page load (DB stores 0)
    recalcAllBulkDiscounts();
    recalcOrderTotal();

    saveItemsBtn?.addEventListener("click", async () => {
      const rows = table?.querySelectorAll("tr[data-item-id]");
      if (!rows || rows.length === 0) return;

      const items = Array.from(rows).map((row) => ({
        id: row.getAttribute("data-item-id"),
        unit_price_cents: Math.round(parseFloat(row.querySelector("input[name='unit']")?.value || "0") * 100),
        qty: Math.max(0, parseInt(row.querySelector("input[name='qty']")?.value || "0", 10)),
      }));

      saveItemsBtn.textContent = "Saving…";
      saveItemsBtn.disabled = true;

      const res = await fetch("/api/admin/orders/update-items", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ order_id: orderId, items }),
      });

      const data = await res.json().catch(() => null);
      saveItemsBtn.textContent = "Save items";
      saveItemsBtn.disabled = false;

      if (!res.ok || !data?.ok) {
        saveItemsStatus.textContent = data?.error || "Failed to save";
        return;
      }

      saveItemsStatus.textContent = "Saved";
      window.DarkroomCart?.toast("Items updated");
      setTimeout(() => (saveItemsStatus.textContent = ""), 3000);
    });
  </script>

  <script define:vars={{ orderId: order.id, serviceGroups, itemsList }}>
    // ── Discount form ─────────────────────────────────────────────
    const discScope       = document.getElementById("discScope");
    const discScopeRefWrap = document.getElementById("discScopeRefWrap");
    const discScopeRefLabel = document.getElementById("discScopeRefLabel");
    const discScopeRef    = document.getElementById("discScopeRef");
    const discScopeRefList = document.getElementById("discScopeRefList");

    function updateScopeRef() {
      const v = discScope?.value;
      if (v === "total") {
        discScopeRefWrap?.classList.add("hidden");
        return;
      }
      discScopeRefWrap?.classList.remove("hidden");
      // Clear datalist
      if (discScopeRefList) discScopeRefList.innerHTML = "";
      if (discScopeRef) discScopeRef.value = "";

      if (v === "group") {
        if (discScopeRefLabel) discScopeRefLabel.textContent = "Group name";
        serviceGroups.forEach((g) => {
          const opt = document.createElement("option");
          opt.value = g;
          discScopeRefList?.appendChild(opt);
        });
      } else {
        if (discScopeRefLabel) discScopeRefLabel.textContent = "Item";
        itemsList.forEach((it) => {
          const opt = document.createElement("option");
          opt.value = it.id;
          opt.label = it.name;
          discScopeRefList?.appendChild(opt);
        });
      }
    }

    discScope?.addEventListener("change", updateScopeRef);
    updateScopeRef();

    document.getElementById("addDiscountBtn")?.addEventListener("click", async () => {
      const label       = document.getElementById("discLabel")?.value.trim();
      const scope       = discScope?.value;
      const scope_ref   = scope !== "total" ? (discScopeRef?.value.trim() || null) : null;
      const amount_type = document.getElementById("discAmountType")?.value;
      const amount      = parseFloat(document.getElementById("discAmount")?.value || "0");
      const statusEl    = document.getElementById("discountStatus");

      if (!label) { statusEl.textContent = "Label is required"; return; }

      statusEl.textContent = "Applying…";

      const res = await fetch("/api/admin/orders/add-discount", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ order_id: orderId, label, scope, scope_ref, amount_type, amount }),
      });
      const data = await res.json().catch(() => null);

      if (!res.ok || !data?.ok) {
        statusEl.textContent = data?.error || "Failed";
        return;
      }

      location.reload();
    });

    document.querySelectorAll(".remove-discount-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const discountId = btn.getAttribute("data-discount-id");
        const res = await fetch("/api/admin/orders/remove-discount", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ order_id: orderId, discount_id: discountId }),
        });
        if (res.ok) location.reload();
      });
    });
  </script>

  <script is:inline src="/invoice-draw.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script define:vars={{ orderRef: order.order_ref, invoiceOrderId: order.id }}>
    async function fetchInvoiceData() {
      const resp = await fetch(`/api/admin/orders/invoice-data?id=${invoiceOrderId}`);
      const data = await resp.json();
      if (!data.ok) throw new Error(data.error || "Failed to load invoice data");
      return data;
    }

    document.getElementById("dlPngBtn")?.addEventListener("click", async function () {
      this.textContent = "…";
      this.disabled = true;
      try {
        const data = await fetchInvoiceData();
        const png = await window.darkroomDrawInvoice(data.order, data.items);
        const a = document.createElement("a");
        a.href = png;
        a.download = `${orderRef}.png`;
        a.click();
      } catch (e) {
        alert("Invoice failed: " + e.message);
      } finally {
        this.textContent = "PNG ↓";
        this.disabled = false;
      }
    });

    document.getElementById("dlPdfBtn")?.addEventListener("click", async function () {
      this.textContent = "…";
      this.disabled = true;
      try {
        const data = await fetchInvoiceData();
        const png = await window.darkroomDrawInvoice(data.order, data.items);
        const img = new Image();
        img.src = png;
        await new Promise((r) => { img.onload = r; });
        const ptW = img.naturalWidth  / 2 * 72 / 96;
        const ptH = img.naturalHeight / 2 * 72 / 96;
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ unit: "pt", format: [ptW, ptH], orientation: "portrait" });
        pdf.addImage(png, "PNG", 0, 0, ptW, ptH);
        pdf.save(`${orderRef}.pdf`);
      } catch (e) {
        alert("Invoice failed: " + e.message);
      } finally {
        this.textContent = "PDF ↓";
        this.disabled = false;
      }
    });
  </script>
</BaseLayout>
