---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");
const id = Astro.params.id as string;

type ServiceRow = {
  id: string;
  slug: string;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  active: number;
  featured: number;
  bulk_discount_eligible: number;
  bulk_discount_percent: number;
  bulk_discount_min: number;
  priority: number;
  tags: string | null;
  notes: string | null;
  primary_image_key: string | null;
  service_options: string | null;
  stock: number;
  out_of_stock: number;
};

type ImageRow = {
  id: string;
  service_id: string;
  image_key: string;
  kind: "primary" | "gallery" | "sample";
  sort_order: number;
  alt: string | null;
  created_at: string | null;
};

const service = await db.prepare(`
  SELECT id, slug, service_group, name, description, price_cents, active, featured, bulk_discount_eligible, bulk_discount_percent, bulk_discount_min, priority, tags, notes, primary_image_key, service_options, stock, out_of_stock
  FROM services
  WHERE slug = ? OR id = ?
  LIMIT 1;
`).bind(id, id).first<ServiceRow>();

if (!service) {
  return new Response("Not found", { status: 404 });
}

const imgs = await db.prepare(`
  SELECT id, service_id, image_key, kind, sort_order, alt, created_at
  FROM service_images
  WHERE service_id = ?
  ORDER BY
    CASE kind WHEN 'primary' THEN 0 WHEN 'gallery' THEN 1 ELSE 2 END,
    sort_order ASC,
    created_at DESC;
`).bind(id).all<ImageRow>();

const imageRows = imgs.results ?? [];
const primary = imageRows.find((r) => r.kind === "primary") ?? null;
const gallery = imageRows.filter((r) => r.kind === "gallery");

const saved = Astro.url.searchParams.get("saved") === "1";

function moneyToInput(cents: number) {
  return (cents / 100).toFixed(2).replace(/\.00$/, "");
}
function imgUrl(key: string) {
  return base ? `${base}/${key}` : `/${key}`;
}
---

<BaseLayout title={`Edit — ${service.name}`}>
  <section class="mx-auto mt-12 max-w-3xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-4xl" style="font-family: var(--font-serif);">Edit service</h1>
        <p class="mt-2 text-sm" style="color: var(--muted);">
          ID: <span class="font-mono">{service.id}</span> • slug: <span class="font-mono">{service.slug}</span>
        </p>
      </div>
      <a class="rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-3 text-sm hover:bg-white/80" href="/admin/services">
        Back
      </a>
    </div>

    {saved && (
      <div class="mt-6 rounded-2xl border border-[var(--line)] bg-white/40 p-4 text-sm">
        ✔️ Saved
      </div>
    )}

    <!-- Images -->
    <div class="mt-8 rounded-3xl border border-[var(--line)] bg-white/20 p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold">Images</h2>
          <p class="mt-1 text-xs" style="color: var(--muted);">
            Uploads go to R2 and are recorded in <span class="font-mono">service_images</span>.
          </p>
        </div>
        <div class="text-xs font-mono" style="color: var(--muted);">
          {base || "PUBLIC_R2_BASE_URL missing"}
        </div>
      </div>

      <!-- Primary -->
      <div class="mt-6">
        <h3 class="text-sm font-semibold">Primary</h3>

        <div class="mt-3 grid gap-4 md:grid-cols-[180px_1fr] md:items-start">
          {primary ? (
            <img
              src={imgUrl(primary.image_key)}
              alt={primary.alt ?? service.name}
              class="h-[180px] w-[180px] rounded-2xl border border-[var(--line)] object-cover"
              loading="lazy"
            />
          ) : (
            <div class="flex h-[180px] w-[180px] items-center justify-center rounded-2xl border border-[var(--line)] bg-white/20 text-xs" style="color: var(--muted);">
              No primary image
            </div>
          )}

          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-3">
              <input id="primaryFile" type="file" accept="image/*" class="text-sm" />
              <button id="uploadPrimary" type="button" class="rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
                Upload primary
              </button>
              {primary && (
                <button
                  id="deletePrimary"
                  type="button"
                  class="rounded-[999px] border border-red-400/40 bg-white/50 px-5 py-2 text-sm hover:bg-white/80"
                  data-image-id={primary.id}
                >
                  Delete primary
                </button>
              )}
              <span id="primaryStatus" class="text-xs" style="color: var(--muted);"></span>
            </div>

            <div class="text-xs" style="color: var(--muted);">
              <div><b>Key:</b> <span class="font-mono break-all">{primary?.image_key ?? "—"}</span></div>
              <div class="mt-1">
                Primary key in <span class="font-mono">services.primary_image_key</span> updates automatically.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Gallery -->
      <div class="mt-8">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold">Gallery</h3>
          <span class="text-xs" style="color: var(--muted);">{gallery.length} image(s)</span>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-3">
          <input id="galleryFiles" type="file" accept="image/*" multiple class="text-sm" />
          <button id="uploadGallery" type="button" class="rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
            Upload gallery
          </button>
          <span id="galleryStatus" class="text-xs" style="color: var(--muted);"></span>
        </div>

        <p class="mt-3 text-xs" style="color: var(--muted);">
          Drag thumbnails to reorder. Reorder is saved immediately.
        </p>

        <div id="galleryGrid" class="mt-4 grid grid-cols-3 gap-3 md:grid-cols-4">
          {gallery.map((img) => (
            <div
              class="group relative overflow-hidden rounded-2xl border border-[var(--line)] bg-white/20"
              draggable="true"
              data-image-id={img.id}
            >
              <img src={imgUrl(img.image_key)} alt={img.alt ?? service.name} class="aspect-square w-full object-cover" loading="lazy" />
              <button
                type="button"
                class="absolute right-2 top-2 hidden rounded-[999px] border border-red-400/40 bg-white/70 px-3 py-1 text-xs hover:bg-white group-hover:block"
                data-delete-image-id={img.id}
              >
                Delete
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Existing edit form -->
    <form method="post" action="/api/admin/services/save" class="mt-8 space-y-4">
      <input type="hidden" name="mode" value="edit" />
      <input type="hidden" name="id" value={service.id} />

      <div class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Group</span>
          <input name="service_group" value={service.service_group ?? ""} class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>

        <label class="flex items-center gap-2 text-sm" style="color: var(--muted);">
          <input type="checkbox" name="active" checked={service.active === 1} />
          Active (visible in shop)
        </label>

        <label class="flex items-center gap-2 text-sm" style="color: var(--muted);">
          <input type="checkbox" name="featured" checked={service.featured === 1} />
          Featured (show on home page)
        </label>

        <label class="flex items-center gap-2 text-sm" style="color: var(--muted);">
          <input type="checkbox" name="out_of_stock" checked={service.out_of_stock === 1} />
          Display as "Out of stock" to customers
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Stock quantity</span>
          <input
            name="stock"
            type="number"
            step="1"
            value={service.stock ?? -1}
            class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
          />
          <p class="mt-1 text-xs" style="color: var(--muted);">-1 = unlimited (services that don't deplete stock)</p>
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Bulk discount eligibility</span>
          <select name="bulk_discount_eligible" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none">
            <option value="0" selected={service.bulk_discount_eligible === 0}>0 — Not eligible</option>
            <option value="1" selected={service.bulk_discount_eligible === 1}>1 — 5+ of same group</option>
            <option value="2" selected={service.bulk_discount_eligible === 2}>2 — 5+ of same item & options</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Bulk discount % <span class="text-xs">(applied when eligible, default 5)</span></span>
          <input
            name="bulk_discount_percent"
            type="number"
            min="1"
            max="100"
            step="1"
            value={service.bulk_discount_percent ?? 5}
            class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
          />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Bulk discount min qty <span class="text-xs">(minimum items to qualify, default 5)</span></span>
          <input
            name="bulk_discount_min"
            type="number"
            min="2"
            step="1"
            value={service.bulk_discount_min ?? 5}
            class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
          />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Shop order priority <span class="text-xs">(higher shows first, default 0)</span></span>
          <input
            name="priority"
            type="number"
            step="1"
            value={service.priority ?? 0}
            class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
          />
        </label>
      </div>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Name *</span>
        <input name="name" required value={service.name} class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
      </label>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Description</span>
        <textarea name="description" rows="5" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none">{service.description ?? ""}</textarea>
      </label>

      <div class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Price (MVR)</span>
          <input name="price" inputmode="decimal" value={moneyToInput(service.price_cents)} class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Tags</span>
          <input name="tags" value={service.tags ?? ""} class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>
      </div>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Notes (internal)</span>
        <textarea name="notes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none">{service.notes ?? ""}</textarea>
      </label>

      <!-- Service options -->
      <div id="optValidationError" class="hidden rounded-2xl border border-red-400/40 bg-red-50/80 px-4 py-3 text-sm text-red-700"></div>

      <div class="block">
        <span class="text-sm" style="color: var(--muted);">Service options</span>

        <div id="serviceOptionsEditor" class="mt-3 space-y-4"></div>

        <button type="button" id="addGroupBtn" class="mt-3 rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-2 text-sm hover:bg-white/80">
          + Add option group
        </button>

        <div id="addGroupPanel" class="mt-3 hidden space-y-3 rounded-2xl border border-[var(--line)] bg-white/40 p-4">
          <label class="block">
            <span class="text-xs" style="color: var(--muted);">Copy an existing group from another service (optional)</span>
            <select id="copyGroupSelect" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-white/60 px-3 py-2 text-sm outline-none">
              <option value="">— New empty group —</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs" style="color: var(--muted);">Group name</span>
            <input id="newGroupName" type="text" placeholder="e.g. turnaround" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-white/60 px-3 py-2 text-sm outline-none" />
          </label>
          <div class="flex gap-3">
            <button type="button" id="confirmAddGroupBtn" class="rounded-[999px] bg-[var(--btn)] px-5 py-2 text-sm font-medium text-[var(--btnText)] hover:opacity-90">Add</button>
            <button type="button" id="cancelAddGroupBtn" class="rounded-[999px] border border-[var(--line)] bg-white/60 px-5 py-2 text-sm hover:bg-white/80">Cancel</button>
          </div>
        </div>

        <input type="hidden" id="f_service_options" name="service_options" />
      </div>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Primary image key (R2)</span>
        <input readonly name="primary_image_key" value={service.primary_image_key ?? ""} class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/50 px-4 py-3 text-sm outline-none" />
      </label>

      <div class="mt-8 flex flex-wrap gap-3">
        <button class="rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90" type="submit">
          Save
        </button>

        <a class="rounded-[999px] border border-[var(--line)] bg-white/60 px-6 py-3 text-sm hover:bg-white/80" href={`/shop/${service.slug}`}>
          View on site
        </a>
      </div>
    </form>

    <form method="post" action="/api/admin/services/delete" class="mt-10">
      <input type="hidden" name="id" value={service.id} />
      <button class="rounded-[999px] border border-red-400/40 bg-white/60 px-6 py-3 text-sm hover:bg-white/80" type="submit">
        Disable service
      </button>
      <p class="mt-2 text-xs" style="color: var(--muted);">
        This sets active=0 (soft delete).
      </p>
    </form>
  </section>

  <script define:vars={{ initialServiceOptions: service.service_options ?? "", serviceId: service.id }}>
    // Structured editor for service_options: renders each group as a name + options/prices
    // table, serializes back into the hidden JSON field on submit.
    (function () {
      const editor = document.getElementById("serviceOptionsEditor");
      const hiddenInput = document.getElementById("f_service_options");
      const errEl = document.getElementById("optValidationError");
      const addGroupBtn = document.getElementById("addGroupBtn");
      const addGroupPanel = document.getElementById("addGroupPanel");
      const copyGroupSelect = document.getElementById("copyGroupSelect");
      const newGroupName = document.getElementById("newGroupName");
      const confirmAddGroupBtn = document.getElementById("confirmAddGroupBtn");
      const cancelAddGroupBtn = document.getElementById("cancelAddGroupBtn");

      function escapeHtml(s) {
        return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
      }

      function rowHtml(option, price) {
        return `
          <tr class="option-row">
            <td class="py-1 pr-2">
              <input type="text" class="option-input w-full rounded-lg border border-[var(--line)] bg-white/60 px-2 py-1.5 text-sm outline-none" value="${escapeHtml(option)}" placeholder="e.g. Standard" />
            </td>
            <td class="py-1 pr-2">
              <input type="text" class="price-input w-28 rounded-lg border border-[var(--line)] bg-white/60 px-2 py-1.5 text-sm outline-none" value="${escapeHtml(price)}" placeholder="+0" />
            </td>
            <td class="py-1">
              <button type="button" class="remove-row-btn px-1 text-xs" style="color: var(--muted);">✕</button>
            </td>
          </tr>
        `;
      }

      function groupCardHtml(name, options, prices) {
        const rows = (options.length ? options : [""]).map((opt, i) => rowHtml(opt, prices[i] ?? "")).join("");
        return `
          <div class="rounded-2xl border border-[var(--line)] p-4" data-group-card>
            <div class="flex items-center justify-between gap-3">
              <input type="text" class="group-name-input flex-1 rounded-xl border border-[var(--line)] bg-white/60 px-3 py-2 text-sm font-medium outline-none" value="${escapeHtml(name)}" placeholder="group name e.g. turnaround" />
              <button type="button" class="delete-group-btn shrink-0 rounded-full border border-red-400/40 bg-white/60 px-3 py-1.5 text-xs hover:bg-white/80">Delete group</button>
            </div>
            <table class="mt-3 w-full text-left text-sm">
              <thead>
                <tr>
                  <th class="pb-1 text-xs font-normal" style="color: var(--muted);">Option</th>
                  <th class="pb-1 text-xs font-normal" style="color: var(--muted);">Price adjustment</th>
                  <th class="pb-1"></th>
                </tr>
              </thead>
              <tbody class="group-rows">${rows}</tbody>
            </table>
            <button type="button" class="add-row-btn mt-2 text-xs underline" style="color: var(--muted);">+ Add option</button>
          </div>
        `;
      }

      function addGroupCard(name, options, prices) {
        const wrap = document.createElement("div");
        wrap.innerHTML = groupCardHtml(name, options ?? [], prices ?? []).trim();
        editor.appendChild(wrap.firstElementChild);
      }

      // Initial render from the service's current service_options
      let initialGroups = [];
      try {
        const parsed = JSON.parse(initialServiceOptions || "[]");
        if (Array.isArray(parsed)) initialGroups = parsed;
      } catch { /* leave empty */ }
      initialGroups.forEach((g) => addGroupCard(g?.name ?? "", g?.options ?? [], g?.prices ?? []));

      // Event delegation for dynamically added rows/groups
      editor.addEventListener("click", (e) => {
        const delGroupBtn = e.target.closest(".delete-group-btn");
        if (delGroupBtn) {
          delGroupBtn.closest("[data-group-card]")?.remove();
          return;
        }
        const addRowBtn = e.target.closest(".add-row-btn");
        if (addRowBtn) {
          const tbody = addRowBtn.closest("[data-group-card]")?.querySelector(".group-rows");
          if (tbody) {
            const tmp = document.createElement("tbody");
            tmp.innerHTML = rowHtml("", "+0");
            tbody.appendChild(tmp.firstElementChild);
          }
          return;
        }
        const removeRowBtn = e.target.closest(".remove-row-btn");
        if (removeRowBtn) {
          removeRowBtn.closest(".option-row")?.remove();
        }
      });

      // "Add option group" panel — can copy an existing group from another service
      let fetchedGroups = null;
      async function ensureGroupsFetched() {
        if (fetchedGroups) return fetchedGroups;
        try {
          const res = await fetch(`/api/admin/services/option-groups.json?exclude=${encodeURIComponent(serviceId)}`);
          const data = await res.json().catch(() => null);
          fetchedGroups = (data?.ok && Array.isArray(data.groups)) ? data.groups : [];
        } catch {
          fetchedGroups = [];
        }

        copyGroupSelect.innerHTML = '<option value="">— New empty group —</option>' +
          fetchedGroups.map((g, i) => `<option value="${i}">${escapeHtml(g.name)} (from ${escapeHtml(g.serviceName)})</option>`).join("");

        return fetchedGroups;
      }

      addGroupBtn?.addEventListener("click", async () => {
        addGroupPanel.classList.remove("hidden");
        newGroupName.value = "";
        copyGroupSelect.value = "";
        await ensureGroupsFetched();
      });

      copyGroupSelect?.addEventListener("change", () => {
        const idx = copyGroupSelect.value;
        if (idx === "" || !fetchedGroups) return;
        const g = fetchedGroups[Number(idx)];
        if (g) newGroupName.value = g.name;
      });

      cancelAddGroupBtn?.addEventListener("click", () => {
        addGroupPanel.classList.add("hidden");
      });

      confirmAddGroupBtn?.addEventListener("click", () => {
        const idx = copyGroupSelect.value;
        const chosen = (idx !== "" && fetchedGroups) ? fetchedGroups[Number(idx)] : null;
        const name = newGroupName.value.trim() || chosen?.name || "";

        if (!name) {
          errEl.textContent = "Group name is required.";
          errEl.classList.remove("hidden");
          return;
        }

        addGroupCard(name, chosen?.options ?? [], chosen?.prices ?? []);
        addGroupPanel.classList.add("hidden");
        errEl.classList.add("hidden");
      });

      // Serialize the structured editor into the hidden JSON field; returns an error string or null
      function syncAndValidate() {
        const groups = [];
        const names = new Set();
        let error = null;

        editor.querySelectorAll("[data-group-card]").forEach((card) => {
          if (error) return;
          const name = card.querySelector(".group-name-input")?.value.trim() ?? "";
          const options = [];
          const prices = [];
          card.querySelectorAll(".option-row").forEach((row) => {
            const opt = row.querySelector(".option-input")?.value.trim() ?? "";
            if (!opt) return; // skip blank rows
            options.push(opt);
            prices.push(row.querySelector(".price-input")?.value.trim() || "+0");
          });

          if (!name && options.length === 0) return; // fully empty card, drop silently
          if (!name) { error = "Each option group needs a name."; return; }
          if (names.has(name)) { error = `Duplicate group name "${name}".`; return; }
          if (options.length === 0) { error = `Group "${name}" needs at least one option.`; return; }

          names.add(name);
          groups.push({ name, options, prices });
        });

        if (!error) hiddenInput.value = groups.length ? JSON.stringify(groups) : "";
        return error;
      }

      const form = document.querySelector('form[action="/api/admin/services/save"]');
      form?.addEventListener("submit", (e) => {
        const error = syncAndValidate();
        if (error) {
          e.preventDefault();
          errEl.textContent = error;
          errEl.classList.remove("hidden");
          errEl.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          errEl.classList.add("hidden");
        }
      });
    })();
  </script>

  <script define:vars={{ serviceId: service.id }}>
    // Client-side compression to WEBP (automatic)
    async function compressToWebp(file, { maxDim = 2000, quality = 0.82 } = {}) {
      const img = document.createElement("img");
      const url = URL.createObjectURL(file);

      try {
        await new Promise((resolve, reject) => {
          img.onload = () => resolve();
          img.onerror = reject;
          img.src = url;
        });

        const { width, height } = img;
        const scale = Math.min(1, maxDim / Math.max(width, height));
        const w = Math.round(width * scale);
        const h = Math.round(height * scale);

        const canvas = document.createElement("canvas");
        canvas.width = w;
        canvas.height = h;

        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);

        const blob = await new Promise((resolve) =>
          canvas.toBlob((b) => resolve(b), "image/webp", quality)
        );

        if (!blob) return file;
        return new File([blob], file.name.replace(/\.\w+$/, "") + ".webp", { type: "image/webp" });
      } finally {
        URL.revokeObjectURL(url);
      }
    }

    async function uploadOne(file, kind) {
      const compressed = await compressToWebp(file);
      const fd = new FormData();
      fd.append("file", compressed);
      fd.append("service_id", serviceId);
      fd.append("kind", kind);

      const res = await fetch("/api/admin/r2/upload", { method: "POST", body: fd });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(data?.error || `Upload failed (${res.status})`);
    }

    async function deleteImage(imageId) {
      const res = await fetch("/api/admin/r2/delete", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ image_id: imageId }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(data?.error || `Delete failed (${res.status})`);
    }

    async function saveReorder(orderedIds) {
      const res = await fetch("/api/admin/r2/reorder", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ service_id: serviceId, kind: "gallery", ordered_image_ids: orderedIds }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(data?.error || `Reorder failed (${res.status})`);
    }

    // Primary upload/delete
    const primaryFile = document.getElementById("primaryFile");
    const uploadPrimary = document.getElementById("uploadPrimary");
    const primaryStatus = document.getElementById("primaryStatus");
    const deletePrimary = document.getElementById("deletePrimary");

    uploadPrimary?.addEventListener("click", async () => {
      try {
        const file = primaryFile?.files?.[0];
        if (!file) return (primaryStatus.textContent = "Choose a file first.");
        primaryStatus.textContent = "Uploading…";
        await uploadOne(file, "primary");
        primaryStatus.textContent = "Done. Reloading…";
        location.reload();
      } catch (e) {
        primaryStatus.textContent = e?.message || "Upload failed.";
      }
    });

    deletePrimary?.addEventListener("click", async () => {
      const imageId = deletePrimary.getAttribute("data-image-id");
      if (!imageId) return;
      if (!confirm("Delete primary image? This removes the file from R2 and the DB.")) return;
      try {
        primaryStatus.textContent = "Deleting…";
        await deleteImage(imageId);
        primaryStatus.textContent = "Deleted. Reloading…";
        location.reload();
      } catch (e) {
        primaryStatus.textContent = e?.message || "Delete failed.";
      }
    });

    // Gallery upload
    const galleryFiles = document.getElementById("galleryFiles");
    const uploadGallery = document.getElementById("uploadGallery");
    const galleryStatus = document.getElementById("galleryStatus");

    uploadGallery?.addEventListener("click", async () => {
      try {
        const files = Array.from(galleryFiles?.files || []);
        if (!files.length) return (galleryStatus.textContent = "Choose files first.");
        galleryStatus.textContent = `Uploading ${files.length}…`;
        for (let i = 0; i < files.length; i++) {
          await uploadOne(files[i], "gallery");
          galleryStatus.textContent = `Uploaded ${i + 1}/${files.length}…`;
        }
        galleryStatus.textContent = "Done. Reloading…";
        location.reload();
      } catch (e) {
        galleryStatus.textContent = e?.message || "Upload failed.";
      }
    });

    // Gallery delete
    document.querySelectorAll("[data-delete-image-id]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-delete-image-id");
        if (!id) return;
        if (!confirm("Delete this image? This removes it from R2 and the DB.")) return;
        try {
          galleryStatus.textContent = "Deleting…";
          await deleteImage(id);
          galleryStatus.textContent = "Deleted. Reloading…";
          location.reload();
        } catch (e) {
          galleryStatus.textContent = e?.message || "Delete failed.";
        }
      });
    });

    // Drag reorder
    const grid = document.getElementById("galleryGrid");
    if (grid) {
      let dragged = null;

      grid.querySelectorAll("[draggable=true]").forEach((el) => {
        el.addEventListener("dragstart", () => {
          dragged = el;
          el.style.opacity = "0.6";
        });
        el.addEventListener("dragend", () => {
          el.style.opacity = "";
          dragged = null;
        });
        el.addEventListener("dragover", (e) => e.preventDefault());

        el.addEventListener("drop", async (e) => {
          e.preventDefault();
          if (!dragged || dragged === el) return;

          const rect = el.getBoundingClientRect();
          const before = (e.clientX - rect.left) < rect.width / 2;
          if (before) grid.insertBefore(dragged, el);
          else grid.insertBefore(dragged, el.nextSibling);

          const orderedIds = Array.from(grid.querySelectorAll("[draggable=true]"))
            .map((x) => x.getAttribute("data-image-id"))
            .filter(Boolean);

          try {
            galleryStatus.textContent = "Saving order…";
            await saveReorder(orderedIds);
            galleryStatus.textContent = "Order saved.";
          } catch (err) {
            galleryStatus.textContent = err?.message || "Failed to save order.";
          }
        });
      });
    }
  </script>
</BaseLayout>