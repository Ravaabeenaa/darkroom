---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="New Service — Admin">
  <section class="mx-auto mt-12 max-w-3xl px-6">
    <h1 class="text-4xl" style="font-family: var(--font-serif);">New service</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">
      Create a new service/product. Images will be added next.
    </p>

    <form method="post" action="/api/admin/services/save" class="mt-8 space-y-4">
      <input type="hidden" name="mode" value="new" />

      <div class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">ID (optional)</span>
          <input name="id" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="dev001 / flm001 / cam001" />
        </label>

        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Group</span>
          <input name="service_group" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="film_roll / camera / developing" />
        </label>
      </div>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Name *</span>
        <input name="name" required class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
      </label>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Description</span>
        <textarea name="description" rows="5" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"></textarea>
      </label>

      <div class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">Price (USD)</span>
          <input name="price" inputmode="decimal" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="20" />
        </label>

        <label class="flex items-center gap-2 text-sm" style="color: var(--muted);">
          <input type="checkbox" name="active" checked />
          Active (visible in shop)
        </label>
      </div>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Tags (comma-separated)</span>
        <input name="tags" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="film,35mm,colour" />
      </label>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Notes (internal)</span>
        <textarea name="notes" rows="3" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"></textarea>
      </label>

      <label class="block">
        <span class="text-sm" style="color: var(--muted);">Primary image key (optional, later)</span>
        <input name="primary_image_key" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" placeholder="services/dev001/main.jpg" />
      </label>

      <div class="mt-8 flex flex-wrap gap-3">
        <button class="rounded-[999px] bg-black px-6 py-3 text-sm font-medium text-white hover:opacity-90" type="submit">
          Create
        </button>
        <a class="rounded-[999px] border border-[var(--line)] bg-white/60 px-6 py-3 text-sm hover:bg-white/80" href="/admin/services">
          Cancel
        </a>
      </div>
    </form>
  </section>
</BaseLayout>