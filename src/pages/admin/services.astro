---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;

type ServiceRow = {
  id: string;
  slug: string;
  service_group: string | null;
  name: string;
  price_cents: number;
  active: number;
  tags: string | null;
  primary_image_key: string | null;
};

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const showInactive = Astro.url.searchParams.get("inactive") === "1";

// Whitelist of sortable columns → actual SQL column (never interpolate raw user input into ORDER BY)
const SORT_COLUMNS: Record<string, string> = {
  name: "name",
  group: "service_group",
  price: "price_cents",
  active: "active",
  id: "id",
};

const sortParam = Astro.url.searchParams.get("sort") ?? "";
const sortKey = sortParam in SORT_COLUMNS ? sortParam : "";
const sortDir = Astro.url.searchParams.get("dir") === "desc" ? "desc" : "asc";

const orderBy = sortKey
  ? `${SORT_COLUMNS[sortKey]} ${sortDir.toUpperCase()}, name ASC`
  : `active DESC, service_group ASC, name ASC`;

const sql = `
  SELECT id, slug, service_group, name, price_cents, active, tags, primary_image_key
  FROM services
  WHERE (${showInactive ? "1=1" : "active=1"})
    AND (? = '' OR name LIKE '%' || ? || '%' OR id LIKE '%' || ? || '%' OR tags LIKE '%' || ? || '%')
  ORDER BY ${orderBy};
`;

const res = await db.prepare(sql).bind(q, q, q, q).all<ServiceRow>();
const rows = res.results ?? [];

function money(cents: number) {
  return `MVR ${(cents / 100).toFixed(2)}`;
}

// Link that sorts by `col`: unsorted/other column → asc; already asc on this column → desc; already desc → asc.
function sortLink(col: string) {
  const nextDir = sortKey === col && sortDir === "asc" ? "desc" : "asc";
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("sort", col);
  params.set("dir", nextDir);
  return `?${params.toString()}`;
}
---

<BaseLayout title="Services — Admin">
  <section class="mx-auto mt-12 max-w-6xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <a href="/admin" class="text-sm hover:opacity-70" style="color: var(--muted);">← Admin</a>
        <h1 class="mt-2 text-4xl" style="font-family: var(--font-serif);">Services</h1>
        <p class="mt-2 text-sm" style="color: var(--muted);">
          Add/edit services and manage what shows in the shop.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/api/admin/services/export"
          class="rounded-[999px] border border-[var(--line)] bg-white/60 px-5 py-3 text-sm hover:bg-white/80"
        >
          Export CSV
        </a>
        <button
          id="showImportBtn"
          type="button"
          class="rounded-[999px] border border-[var(--line)] bg-white/60 px-5 py-3 text-sm hover:bg-white/80"
        >
          Import CSV
        </button>
        <a
          href="/admin/services/new"
          class="rounded-[999px] bg-[var(--btn)] px-5 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90"
        >
          + New service
        </a>
      </div>
    </div>

    <!-- Import CSV panel -->
    <div id="importPanel" class="hidden mt-8 rounded-3xl border border-[var(--line)] bg-white/40 p-6">
      <h2 class="text-lg font-semibold">Import services CSV</h2>
      <p class="mt-2 text-sm" style="color: var(--muted);">
        Match rows by <code class="font-mono">id</code>. A bare <code class="font-mono">NULL</code> cell clears the value;
        an empty cell means "no change" in Merge mode, or "blank" in Overwrite mode.
      </p>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="text-sm" style="color: var(--muted);">CSV file</span>
          <input id="importFile" type="file" accept=".csv,text/csv" class="mt-2 w-full rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none" />
        </label>

        <div>
          <span class="text-sm" style="color: var(--muted);">Mode</span>
          <div class="mt-2 flex gap-4">
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="importMode" value="merge" checked />
              Merge — add new rows, update matches, keep everything else
            </label>
          </div>
          <div class="mt-2 flex gap-4">
            <label class="flex items-center gap-2 text-sm">
              <input type="radio" name="importMode" value="overwrite" />
              Overwrite — table becomes exactly this file
            </label>
          </div>
        </div>
      </div>

      <label id="overwriteConfirmWrap" class="hidden mt-4 flex items-start gap-2 rounded-2xl border px-4 py-3 text-sm" style="border-color: color-mix(in srgb, var(--red) 40%, transparent); background: color-mix(in srgb, var(--red) 8%, transparent);">
        <input id="overwriteConfirm" type="checkbox" class="mt-0.5" />
        <span>I understand this will permanently delete any service not present in this file (and its gallery images).</span>
      </label>

      <div class="mt-5 flex gap-3">
        <button id="runImportBtn" class="rounded-[999px] bg-[var(--btn)] px-5 py-2.5 text-sm font-medium text-[var(--btnText)] hover:opacity-90">
          Run import
        </button>
        <button id="cancelImportBtn" type="button" class="rounded-[999px] border border-[var(--line)] px-5 py-2.5 text-sm hover:bg-white/70">
          Cancel
        </button>
      </div>

      <div id="importResult" class="hidden mt-5 rounded-2xl border border-[var(--line)] bg-white/60 p-4 text-sm"></div>
    </div>

    <form class="mt-8 flex flex-wrap gap-3" method="get">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="Search (name, id, tags)"
        class="w-full max-w-md rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
      />
      <label class="flex items-center gap-2 text-sm" style="color: var(--muted);">
        <input type="checkbox" name="inactive" value="1" checked={showInactive} />
        Show inactive
      </label>
      <button
        class="rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-3 text-sm hover:bg-white/80"
        type="submit"
      >
        Filter
      </button>
    </form>

    <div class="mt-8 overflow-hidden rounded-3xl border border-[var(--line)]">

      <!-- Mobile: card list -->
      <div class="md:hidden divide-y divide-[var(--line)] bg-white/40">
        {rows.length === 0 ? (
          <div class="px-5 py-10 text-sm text-center" style="color: var(--muted);">No services found.</div>
        ) : rows.map((s) => (
          <div class="flex items-center gap-3 px-4 py-4">
            <div class="flex-1 min-w-0">
              <a href={`/admin/services/${encodeURIComponent(s.slug ?? s.id)}`}
                class="font-medium hover:underline block truncate">
                {s.name}
              </a>
              <div class="mt-0.5 text-xs truncate" style="color: var(--muted);">
                {[s.service_group, money(s.price_cents), s.active ? "Active" : "Inactive"].filter(Boolean).join(" · ")}
              </div>
            </div>
            <a href={`/admin/services/${encodeURIComponent(s.slug ?? s.id)}`}
              class="shrink-0 rounded-[999px] border border-[var(--line)] bg-white/60 px-3 py-2 text-xs hover:bg-white/80">
              Edit
            </a>
          </div>
        ))}
      </div>

      <!-- Desktop: table -->
      <table class="hidden md:table w-full text-left text-sm bg-white/40">
        <thead class="bg-white/40">
          <tr>
            {[
              { key: "name", label: "Name" },
              { key: "group", label: "Group" },
              { key: "price", label: "Price" },
              { key: "active", label: "Active" },
              { key: "id", label: "ID" },
            ].map((col) => (
              <th class="px-4 py-3">
                <span class="inline-flex items-center gap-1">
                  <span>{col.label}</span>
                  <a
                    href={sortLink(col.key)}
                    class="inline-flex flex-col items-center justify-center leading-none hover:opacity-80"
                    aria-label={`Sort by ${col.label}`}
                  >
                    <span class="block text-[8px] leading-[7px]" style={`color: ${sortKey === col.key && sortDir === "asc" ? "var(--red)" : "var(--muted)"};`}>▲</span>
                    <span class="block text-[8px] leading-[7px]" style={`color: ${sortKey === col.key && sortDir === "desc" ? "var(--red)" : "var(--muted)"};`}>▼</span>
                  </a>
                </span>
              </th>
            ))}
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((s) => (
            <tr class="border-t border-[var(--line)]">
              <td class="px-4 py-3">
                <a href={`/admin/services/${encodeURIComponent(s.slug ?? s.id)}`}
                  class="font-medium hover:underline">
                  {s.name}
                </a>
                <div class="mt-1 text-xs" style="color: var(--muted);">slug: {s.slug}</div>
              </td>
              <td class="px-4 py-3">{s.service_group ?? "—"}</td>
              <td class="px-4 py-3">{money(s.price_cents)}</td>
              <td class="px-4 py-3">{s.active ? "✔️" : "❌"}</td>
              <td class="px-4 py-3 font-mono text-xs">{s.id}</td>
              <td class="px-4 py-3 text-right">
                <a
                  href={`/admin/services/${encodeURIComponent(s.slug ?? s.id)}`}
                  class="rounded-[999px] border border-[var(--line)] bg-white/60 px-3 py-2 text-xs hover:bg-white/80"
                >
                  Edit
                </a>
              </td>
            </tr>
          ))}
          {rows.length === 0 && (
            <tr>
              <td class="px-4 py-10 text-sm" colSpan="6" style="color: var(--muted);">
                No services found.
              </td>
            </tr>
          )}
        </tbody>
      </table>

    </div>
  </section>

  <script is:inline>
  (function () {
    var showBtn      = document.getElementById("showImportBtn");
    var cancelBtn    = document.getElementById("cancelImportBtn");
    var panel        = document.getElementById("importPanel");
    var fileInput    = document.getElementById("importFile");
    var modeRadios   = document.querySelectorAll('input[name="importMode"]');
    var confirmWrap  = document.getElementById("overwriteConfirmWrap");
    var confirmBox   = document.getElementById("overwriteConfirm");
    var runBtn       = document.getElementById("runImportBtn");
    var resultBox    = document.getElementById("importResult");

    showBtn && showBtn.addEventListener("click", function () {
      panel.classList.remove("hidden");
      showBtn.classList.add("hidden");
    });
    cancelBtn && cancelBtn.addEventListener("click", function () {
      panel.classList.add("hidden");
      showBtn.classList.remove("hidden");
      resultBox.classList.add("hidden");
    });

    function currentMode() {
      var checked = document.querySelector('input[name="importMode"]:checked');
      return checked ? checked.value : "merge";
    }

    modeRadios.forEach(function (r) {
      r.addEventListener("change", function () {
        var isOverwrite = currentMode() === "overwrite";
        confirmWrap.classList.toggle("hidden", !isOverwrite);
        if (!isOverwrite) confirmBox.checked = false;
      });
    });

    function showResult(html, isError) {
      resultBox.innerHTML = html;
      resultBox.style.borderColor = isError ? "color-mix(in srgb, var(--red) 40%, transparent)" : "var(--line)";
      resultBox.classList.remove("hidden");
    }

    runBtn && runBtn.addEventListener("click", async function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) { showResult("Choose a CSV file first.", true); return; }
      var mode = currentMode();
      if (mode === "overwrite" && !confirmBox.checked) {
        showResult("Please check the confirmation box before running an overwrite import.", true);
        return;
      }

      runBtn.disabled = true;
      runBtn.textContent = "Importing…";

      try {
        var csvText = await file.text();
        var res = await fetch("/api/admin/services/import", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ mode: mode, csv: csvText }),
        });
        var data = await res.json();

        if (!data.ok) {
          var errHtml = "<div class='font-medium' style='color:var(--red);'>" + (data.error || "Import failed.") + "</div>";
          if (data.errors && data.errors.length) {
            errHtml += "<ul class='mt-2 list-disc pl-5 space-y-1'>" +
              data.errors.slice(0, 30).map(function (e) { return "<li>Row " + e.row + ": " + e.message + "</li>"; }).join("") +
              "</ul>";
            if (data.errors.length > 30) errHtml += "<div class='mt-1 text-xs' style='color:var(--muted);'>+ " + (data.errors.length - 30) + " more…</div>";
          }
          showResult(errHtml, true);
        } else {
          var html = "<div class='font-medium'>Import complete (" + data.mode + ")</div>" +
            "<div class='mt-2'>Inserted: " + data.inserted + " · Updated: " + data.updated +
            (data.mode === "overwrite" ? " · Deleted: " + data.deleted : "") +
            " · Skipped: " + data.skipped + "</div>";
          if (data.unknownCols && data.unknownCols.length) {
            html += "<div class='mt-2 text-xs' style='color:var(--muted);'>Ignored unknown columns: " + data.unknownCols.join(", ") + "</div>";
          }
          if (data.errors && data.errors.length) {
            html += "<ul class='mt-2 list-disc pl-5 space-y-1' style='color:var(--red);'>" +
              data.errors.slice(0, 30).map(function (e) { return "<li>Row " + e.row + ": " + e.message + "</li>"; }).join("") +
              "</ul>";
          }
          showResult(html, false);
          if (data.inserted + data.updated + data.deleted > 0) {
            setTimeout(function () { window.location.reload(); }, 1800);
          }
        }
      } catch (e) {
        showResult("Unexpected error: " + (e && e.message ? e.message : String(e)), true);
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = "Run import";
      }
    });
  })();
  </script>
</BaseLayout>