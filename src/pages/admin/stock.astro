---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;

const q = Astro.url.searchParams.get("q")?.trim() ?? "";

type ServiceRow = {
  id: string;
  name: string;
  stock: number;
  total_stock: number;
};

const res = await db
  .prepare(`
    SELECT id, name, stock, total_stock
    FROM services
    WHERE (? = '' OR name LIKE '%' || ? || '%' OR id LIKE '%' || ? || '%')
    ORDER BY name ASC;
  `)
  .bind(q, q, q)
  .all<ServiceRow>();

const rows = res.results ?? [];
---

<BaseLayout title="Stock — Admin">
  <section class="mx-auto mt-12 max-w-4xl px-6">
    <a href="/admin" class="text-sm hover:opacity-70" style="color: var(--muted);">← Admin</a>
    <h1 class="mt-2 text-4xl" style="font-family: var(--font-serif);">Stock</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">
      Track lifetime stock received and current stock on hand. Items with stock set to "not tracked" are unaffected by order completion (e.g. scanning services).
    </p>

    <form class="mt-6 flex flex-wrap gap-3" method="get">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="Search (name or id)"
        class="w-full max-w-md rounded-2xl border border-[var(--line)] bg-white/60 px-4 py-3 text-sm outline-none"
      />
      <button class="rounded-[999px] border border-[var(--line)] bg-white/60 px-4 py-3 text-sm hover:bg-white/80" type="submit">
        Filter
      </button>
    </form>

    <div class="mt-8 overflow-x-auto rounded-3xl border border-[var(--line)]">
      <table class="w-full min-w-[560px] text-left text-sm bg-white/40">
        <thead class="bg-white/40">
          <tr>
            <th class="px-4 py-3">Service</th>
            <th class="px-4 py-3">Total received</th>
            <th class="px-4 py-3">Current stock</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr>
              <td class="px-4 py-10 text-sm" colspan="3" style="color: var(--muted);">No services found.</td>
            </tr>
          ) : rows.map((s) => (
            <tr class="border-t border-[var(--line)]" data-id={s.id}>
              <td class="px-4 py-3">
                <div class="font-medium">{s.name}</div>
                <div class="mt-0.5 font-mono text-xs" style="color: var(--muted);">{s.id}</div>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1">
                  <button class="adj-btn h-8 w-8 rounded-full border border-[var(--line)] bg-white/60 hover:bg-white/80" data-field="total_stock" data-delta="-1">−</button>
                  <input type="number" class="stock-input w-20 rounded-xl border border-[var(--line)] bg-white/60 px-2 py-1.5 text-center text-sm outline-none" data-field="total_stock" value={s.total_stock} />
                  <button class="adj-btn h-8 w-8 rounded-full border border-[var(--line)] bg-white/60 hover:bg-white/80" data-field="total_stock" data-delta="1">+</button>
                </div>
              </td>
              <td class="px-4 py-3">
                {s.stock === -1 ? (
                  <div class="flex items-center gap-2">
                    <span style="color: var(--muted);">Not tracked</span>
                    <button class="track-btn rounded-[999px] border border-[var(--line)] bg-white/60 px-3 py-1.5 text-xs hover:bg-white/80" data-action="start">
                      Start tracking
                    </button>
                  </div>
                ) : (
                  <div class="flex items-center gap-1">
                    <button class="adj-btn h-8 w-8 rounded-full border border-[var(--line)] bg-white/60 hover:bg-white/80" data-field="stock" data-delta="-1">−</button>
                    <input type="number" class="stock-input w-20 rounded-xl border border-[var(--line)] bg-white/60 px-2 py-1.5 text-center text-sm outline-none" data-field="stock" value={s.stock} />
                    <button class="adj-btn h-8 w-8 rounded-full border border-[var(--line)] bg-white/60 hover:bg-white/80" data-field="stock" data-delta="1">+</button>
                    <button class="track-btn ml-1 rounded-full border border-[var(--line)] bg-white/60 px-2 py-1.5 text-xs hover:bg-white/80" data-action="stop" title="Mark as not tracked">
                      ✕
                    </button>
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline>
  (function () {
    async function adjust(id, field, value) {
      const res = await fetch("/api/admin/stock/adjust", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ id, field, value }),
      });
      return res.json();
    }

    document.querySelectorAll("tr[data-id]").forEach(function (row) {
      const id = row.getAttribute("data-id");

      row.querySelectorAll(".adj-btn").forEach(function (btn) {
        btn.addEventListener("click", async function () {
          const field = btn.getAttribute("data-field");
          const delta = parseInt(btn.getAttribute("data-delta"), 10);
          const input = row.querySelector('.stock-input[data-field="' + field + '"]');
          const current = parseInt(input.value || "0", 10);
          const next = Math.max(0, current + delta);
          btn.disabled = true;
          const data = await adjust(id, field, next);
          if (data.ok) input.value = data.value;
          btn.disabled = false;
        });
      });

      row.querySelectorAll(".stock-input").forEach(function (input) {
        input.addEventListener("change", async function () {
          const field = input.getAttribute("data-field");
          const v = parseInt(input.value || "0", 10);
          const data = await adjust(id, field, v);
          if (data.ok) input.value = data.value;
        });
      });

      row.querySelectorAll(".track-btn").forEach(function (btn) {
        btn.addEventListener("click", async function () {
          const action = btn.getAttribute("data-action");
          btn.disabled = true;
          const data = await adjust(id, "stock", action === "start" ? 0 : -1);
          if (data.ok) window.location.reload();
          else btn.disabled = false;
        });
      });
    });
  })();
  </script>
</BaseLayout>
