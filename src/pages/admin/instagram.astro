---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const r2Base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type PostRow = {
  id: string;
  url: string;
  sort_order: number;
  created_at: string;
  account_handle: string | null;
  caption: string | null;
  photo_key: string | null;
};
const res = await db
  .prepare("SELECT id, url, sort_order, created_at, account_handle, caption, photo_key FROM instagram_posts WHERE active = 1 ORDER BY sort_order ASC")
  .all<PostRow>();
const posts = res.results ?? [];

function photoUrl(key: string | null) {
  if (!key) return null;
  return r2Base ? `${r2Base}/${key}` : `/${key}`;
}

const saved = Astro.url.searchParams.get("saved") === "1";
const errorKey = Astro.url.searchParams.get("error") ?? "";
const errorMessages: Record<string, string> = {
  missing_url: "Please enter a URL.",
  invalid_url: "URL must be an instagram.com/p/ or instagram.com/reel/ link.",
  duplicate: "That post is already in the list.",
  missing_id: "Post not found.",
  invalid_photo: "Photo must be a JPG, PNG, or WEBP file.",
  photo_too_large: "Photo must be 12MB or smaller.",
};
const errorMsg = errorMessages[errorKey] ?? (errorKey ? "An error occurred." : "");
---

<BaseLayout title="Instagram Posts — Admin">
  <section class="mx-auto mt-12 max-w-2xl px-6 pb-24">
    <div>
      <a href="/admin" class="text-sm hover:opacity-70" style="color: var(--muted);">← Admin</a>
      <h1 class="mt-2 text-4xl" style="font-family: var(--font-serif);">Instagram Posts</h1>
      <p class="mt-2 text-sm" style="color: var(--muted);">
        Manage the posts shown in the Follow Us section of the home page.
      </p>
    </div>

    {saved && (
      <div class="mt-6 rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-4 text-sm">Saved.</div>
    )}
    {errorMsg && (
      <div class="mt-6 rounded-2xl border border-red-400/40 bg-red-50/80 p-4 text-sm text-red-700">{errorMsg}</div>
    )}

    <!-- Add form -->
    <form method="post" action="/api/admin/instagram/add" class="mt-8">
      <label class="block text-sm font-medium mb-2">Add Instagram post URL</label>
      <div class="flex gap-3">
        <input
          type="url"
          name="url"
          placeholder="https://www.instagram.com/p/ABC123/"
          required
          class="flex-1 rounded-2xl border border-[var(--line)] bg-[var(--panel)] px-4 py-3 text-sm outline-none focus:border-[var(--red)]"
        />
        <button
          type="submit"
          class="rounded-[999px] bg-[var(--btn)] px-6 py-3 text-sm font-medium text-[var(--btnText)] hover:opacity-90"
        >
          Add
        </button>
      </div>
      <p class="mt-2 text-xs" style="color: var(--muted);">
        Paste the post URL only. No need to copy the embed code.
      </p>
    </form>

    <!-- Post list -->
    <div class="mt-10 space-y-3">
      {posts.length === 0 ? (
        <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-8 text-center text-sm" style="color: var(--muted);">
          No posts added yet.
        </div>
      ) : posts.map((post: PostRow, i: number) => (
        <div class="rounded-2xl border border-[var(--line)] bg-[var(--panel)]">
          <div class="flex items-center gap-4 px-5 py-4">
            <!-- Reorder -->
            <div class="flex flex-col gap-1">
              <form method="post" action="/api/admin/instagram/reorder">
                <input type="hidden" name="id" value={post.id} />
                <input type="hidden" name="direction" value="up" />
                <button type="submit" disabled={i === 0}
                  class="block rounded p-0.5 hover:bg-[var(--bg)] disabled:opacity-20"
                  aria-label="Move up">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 11V3M3 7l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </form>
              <form method="post" action="/api/admin/instagram/reorder">
                <input type="hidden" name="id" value={post.id} />
                <input type="hidden" name="direction" value="down" />
                <button type="submit" disabled={i === posts.length - 1}
                  class="block rounded p-0.5 hover:bg-[var(--bg)] disabled:opacity-20"
                  aria-label="Move down">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 3v8M3 7l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </form>
            </div>

            {photoUrl(post.photo_key) ? (
              <img src={photoUrl(post.photo_key)!} alt="" class="h-12 w-12 shrink-0 rounded-lg object-cover" />
            ) : (
              <div class="h-12 w-12 shrink-0 rounded-lg border border-dashed border-[var(--line)]" />
            )}

            <!-- URL -->
            <div class="min-w-0 flex-1">
              <a href={post.url} target="_blank" rel="noopener noreferrer"
                class="block truncate text-sm hover:underline">
                {post.url}
              </a>
              <div class="mt-0.5 truncate text-xs" style="color: var(--muted);">
                {post.account_handle ? `@${post.account_handle}` : "no account handle set"}
                {post.caption ? ` · ${post.caption}` : ""}
              </div>
            </div>

            <button
              type="button"
              class="edit-toggle-btn shrink-0 cursor-pointer rounded-xl border border-[var(--line)] px-3 py-1.5 text-xs hover:bg-[var(--bg)]"
              data-target={`editPanel-${post.id}`}
            >
              Edit
            </button>

            <!-- Delete -->
            <form method="post" action="/api/admin/instagram/delete">
              <input type="hidden" name="id" value={post.id} />
              <button type="submit"
                class="rounded-xl border border-[var(--line)] px-3 py-1.5 text-xs hover:border-red-400 hover:text-red-500"
                onclick="return confirm('Remove this post?')">
                Remove
              </button>
            </form>
          </div>

          <div id={`editPanel-${post.id}`} class="hidden border-t border-[var(--line)] px-5 py-4">
            <form method="post" action="/api/admin/instagram/update" enctype="multipart/form-data" class="grid gap-3 sm:grid-cols-2">
              <input type="hidden" name="id" value={post.id} />
              <label class="block sm:col-span-2">
                <span class="text-xs" style="color: var(--muted);">Account handle (without @)</span>
                <input
                  type="text"
                  name="account_handle"
                  value={post.account_handle ?? ""}
                  placeholder="darkroom.bysmolbo1"
                  class="mt-1 w-full rounded-xl border border-[var(--line)] bg-[var(--bg)] px-3 py-2 text-sm outline-none"
                />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-xs" style="color: var(--muted);">Caption</span>
                <textarea name="caption" rows="2" class="mt-1 w-full rounded-xl border border-[var(--line)] bg-[var(--bg)] px-3 py-2 text-sm outline-none">{post.caption ?? ""}</textarea>
              </label>
              <label class="block">
                <span class="text-xs" style="color: var(--muted);">Photo (JPG/PNG/WEBP)</span>
                <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="mt-1 w-full text-sm" />
              </label>
              {post.photo_key && (
                <label class="flex items-center gap-2 text-xs" style="color: var(--muted);">
                  <input type="checkbox" name="remove_photo" value="1" class="h-3.5 w-3.5" />
                  Remove current photo
                </label>
              )}
              <div class="sm:col-span-2">
                <button type="submit" class="rounded-[999px] bg-[var(--btn)] px-5 py-2 text-xs font-medium text-[var(--btnText)] hover:opacity-90">
                  Save details
                </button>
              </div>
            </form>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    document.querySelectorAll(".edit-toggle-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const panel = document.getElementById(btn.getAttribute("data-target"));
        panel?.classList.toggle("hidden");
      });
    });
  </script>
</BaseLayout>
