---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const env = Astro.locals.runtime.env as any;
const db = env.darkroom_db as D1Database;
const base = String(env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type PostRow = {
  id: string;
  image_key: string;
  instagram_url: string;
  caption: string | null;
  sort_order: number;
  active: number;
};

const res = await db
  .prepare(`SELECT id, image_key, instagram_url, caption, sort_order, active FROM instagram_posts ORDER BY sort_order ASC, created_at DESC`)
  .all<PostRow>();

const posts = res.results ?? [];

function imgUrl(key: string) {
  return base ? `${base}/${key}` : `/${key}`;
}
---

<BaseLayout title="Instagram Posts — Admin">
  <section class="mx-auto mt-12 max-w-5xl">
    <div class="flex items-center justify-between gap-4 border-b pb-4" style="border-color: var(--line);">
      <div>
        <h1 class="text-4xl" style="font-family: var(--font-serif);">Instagram Posts</h1>
        <p class="mt-1 text-sm" style="color: var(--muted);">
          Curate which posts appear in the Follow Us section on the home page.
        </p>
      </div>
      <a href="/admin" class="text-sm" style="color: var(--muted);">← Admin</a>
    </div>

    <!-- Existing posts -->
    {posts.length > 0 ? (
      <div class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {posts.map((p) => (
          <div class="post-card rounded-2xl border overflow-hidden" style="border-color: var(--line); background: var(--panel);">
            <div class="relative aspect-square">
              <img src={imgUrl(p.image_key)} alt={p.caption ?? ""} class="w-full h-full object-cover" />
            </div>
            <div class="p-3">
              {p.caption && (
                <p class="text-xs mb-2 line-clamp-2" style="color: var(--muted);">{p.caption}</p>
              )}
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1 text-xs" style="color: var(--muted);">
                  <span>Order:</span>
                  <input
                    type="number"
                    value={p.sort_order}
                    data-id={p.id}
                    class="sort-input w-14 rounded-lg border px-2 py-1 text-xs outline-none"
                    style="border-color: var(--line); background: var(--bg);"
                  />
                </div>
                <div class="flex gap-2">
                  <a href={p.instagram_url} target="_blank" rel="noopener noreferrer" class="text-xs underline" style="color: var(--muted);">View</a>
                  <button class="delete-btn text-xs" data-id={p.id} style="color: var(--red);">Delete</button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-3xl border p-10 text-center text-sm" style="border-color: var(--line); color: var(--muted);">
        No posts yet. Add one below.
      </div>
    )}

    <!-- Add new post -->
    <div class="mt-14 rounded-3xl border p-8" style="border-color: var(--line); background: var(--panel);">
      <h2 class="text-2xl mb-6" style="font-family: var(--font-serif);">Add a post</h2>

      <div id="msg" class="hidden mb-5 rounded-xl px-4 py-3 text-sm"></div>

      <!-- Step 1: URL input -->
      <div id="step1">
        <label for="igUrlInput" class="text-sm font-medium">Instagram post URL</label>
        <div class="mt-2 flex gap-3">
          <input
            id="igUrlInput"
            type="url"
            placeholder="https://www.instagram.com/p/..."
            class="flex-1 rounded-2xl border px-4 py-3 text-sm outline-none"
            style="border-color: var(--line); background: var(--bg);"
          />
          <button
            id="fetchBtn"
            class="shrink-0 rounded-full px-6 py-3 text-sm font-medium"
            style="background: var(--btn); color: var(--btnText);"
          >
            Fetch post
          </button>
        </div>
      </div>

      <!-- Step 2: image selection + confirm (hidden until fetch succeeds) -->
      <div id="step2" class="hidden mt-6">
        <div class="mb-5 pb-5 border-b" style="border-color: var(--line);">
          <div class="text-xs uppercase tracking-widest mb-3" style="color: var(--muted);">
            Select image to use as preview
          </div>
          <div id="imageGrid" class="grid gap-3 grid-cols-2 sm:grid-cols-3 md:grid-cols-4"></div>
          <p id="carouselNote" class="hidden mt-3 text-xs" style="color: var(--muted);">
            Multiple images found — click one to select it as the preview.
          </p>
        </div>

        <div class="grid gap-5">
          <div>
            <label for="igCaption" class="text-sm font-medium">Caption <span class="font-normal" style="color: var(--muted);">(optional)</span></label>
            <textarea
              id="igCaption"
              rows="3"
              placeholder="Caption from the post"
              class="mt-2 block w-full rounded-2xl border px-4 py-3 text-sm outline-none resize-none"
              style="border-color: var(--line); background: var(--bg);"
            ></textarea>
          </div>

          <div>
            <label for="igOrder" class="text-sm font-medium">Sort order</label>
            <p class="text-xs mt-0.5 mb-2" style="color: var(--muted);">Lower numbers appear first. Max 4 posts shown on home page.</p>
            <input
              id="igOrder"
              type="number"
              value="0"
              min="0"
              class="w-28 rounded-2xl border px-4 py-3 text-sm outline-none"
              style="border-color: var(--line); background: var(--bg);"
            />
          </div>

          <div class="flex gap-3">
            <button
              id="backBtn"
              class="rounded-full border px-6 py-3 text-sm font-medium"
              style="border-color: var(--line);"
            >
              ← Back
            </button>
            <button
              id="confirmBtn"
              class="rounded-full px-8 py-3 text-sm font-medium"
              style="background: var(--btn); color: var(--btnText);"
            >
              Add post
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ── State ──────────────────────────────────────────────────────────────────
  let fetchedImages: string[] = [];
  let selectedImageUrl: string | null = null;
  let currentPostUrl = "";

  // ── Elements ───────────────────────────────────────────────────────────────
  const step1 = document.getElementById("step1") as HTMLDivElement;
  const step2 = document.getElementById("step2") as HTMLDivElement;
  const msg = document.getElementById("msg") as HTMLDivElement;
  const igUrlInput = document.getElementById("igUrlInput") as HTMLInputElement;
  const fetchBtn = document.getElementById("fetchBtn") as HTMLButtonElement;
  const imageGrid = document.getElementById("imageGrid") as HTMLDivElement;
  const carouselNote = document.getElementById("carouselNote") as HTMLParagraphElement;
  const igCaption = document.getElementById("igCaption") as HTMLTextAreaElement;
  const igOrder = document.getElementById("igOrder") as HTMLInputElement;
  const backBtn = document.getElementById("backBtn") as HTMLButtonElement;
  const confirmBtn = document.getElementById("confirmBtn") as HTMLButtonElement;

  // ── Helpers ────────────────────────────────────────────────────────────────
  function showMsg(text: string, type: "error" | "success" | "info") {
    msg.textContent = text;
    msg.className = "mb-5 rounded-xl px-4 py-3 text-sm";
    if (type === "error") {
      msg.style.cssText = "background: color-mix(in srgb, var(--red) 15%, transparent); color: var(--red);";
    } else if (type === "success") {
      msg.style.cssText = "background: color-mix(in srgb, #22c55e 15%, transparent); color: #16a34a;";
    } else {
      msg.style.cssText = "background: var(--panel); color: var(--muted);";
    }
    msg.classList.remove("hidden");
  }

  function hideMsg() { msg.classList.add("hidden"); }

  function setSelectedImage(url: string) {
    selectedImageUrl = url;
    imageGrid.querySelectorAll<HTMLButtonElement>(".ig-img-btn").forEach(btn => {
      const isSelected = btn.dataset.src === url;
      btn.style.outline = isSelected ? "3px solid var(--red)" : "none";
      btn.style.outlineOffset = "2px";
    });
  }

  function buildImageGrid(images: string[]) {
    imageGrid.innerHTML = "";
    images.forEach((src) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "ig-img-btn relative aspect-square overflow-hidden rounded-xl";
      btn.dataset.src = src;
      btn.style.cssText = "border: none; padding: 0; cursor: pointer;";

      const img = document.createElement("img");
      img.src = src;
      img.alt = "";
      img.style.cssText = "width: 100%; height: 100%; object-fit: cover; display: block;";
      btn.appendChild(img);

      btn.addEventListener("click", () => setSelectedImage(src));
      imageGrid.appendChild(btn);
    });

    if (images.length > 0) setSelectedImage(images[0]);
    carouselNote.classList.toggle("hidden", images.length <= 1);
  }

  // ── Step 1: Fetch post ─────────────────────────────────────────────────────
  fetchBtn.addEventListener("click", async () => {
    const url = igUrlInput.value.trim();
    if (!url) { showMsg("Please enter an Instagram post URL.", "error"); return; }

    hideMsg();
    fetchBtn.disabled = true;
    fetchBtn.textContent = "Fetching…";

    try {
      const res = await fetch(`/api/admin/instagram/fetch?url=${encodeURIComponent(url)}`);
      const data = await res.json() as any;

      if (!data.ok) {
        showMsg(data.error ?? "Failed to fetch post.", "error");
        return;
      }

      fetchedImages = data.images as string[];
      currentPostUrl = url;

      // Pre-fill caption
      igCaption.value = data.caption ?? "";

      // Show step 2
      buildImageGrid(fetchedImages);
      step1.classList.add("hidden");
      step2.classList.remove("hidden");
      hideMsg();
    } catch (e: any) {
      showMsg(e?.message ?? "Network error.", "error");
    } finally {
      fetchBtn.disabled = false;
      fetchBtn.textContent = "Fetch post";
    }
  });

  // Allow pressing Enter in the URL input
  igUrlInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") { e.preventDefault(); fetchBtn.click(); }
  });

  // ── Back button ────────────────────────────────────────────────────────────
  backBtn.addEventListener("click", () => {
    step2.classList.add("hidden");
    step1.classList.remove("hidden");
    hideMsg();
    selectedImageUrl = null;
  });

  // ── Step 2: Confirm ────────────────────────────────────────────────────────
  confirmBtn.addEventListener("click", async () => {
    if (!selectedImageUrl) { showMsg("Please select an image.", "error"); return; }

    hideMsg();
    confirmBtn.disabled = true;
    confirmBtn.textContent = "Downloading image…";

    // Download from Instagram CDN → upload to R2
    const dlRes = await fetch("/api/admin/instagram/download", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ src_url: selectedImageUrl }),
    });
    const dlData = await dlRes.json() as any;

    if (!dlData.ok) {
      showMsg(dlData.error ?? "Image download failed.", "error");
      confirmBtn.disabled = false;
      confirmBtn.textContent = "Add post";
      return;
    }

    confirmBtn.textContent = "Saving…";

    const caption = igCaption.value.trim() || null;
    const sortOrder = parseInt(igOrder.value, 10) || 0;

    const saveRes = await fetch("/api/admin/instagram/save", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        image_key: dlData.image_key,
        instagram_url: currentPostUrl,
        caption,
        sort_order: sortOrder,
      }),
    });
    const saveData = await saveRes.json() as any;

    if (!saveData.ok) {
      showMsg(saveData.error ?? "Save failed.", "error");
      confirmBtn.disabled = false;
      confirmBtn.textContent = "Add post";
      return;
    }

    showMsg("Post added! Reloading…", "success");
    setTimeout(() => location.reload(), 800);
  });

  // ── Existing posts: delete + sort order ───────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.id;
      if (!id || !confirm("Delete this post?")) return;
      btn.disabled = true;
      btn.textContent = "Deleting…";
      const res = await fetch("/api/admin/instagram/delete", {
        method: "DELETE",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ id }),
      });
      const data = await res.json() as any;
      if (data.ok) {
        btn.closest(".post-card")?.remove();
      } else {
        alert(data.error ?? "Delete failed.");
        btn.disabled = false;
        btn.textContent = "Delete";
      }
    });
  });

  document.querySelectorAll<HTMLInputElement>(".sort-input").forEach((input) => {
    input.addEventListener("change", async () => {
      const id = input.dataset.id;
      if (!id) return;
      await fetch("/api/admin/instagram/save", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ id, sort_order: parseInt(input.value, 10) || 0 }),
      });
    });
  });
</script>
