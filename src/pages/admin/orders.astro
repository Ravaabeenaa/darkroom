---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;

type OrderRow = {
  id: string;
  order_ref: string;
  customer_name: string;
  customer_phone: string;
  contact_method: string | null;
  total_price_cents: number;
  status: string;
  created_at: string | null;
};

const res = await db.prepare(`
  SELECT id, order_ref, customer_name, customer_phone, contact_method, total_price_cents, status, created_at
  FROM orders
  ORDER BY created_at DESC
  LIMIT 200;
`).all<OrderRow>();

const orders = res.results ?? [];

const statusColour: Record<string, string> = {
  NEW:         "bg-blue-100 text-blue-800",
  IN_PROGRESS: "bg-yellow-100 text-yellow-800",
  READY:       "bg-green-100 text-green-800",
  COMPLETED:   "bg-gray-100 text-gray-600",
  CANCELLED:   "bg-red-100 text-red-700",
};
---

<BaseLayout title="Orders — Admin">
  <section class="mx-auto mt-12 max-w-6xl px-6">
    <a href="/admin" class="text-sm hover:opacity-70" style="color: var(--muted);">← Admin</a>
    <h1 class="mt-2 text-4xl" style="font-family: var(--font-serif);">Orders</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">
      Latest orders from checkout.
    </p>

    <!-- ── Filters ────────────────────────────────────────────── -->
    <div class="mt-6 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-4">
      <div class="flex flex-wrap gap-3">
        <!-- Order ID -->
        <input
          id="fOrderId"
          type="search"
          placeholder="Order ID…"
          class="h-9 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 text-sm outline-none w-36"
        />

        <!-- Name -->
        <input
          id="fName"
          type="search"
          placeholder="Name…"
          class="h-9 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 text-sm outline-none w-36"
        />

        <!-- Phone -->
        <input
          id="fPhone"
          type="search"
          placeholder="Phone…"
          class="h-9 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 text-sm outline-none w-32"
        />

        <!-- Order date -->
        <input
          id="fDate"
          type="date"
          class="h-9 rounded-xl border border-[var(--line)] bg-[var(--input-bg)] px-3 text-sm outline-none"
          title="Order date"
        />

        <!-- Status toggles -->
        <div class="flex flex-wrap items-center gap-1.5" id="statusFilters">
          {(["NEW","IN_PROGRESS","READY","COMPLETED","CANCELLED"]).map((s) => (
            <label class="flex cursor-pointer items-center gap-1.5 rounded-xl border border-[var(--line)] px-3 py-1.5 text-xs select-none hover:bg-[var(--panel2)]">
              <input
                type="checkbox"
                class="status-cb accent-[#ED1C24]"
                value={s}
                checked={s !== "COMPLETED" && s !== "CANCELLED"}
              />
              <span class={`rounded-full px-2 py-0.5 font-medium ${statusColour[s] ?? "bg-gray-100 text-gray-600"}`}>{s}</span>
            </label>
          ))}
        </div>

        <button id="fReset" class="cursor-pointer rounded-xl border border-[var(--line)] px-3 py-1.5 text-xs hover:bg-[var(--panel2)]">
          Reset
        </button>

        <!-- Match count -->
        <span id="fCount" class="ml-auto self-center text-xs" style="color:var(--muted);"></span>
      </div>
    </div>

    <!-- ── Table ──────────────────────────────────────────────── -->
    <div class="mt-4 overflow-x-auto rounded-3xl border border-[var(--line)] bg-white/20">
      <table class="min-w-full text-sm" id="ordersTable">
        <thead>
          <tr class="border-b border-[var(--line)] text-left">
            <th class="px-4 py-3">Order</th>
            <th class="px-4 py-3">Customer</th>
            <th class="px-4 py-3">Contact</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {orders.map((o) => {
            const dateStr = o.created_at ? o.created_at.slice(0, 10) : "";
            return (
              <tr
                class="order-row border-b border-[var(--line)] hover:bg-white/20 cursor-pointer"
                onclick={`location.href='/admin/orders/${o.id}'`}
                data-ref={o.order_ref.toLowerCase()}
                data-customer={o.customer_name.toLowerCase()}
                data-phone={o.customer_phone}
                data-status={o.status}
                data-date={dateStr}
              >
                <td class="px-4 py-3 font-mono">
                  <a href={`/admin/orders/${o.id}`} class="hover:underline">{o.order_ref}</a>
                </td>
                <td class="px-4 py-3">
                  <div class="font-medium">{o.customer_name}</div>
                  <div class="text-xs" style="color: var(--muted);">{o.customer_phone}</div>
                </td>
                <td class="px-4 py-3">{o.contact_method ?? "—"}</td>
                <td class="px-4 py-3" data-total-cents={o.total_price_cents}></td>
                <td class="px-4 py-3">
                  <span class={`rounded-full px-3 py-1 text-xs font-medium ${statusColour[o.status] ?? "bg-gray-100 text-gray-600"}`}>{o.status}</span>
                </td>
                <td class="px-4 py-3" onclick="event.stopPropagation()">
                  <div class="flex items-center gap-2">
                    <a href={`/admin/orders/${o.id}`} class="rounded-[999px] border border-[var(--line)] bg-white/20 px-4 py-2 text-xs hover:bg-white/40">
                      View
                    </a>
                    <button
                      class="dr-invoice-btn cursor-pointer rounded-[999px] bg-[var(--btn)] px-4 py-2 text-xs text-[var(--btnText)] hover:opacity-90"
                      data-order-id={o.id}
                      data-order-ref={o.order_ref}
                      data-format="png"
                    >
                      PNG ↓
                    </button>
                    <button
                      class="dr-invoice-btn cursor-pointer rounded-[999px] border border-[var(--line)] bg-white/10 px-4 py-2 text-xs hover:bg-white/20"
                      data-order-id={o.id}
                      data-order-ref={o.order_ref}
                      data-format="pdf"
                    >
                      PDF ↓
                    </button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div id="noResults" class="mt-4 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6 text-sm" style="color:var(--muted);display:none;">
      No orders match the current filters.
    </div>

    {orders.length === 0 && (
      <div class="mt-4 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-6 text-sm" style="color: var(--muted);">
        No orders yet.
      </div>
    )}
  </section>

  <script is:inline src="/invoice-draw.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script is:inline>
    // ── Format totals ────────────────────────────────────────────
    document.querySelectorAll("[data-total-cents]").forEach((td) => {
      const cents = Number(td.getAttribute("data-total-cents") || "0");
      td.textContent = window.DarkroomCart?.formatMVR(cents) ?? `MVR ${(cents/100).toFixed(2)}`;
    });

    // ── Filters ──────────────────────────────────────────────────
    const fOrderId = document.getElementById("fOrderId");
    const fName    = document.getElementById("fName");
    const fPhone   = document.getElementById("fPhone");
    const fDate    = document.getElementById("fDate");
    const fReset   = document.getElementById("fReset");
    const fCount   = document.getElementById("fCount");
    const noResults = document.getElementById("noResults");
    const rows     = document.querySelectorAll(".order-row");

    function activeStatuses() {
      return new Set(
        Array.from(document.querySelectorAll(".status-cb:checked")).map(el => el.value)
      );
    }

    function applyFilters() {
      const qRef     = (fOrderId.value || "").toLowerCase().trim();
      const qName    = (fName.value || "").toLowerCase().trim();
      const qPhone   = (fPhone.value || "").trim();
      const qDate    = fDate.value;
      const statuses = activeStatuses();
      let visible    = 0;

      rows.forEach((row) => {
        const ref      = row.getAttribute("data-ref")      || "";
        const customer = row.getAttribute("data-customer") || "";
        const phone    = row.getAttribute("data-phone")    || "";
        const status   = row.getAttribute("data-status")   || "";
        const date     = row.getAttribute("data-date")     || "";

        const matchRef    = !qRef   || ref.includes(qRef);
        const matchName   = !qName  || customer.includes(qName);
        const matchPhone  = !qPhone || phone.includes(qPhone);
        const matchDate   = !qDate  || date === qDate;
        const matchStatus = statuses.has(status);

        const show = matchRef && matchName && matchPhone && matchDate && matchStatus;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });

      fCount.textContent = `${visible} order${visible !== 1 ? "s" : ""}`;
      noResults.style.display = visible === 0 && rows.length > 0 ? "block" : "none";
    }

    fOrderId.addEventListener("input", applyFilters);
    fName.addEventListener("input", applyFilters);
    fPhone.addEventListener("input", applyFilters);
    fDate.addEventListener("change", applyFilters);
    document.querySelectorAll(".status-cb").forEach(cb => cb.addEventListener("change", applyFilters));

    fReset.addEventListener("click", () => {
      fOrderId.value = "";
      fName.value    = "";
      fPhone.value   = "";
      fDate.value    = "";
      document.querySelectorAll(".status-cb").forEach(cb => {
        cb.checked = cb.value !== "COMPLETED" && cb.value !== "CANCELLED";
      });
      applyFilters();
    });

    // Run on load
    applyFilters();

    // ── Invoice download ─────────────────────────────────────────
    document.querySelectorAll(".dr-invoice-btn").forEach((btn) => {
      btn.addEventListener("click", async function () {
        const orderId  = this.getAttribute("data-order-id");
        const orderRef = this.getAttribute("data-order-ref");
        const format   = this.getAttribute("data-format") || "png";
        const orig = this.textContent;
        this.textContent = "…";
        this.disabled = true;

        try {
          const res  = await fetch(`/api/admin/orders/invoice-data?id=${encodeURIComponent(orderId)}`);
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || "Failed");

          const png = await window.darkroomDrawInvoice(data.order, data.items);

          if (format === "pdf") {
            const img = new Image();
            img.src = png;
            await new Promise((r) => { img.onload = r; });
            const ptW = img.naturalWidth  / 2 * 72 / 96;
            const ptH = img.naturalHeight / 2 * 72 / 96;
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF({ unit: "pt", format: [ptW, ptH] });
            pdf.addImage(png, "PNG", 0, 0, ptW, ptH);
            pdf.save(`${orderRef}.pdf`);
          } else {
            const a   = document.createElement("a");
            a.href     = png;
            a.download = `${orderRef}.png`;
            a.click();
          }
        } catch (e) {
          alert("Invoice failed: " + e.message);
        } finally {
          this.textContent = orig;
          this.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>