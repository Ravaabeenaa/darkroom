---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;

type OrderRow = {
  id: string;
  order_ref: string;
  customer_name: string;
  customer_phone: string;
  contact_method: string | null;
  total_price_cents: number;
  status: string;
  created_at: string | null;
};

const res = await db.prepare(`
  SELECT id, order_ref, customer_name, customer_phone, contact_method, total_price_cents, status, created_at
  FROM orders
  ORDER BY created_at DESC
  LIMIT 200;
`).all<OrderRow>();

const orders = res.results ?? [];
---

<BaseLayout title="Orders — Admin">
  <section class="mx-auto mt-12 max-w-6xl px-6">
    <h1 class="text-4xl" style="font-family: var(--font-serif);">Orders</h1>
    <p class="mt-2 text-sm" style="color: var(--muted);">
      Latest orders from checkout.
    </p>

    <div class="mt-8 overflow-x-auto rounded-3xl border border-[var(--line)] bg-white/20">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--line)] text-left">
            <th class="px-4 py-3">Order</th>
            <th class="px-4 py-3">Customer</th>
            <th class="px-4 py-3">Contact</th>
            <th class="px-4 py-3">Total</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {orders.map((o) => (
            <tr class="border-b border-[var(--line)]">
              <td class="px-4 py-3 font-mono">{o.order_ref}</td>
              <td class="px-4 py-3">
                <div class="font-medium">{o.customer_name}</div>
                <div class="text-xs" style="color: var(--muted);">{o.customer_phone}</div>
              </td>
              <td class="px-4 py-3">{o.contact_method ?? "—"}</td>
              <td class="px-4 py-3" data-total-cents={o.total_price_cents}></td>
              <td class="px-4 py-3">
                <select class="rounded-xl border border-[var(--line)] bg-white/60 px-3 py-2 text-sm outline-none" data-status={o.id}>
                  <option value="NEW" selected={o.status === "NEW"}>NEW</option>
                  <option value="IN_PROGRESS" selected={o.status === "IN_PROGRESS"}>IN_PROGRESS</option>
                  <option value="READY" selected={o.status === "READY"}>READY</option>
                  <option value="COMPLETED" selected={o.status === "COMPLETED"}>COMPLETED</option>
                  <option value="CANCELLED" selected={o.status === "CANCELLED"}>CANCELLED</option>
                </select>
              </td>
              <td class="px-4 py-3">
                <button class="rounded-[999px] bg-black px-4 py-2 text-xs text-white hover:opacity-90" data-save={o.id}>
                  Save
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {orders.length === 0 && (
      <div class="mt-8 rounded-3xl border border-[var(--line)] bg-white/20 p-6 text-sm" style="color: var(--muted);">
        No orders yet.
      </div>
    )}
  </section>

  <script is:inline>
    // totals in MVR
    document.querySelectorAll("[data-total-cents]").forEach((td) => {
      const cents = Number(td.getAttribute("data-total-cents") || "0");
      td.textContent = window.DarkroomCart?.formatMVR(cents) ?? `MVR ${(cents/100).toFixed(2)}`;
    });

    document.querySelectorAll("[data-save]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const orderId = btn.getAttribute("data-save");
        const sel = document.querySelector(`[data-status="${orderId}"]`);
        const status = sel?.value;

        btn.textContent = "Saving…";
        const res = await fetch("/api/admin/orders/update-status", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ order_id: orderId, status }),
        });
        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.ok) {
          btn.textContent = "Error";
          window.DarkroomCart?.toast(data?.error || "Failed");
          setTimeout(() => (btn.textContent = "Save"), 1000);
          return;
        }

        btn.textContent = "Saved";
        window.DarkroomCart?.toast("Status updated");
        setTimeout(() => (btn.textContent = "Save"), 1000);
      });
    });
  </script>
</BaseLayout>