---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="Services — DARKROOM">
  <!-- Hero -->
  <section class="pt-10 md:pt-16">
    <h1 class="text-[52px] leading-[0.88] tracking-wide sm:text-[72px] md:text-[96px]">
      Our Services
    </h1>
    <p class="mt-6 max-w-2xl text-sm leading-7 md:text-base" style="color: var(--muted);">
      We sell cameras and film, develop and scan your rolls, colour grade your scans, and rent
      out cameras and other photography equipment — everything you need, start to finish.
    </p>
  </section>

  <!-- How it works -->
  <section class="mt-24 md:mt-32">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">How it works</h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {[
        { n: "01", title: "Order online", body: "Add your services to the cart and submit your order. You'll receive a confirmation invoice." },
        { n: "02", title: "Drop off your film", body: "We'll contact you on your preferred messaging app to arrange a convenient drop-off time." },
        { n: "03", title: "Pick up your scans", body: "Once processed, we'll notify you. Your digital scans will be delivered or ready for collection." },
      ].map(step => (
        <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-8">
          <div class="font-mono text-4xl" style="color: var(--red);">{step.n}</div>
          <div class="mt-4 text-lg font-semibold">{step.title}</div>
          <p class="mt-2 text-sm leading-6" style="color: var(--muted);">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-24 mb-10 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-10 md:p-16 text-center">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">Ready to shoot?</h2>
    <p class="mt-4 text-sm" style="color: var(--muted);">Browse the full service menu and add rolls to your cart.</p>
    <div class="mt-8 flex justify-center gap-4 flex-wrap">
      <a
        href="/shop"
        class="inline-flex items-center justify-center rounded-[999px] bg-[var(--btn)] px-10 py-3 text-base font-medium text-[var(--btnText)] hover:opacity-90"
      >
        Shop services
      </a>
      <a
        href="/about#contact"
        class="inline-flex items-center justify-center rounded-[999px] border border-[var(--line)] px-10 py-3 text-base font-medium hover:bg-[var(--panel)]"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
