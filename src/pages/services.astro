---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="Services — DARKROOM">
  <!-- Hero -->
  <section class="pt-10 md:pt-16">
    <h1 class="text-[52px] leading-[0.88] tracking-wide sm:text-[72px] md:text-[96px]">
      Our Services
    </h1>
    <p class="mt-6 max-w-xl text-sm leading-6 md:text-base" style="color: var(--muted);">
      Everything you need for analogue photography. From the camera in your hands to
      the finished scan on your screen.
    </p>
  </section>

  <!-- Service descriptions -->
  <section class="mt-16 md:mt-24 space-y-14">

    <!-- Camera -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-wide">Camera</h2>
      <p class="mt-3 text-sm leading-7" style="color: var(--muted);">
        We offer a wide variety of film cameras to suit every kind of shooter. Point-and-shoots
        for quick, effortless moments. SLRs for those who want full manual control over
        every shot. Even disposables for easy, carefree memories. Cameras can also be rented
        if you want to try before you commit.
      </p>
      <details class="mt-4 group">
        <summary class="inline-flex cursor-pointer items-center gap-1.5 py-2 text-sm font-medium summary-no-marker" style="color: var(--red);">
          <span class="group-open:hidden">Learn more</span>
          <span class="hidden group-open:inline">Show less</span>
          <svg class="group-open:rotate-180 transition-transform" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="mt-4 space-y-4 text-sm leading-7 border-l-2 pl-5" style="color: var(--muted); border-color: var(--line);">
          <p>
            <strong style="color: var(--text);">Point-and-shoot.</strong> Compact, automatic cameras that handle focus and exposure for you.
            Perfect for beginners or anyone who wants to shoot without thinking too much about settings.
            Great for street photography, travel, and everyday life.
          </p>
          <p>
            <strong style="color: var(--text);">SLR.</strong> Single-lens reflex cameras with interchangeable lenses and full manual control
            over aperture, shutter speed, and focus. The choice for photographers who want to
            compose carefully and grow their technical skills. A wide range of lenses opens up
            portrait, wide-angle, and macro possibilities.
          </p>
          <p>
            <strong style="color: var(--text);">Disposable.</strong> Pre-loaded, single-use cameras that you shoot and hand straight back to us
            for developing. Zero setup, zero fuss. Ideal for events, holidays, or giving to a
            friend who has never shot film before.
          </p>
          <p>
            <strong style="color: var(--text);">Rental.</strong> Not ready to buy? You can rent a camera and try out different bodies before
            deciding what suits your style. Great for one-off shoots or experimenting with a
            format you have been curious about.
          </p>
        </div>
      </details>
    </div>

    <div class="h-px" style="background: var(--line);"></div>

    <!-- Film -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-wide">Film</h2>
      <p class="mt-3 text-sm leading-7" style="color: var(--muted);">
        The essence of analogue photography. We carry the classics such as Kodak Gold 200,
        professional emulsions such as Kodak Portra 400, and experimental stocks such as
        Lomography Redscale. Black and white film is also available across different ISOs
        to suit any lighting condition.
      </p>
      <details class="mt-4 group">
        <summary class="inline-flex cursor-pointer items-center gap-1.5 py-2 text-sm font-medium summary-no-marker" style="color: var(--red);">
          <span class="group-open:hidden">Learn more</span>
          <span class="hidden group-open:inline">Show less</span>
          <svg class="group-open:rotate-180 transition-transform" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="mt-4 space-y-4 text-sm leading-7 border-l-2 pl-5" style="color: var(--muted); border-color: var(--line);">
          <p>
            <strong style="color: var(--text);">Color negative (C-41).</strong> The most popular and forgiving film type. Tolerates
            over-exposure well and produces warm, natural tones. Kodak Gold 200 is a great
            everyday starter. Portra 400 is the professional standard for portraits and
            mixed lighting. Fuji Superia and Ultramax 400 offer a cooler, punchier look.
          </p>
          <p>
            <strong style="color: var(--text);">Black &amp; white.</strong> Timeless and versatile. ISO 100-200 stocks like Ilford Delta 100
            give ultra-fine grain for bright conditions. ISO 400 stocks like HP5 are the
            all-rounders. They push well in low light and suit almost any subject.
          </p>
          <p>
            <strong style="color: var(--text);">Experimental.</strong> For creative results. Lomography Redscale exposes the film from the
            wrong side, shifting everything towards red and orange. Cross-processed slide film
            produces unexpected contrast and color shifts. These stocks reward experimentation
            and are a lot of fun.
          </p>
          <p>
            <strong style="color: var(--text);">ISO guide.</strong> ISO 100-200 for bright sunshine or studio setups. ISO 400 for the most
            versatile all-day shooting. ISO 800 and above for low light, indoor, or concert
            photography where you need every bit of sensitivity.
          </p>
        </div>
      </details>
    </div>

    <div class="h-px" style="background: var(--line);"></div>

    <!-- Developing -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-wide">Developing</h2>
      <p class="mt-3 text-sm leading-7" style="color: var(--muted);">
        We develop C-41 color negative and black and white film in-house, with consistent
        chemistry and careful handling of every roll. Push and pull processing is available
        for films shot at non-rated ISOs, ideal when you have been pushing HP5 to 1600 or
        shooting Portra 400 in bright sun at box speed.
      </p>
    </div>

    <div class="h-px" style="background: var(--line);"></div>

    <!-- Scanning -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-wide">Scanning</h2>
      <p class="mt-3 text-sm leading-7" style="color: var(--muted);">
        Every developed roll is scanned to high-resolution digital files, delivered and ready
        for sharing or printing. We scan to a flat profile so your images retain maximum detail
        and give you full control when editing. Higher-resolution scans are available for
        frames you want to print large.
      </p>
    </div>

    <div class="h-px" style="background: var(--line);"></div>

    <!-- Color Grading -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-wide">Color Grading</h2>
      <p class="mt-3 text-sm leading-7" style="color: var(--muted);">
        We apply a tailored grade to your scans to bring out the character of each film stock:
        punchy colors, lifted shadows, or a vintage tone that suits the mood of your shoot.
        Custom grading is available on request if you have a specific look in mind.
      </p>
    </div>

  </section>

  <!-- How it works -->
  <section class="mt-24 md:mt-32">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">How it works</h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {[
        { n: "01", title: "Order online", body: "Add your services to the cart and submit your order. You'll receive a confirmation invoice." },
        { n: "02", title: "Drop off your film", body: "We'll contact you on your preferred messaging app to arrange a convenient drop-off time." },
        { n: "03", title: "Pick up your scans", body: "Once processed, we'll notify you. Your digital scans will be delivered or ready for collection." },
      ].map(step => (
        <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-5 md:p-8">
          <div class="font-mono text-4xl" style="color: var(--red);">{step.n}</div>
          <div class="mt-4 text-lg font-semibold">{step.title}</div>
          <p class="mt-2 text-sm leading-6" style="color: var(--muted);">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-24 mb-10 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-10 md:p-16 text-center">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">Ready to shoot?</h2>
    <p class="mt-4 text-sm" style="color: var(--muted);">Browse the full service menu and add rolls to your cart.</p>
    <div class="mt-8 flex justify-center gap-4 flex-wrap">
      <a
        href="/shop"
        class="inline-flex items-center justify-center rounded-[999px] bg-[var(--btn)] px-10 py-3 text-base font-medium text-[var(--btnText)] hover:opacity-90"
      >
        Shop services
      </a>
      <a
        href="/about#contact"
        class="inline-flex items-center justify-center rounded-[999px] border border-[var(--line)] px-10 py-3 text-base font-medium hover:bg-[var(--panel)]"
      >
        Contact us
      </a>
    </div>
  </section>

  <style>
    .summary-no-marker { list-style: none; }
    .summary-no-marker::-webkit-details-marker { display: none; }
  </style>
</BaseLayout>
