---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;

type ServiceRow = {
  id: string;
  slug: string | null;
  service_group: string | null;
  name: string;
  description: string | null;
  price_cents: number;
  notes: string | null;
};

const res = await db.prepare(`
  SELECT id, slug, service_group, name, description, price_cents, notes
  FROM services
  WHERE active = 1
  ORDER BY service_group ASC, name ASC;
`).all<ServiceRow>();

const rows = res.results ?? [];

// Group by service_group
const groups = new Map<string, ServiceRow[]>();
for (const row of rows) {
  const g = row.service_group ?? "General";
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g)!.push(row);
}

function money(cents: number) {
  return `MVR ${(cents / 100).toFixed(2)}`;
}
---

<BaseLayout title="Services — DARKROOM">
  <!-- Hero -->
  <section class="pt-10 md:pt-16">
    <h1 class="text-[52px] leading-[0.88] tracking-wide sm:text-[72px] md:text-[96px]">
      Our Services
    </h1>
    <p class="mt-6 max-w-xl text-sm leading-6 md:text-base" style="color: var(--muted);">
      Professional film developing, scanning, and printing. Drop off your rolls and we'll
      handle the rest - every frame treated with care.
    </p>
  </section>

  <!-- Pricing table -->
  <section class="mt-16 md:mt-24">
    {rows.length === 0 ? (
      <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-10 text-center">
        <p class="text-sm" style="color: var(--muted);">Service menu coming soon.</p>
      </div>
    ) : (
      <div class="space-y-10">
        {[...groups.entries()].map(([group, items]) => (
          <div>
            <div class="mb-4 flex items-center gap-4">
              <div class="h-px flex-1" style="background: var(--line);"></div>
              <span class="text-xs tracking-[0.2em] uppercase" style="color: var(--muted);">{group}</span>
              <div class="h-px flex-1" style="background: var(--line);"></div>
            </div>

            <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] overflow-hidden">
              {items.map((svc, i) => (
                <div class={`flex items-start justify-between gap-6 px-6 py-5 ${i > 0 ? "border-t border-[var(--line)]" : ""}`}>
                  <div class="min-w-0">
                    <div class="font-medium">{svc.name}</div>
                    {svc.description && (
                      <div class="mt-1 text-sm leading-5" style="color: var(--muted);">{svc.description}</div>
                    )}
                  </div>
                  <div class="shrink-0 text-right">
                    <div class="font-mono font-semibold">{money(svc.price_cents)}</div>
                    <a
                      href={`/shop/${svc.slug ?? svc.id}`}
                      class="mt-2 block text-xs underline hover:opacity-70"
                      style="color: var(--muted);"
                    >
                      Add to cart →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- How it works -->
  <section class="mt-24 md:mt-32">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">How it works</h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {[
        { n: "01", title: "Order online", body: "Add your services to the cart and submit your order. You'll receive a confirmation invoice." },
        { n: "02", title: "Drop off your film", body: "We'll contact you on your preferred messaging app to arrange a convenient drop-off time." },
        { n: "03", title: "Pick up your scans", body: "Once processed, we'll notify you. Your digital scans will be delivered or ready for collection." },
      ].map(step => (
        <div class="rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-8">
          <div class="font-mono text-4xl" style="color: var(--red);">{step.n}</div>
          <div class="mt-4 text-lg font-semibold">{step.title}</div>
          <p class="mt-2 text-sm leading-6" style="color: var(--muted);">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-24 mb-10 rounded-3xl border border-[var(--line)] bg-[var(--panel)] p-10 md:p-16 text-center">
    <h2 class="text-4xl md:text-5xl leading-[0.95] tracking-wide">Ready to shoot?</h2>
    <p class="mt-4 text-sm" style="color: var(--muted);">Browse the full service menu and add rolls to your cart.</p>
    <div class="mt-8 flex justify-center gap-4 flex-wrap">
      <a
        href="/shop"
        class="inline-flex items-center justify-center rounded-[999px] bg-[var(--btn)] px-10 py-3 text-base font-medium text-[var(--btnText)] hover:opacity-90"
      >
        Shop services
      </a>
      <a
        href="/about#contact"
        class="inline-flex items-center justify-center rounded-[999px] border border-[var(--line)] px-10 py-3 text-base font-medium hover:bg-[var(--panel)]"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
