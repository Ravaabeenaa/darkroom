---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact } from "../lib/contact";

export const prerender = false;

const r2Base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");
---
<BaseLayout title="About - DARKROOM">

  <section class="mt-10 md:mt-16">
    <h1 class="text-5xl md:text-6xl">Who we are</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-16 items-start">
      <div class="space-y-5 text-sm leading-7" style="color: var(--muted);">
        <p>
          Film photography in the Maldives has been difficult to keep up with for too long.
          With no easy local option for developing and scanning, rolls often had to be sent
          overseas, making the whole process slow, expensive, and uncertain.
        </p>
        <p>
          This service was started to help change that. It's a small, self-run film developing
          and scanning service, and currently the only one of its kind in the Maldives. Every
          roll is handled carefully, whether it's someone's first film, old family memories,
          travel photos, or personal work. The goal is simple: to make film accessible here
          again, and to give people a local option they can trust.
        </p>
      </div>
      <div class="overflow-hidden rounded-2xl">
        <img
          src={`${r2Base}/services/inspecting.jpg`}
          alt="Inspecting film"
          class="w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section id="contact" class="mt-20 overflow-hidden rounded-[24px] p-6 md:p-14" style="background: var(--panel);">
    <h2 class="text-4xl md:text-5xl">Contact us</h2>
    <p class="mt-4 max-w-lg text-sm leading-7" style="color: var(--muted);">
      Reach us through any of the channels below. We're happy to answer questions
      about orders, services, or anything film-related.
    </p>

    <div class="mt-10 grid w-full gap-4 sm:grid-cols-2">

      <a href={`mailto:${contact.email}`}
        class="flex min-w-0 items-center gap-4 rounded-2xl border p-5 hover:bg-[var(--bg)] active:bg-[var(--bg)] transition-colors"
        style="border-color: var(--line);">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style="background: var(--bg);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
        </span>
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-widest mb-1" style="color: var(--muted);">Email</div>
          <div class="text-sm font-medium truncate">{contact.email}</div>
        </div>
      </a>

      <a href={`tel:${contact.phone.replace(/\s/g, "")}`}
        class="flex min-w-0 items-center gap-4 rounded-2xl border p-5 hover:bg-[var(--bg)] active:bg-[var(--bg)] transition-colors"
        style="border-color: var(--line);">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style="background: var(--bg);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 5.94 5.94l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-widest mb-1" style="color: var(--muted);">Phone</div>
          <div class="text-sm font-medium truncate">{contact.phone}</div>
        </div>
      </a>

      <a href={contact.telegram} target="_blank" rel="noopener noreferrer"
        class="flex min-w-0 items-center gap-4 rounded-2xl border p-5 hover:bg-[var(--bg)] active:bg-[var(--bg)] transition-colors"
        style="border-color: var(--line);">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style="background: var(--bg);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2L11 13"/>
            <path d="M22 2L15 22l-4-9-9-4 20-7z"/>
          </svg>
        </span>
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-widest mb-1" style="color: var(--muted);">Telegram</div>
          <div class="text-sm font-medium truncate">{contact.phone}</div>
        </div>
      </a>

      <a href={contact.instagram} target="_blank" rel="noopener noreferrer"
        class="flex min-w-0 items-center gap-4 rounded-2xl border p-5 hover:bg-[var(--bg)] active:bg-[var(--bg)] transition-colors"
        style="border-color: var(--line);">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style="background: var(--bg);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-widest mb-1" style="color: var(--muted);">Instagram</div>
          <div class="text-sm font-medium truncate">{contact.instagram_handle}</div>
        </div>
      </a>

    </div>
  </section>

</BaseLayout>
