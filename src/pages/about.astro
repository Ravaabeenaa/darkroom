---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT } from "../lib/contact";
---
<BaseLayout title="About — DARKROOM">
  <h1 class="text-5xl md:text-6xl mt-10">Who we are</h1>

  <section id="contact" class="mt-20 rounded-[24px] p-10" style="background: var(--panel);">
    <h2 class="text-4xl md:text-5xl">Contact us</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--muted);">Email</div>
        <a href={`mailto:${CONTACT.email}`} class="text-sm hover:underline">{CONTACT.email}</a>
      </div>
      <div>
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--muted);">Phone</div>
        <a href={`tel:${CONTACT.phoneTel}`} class="text-sm hover:underline">{CONTACT.phone}</a>
      </div>
      <div>
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--muted);">Telegram</div>
        <a
          href={CONTACT.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.833.941z"/>
          </svg>
          Message us
        </a>
      </div>
      <div>
        <div class="text-xs tracking-widest uppercase mb-2" style="color: var(--muted);">Instagram</div>
        <a
          href={CONTACT.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm hover:underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          {CONTACT.instagramHandle}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
