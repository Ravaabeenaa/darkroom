---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProductCard from "../components/ProductCard.astro";
import Accordion from "../components/Accordion.astro";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type FeaturedRow = {
  id: string;
  slug: string | null;
  name: string;
  price_cents: number;
  primary_image_key: string | null;
};

function money(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}
function imgUrl(key: string | null) {
  if (!key) return null;
  return base ? `${base}/${key}` : `/${key}`;
}
function hrefFor(r: FeaturedRow) {
  return `/shop/${r.slug ?? r.id}`;
}

const featuredRes = await db.prepare(`
  SELECT id, slug, name, price_cents, primary_image_key
  FROM services
  WHERE active = 1 AND featured = 1
  ORDER BY updated_at DESC
  LIMIT 8;
`).all();

const featuredRows = (featuredRes.results ?? []) as FeaturedRow[];

// Your existing services accordion content can stay static for now
const services = [
  { title: "Basic Service", content: "Describe important details like price, value, length of service, and why it’s unique." },
  { title: "Intermediate Service", content: "Add a second service tier with key inclusions and turnaround time." },
  { title: "Advanced Service", content: "Add premium offering details, add-ons, and deliverables." },
];
---

<BaseLayout title="DARKROOM">
  <section class="mx-auto max-w-6xl px-6">
    <div class="mt-12">
      <h1 class="text-5xl" style="font-family: var(--font-serif);">Snap Your World with Us</h1>
      <p class="mt-4 max-w-prose text-sm md:text-base" style="color: var(--muted);">
        Snap, smile, and let your personality shine with our vibrant photo services! Whether it’s capturing the twinkle in your eye or the laughter echoing around, we’re here to make every snapshot a spectacular journey.
      </p>
      <div class="mt-6">
        <Button href="/shop" variant="filled">Shop</Button>
      </div>
    </div>

    <div class="mt-16">
      <SectionHeader title="Featured products" subtitle="Hand-picked items currently highlighted." />

      {featuredRows.length === 0 ? (
        <div class="mt-6 rounded-3xl border border-[var(--line)] bg-white/20 p-6 text-sm" style="color: var(--muted);">
          No featured products yet. Mark services as “Featured” in the admin edit page.
        </div>
      ) : (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {featuredRows.map((p) => (
            <ProductCard
              href={hrefFor(p)}
              image={imgUrl(p.primary_image_key) ?? undefined}
              name={p.name}
              price={money(p.price_cents)}
            />
          ))}
        </div>
      )}
    </div>

    <div class="mt-20">
      <SectionHeader title="Explore our services" subtitle="Capture life’s joyful moments with our playful photo services that turn ordinary snaps into extraordinary stories." />
      <div class="mt-6">
        <Button href="/shop" variant="outline">Learn more</Button>
      </div>
    </div>

    <div class="mt-20">
      <SectionHeader title="Get to know us" subtitle="Tell people about who you are, your origin, your process, or your inspirations." />
      <div class="mt-6">
        <Button href="/shop" variant="outline">Learn more</Button>
      </div>
    </div>

    <div class="mt-20">
      <SectionHeader title="Follow Us" subtitle="Social" />
    </div>

    <div class="mt-16">
      <Accordion items={services} />
    </div>
  </section>
</BaseLayout>