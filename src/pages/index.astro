---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ProductCard from "../components/ProductCard.astro";
import InstagramPost from "../components/InstagramPost.astro";
import { CONTACT } from "../lib/contact";

export const prerender = false;

const db = Astro.locals.runtime.env.darkroom_db as D1Database;
const r2Base = String(Astro.locals.runtime.env.PUBLIC_R2_BASE_URL ?? "").replace(/\/+$/, "");

type FeaturedRow = {
  id: string;
  slug: string | null;
  name: string;
  price_cents: number;
  primary_image_key: string | null;
  turnaround_options: string | null;
  turnaround_prices: string | null;
  pushpull_options: string | null;
  pushpull_prices: string | null;
};

function imgUrl(key: string | null) {
  if (!key) return null;
  return r2Base ? `${r2Base}/${key}` : `/${key}`;
}

function hrefFor(p: FeaturedRow) {
  return `/shop/${p.slug ?? p.id}`;
}

function parseOpts(raw: string | null): string[] {
  try { return JSON.parse(raw || '[]'); } catch { return []; }
}

const featuredRes = await db
  .prepare(`
    SELECT id, slug, name, price_cents, primary_image_key,
           turnaround_options, turnaround_prices, pushpull_options, pushpull_prices
    FROM services
    WHERE active = 1 AND featured = 1
    ORDER BY updated_at DESC
    LIMIT 4;
  `)
  .all();

const featured = (featuredRes.results ?? []) as FeaturedRow[];

type IgPost = {
  id: string;
  image_key: string;
  instagram_url: string;
  caption: string | null;
};

const igRes = await db
  .prepare(`SELECT id, image_key, instagram_url, caption FROM instagram_posts WHERE active = 1 ORDER BY sort_order ASC, created_at DESC LIMIT 4`)
  .all();

const igPosts = (igRes.results ?? []) as IgPost[];

const IG_URL = CONTACT.instagram;

---

<BaseLayout title="DARKROOM">

  <!-- ═══════════════════════════════════════════════════════ HERO -->
  <section class="hero pt-10 md:pt-14">
    <div class="hero-grid">

      <div class="hero-copy">
        <h1 class="hero-h1">
          High&#8209;quality<br/>film services
        </h1>
        <div class="hero-bottom">
          <p class="hero-sub">
            Process, scan, and print your images with people who really love film.
          </p>
          <div class="hero-cta">
            <Button href="/about" size="lg">Learn more</Button>
          </div>
        </div>
      </div>

      <div class="hero-img-col">
        <div class="develop-wrapper" id="heroWrapper">
          <img
            src={`${r2Base}/home/Ektar100_029.dng.png`}
            alt="Film photograph"
            class="hero-img"
            id="heroImg"
            loading="eager"
          />
        </div>
        <div class="exposure-strip" aria-hidden="true">
          <span>Gold 200</span>
          <span>Minolta Sweet Alpha</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════ FEATURED PRODUCTS -->
  <section class="mt-20 md:mt-28">
    <div class="featured-header reveal">
      <div class="featured-label">Featured</div>
      <a href="/shop" class="featured-shopall">Shop all →</a>
    </div>

    <div class="mt-8 product-grid reveal-stagger">
      {featured.length === 0 ? (
        <div class="col-span-4 rounded-3xl border border-[var(--line)] bg-white/20 p-6 text-sm reveal" style="color: var(--muted);">
          No featured products yet.
        </div>
      ) : (
        featured.map((p) => (
          <div class="reveal card-lift">
            <ProductCard
              id={p.id}
              href={hrefFor(p)}
              image={imgUrl(p.primary_image_key) ?? undefined}
              name={p.name}
              priceCents={p.price_cents}
              turnaroundOptions={parseOpts(p.turnaround_options)}
              turnaroundPrices={parseOpts(p.turnaround_prices)}
              pushpullOptions={parseOpts(p.pushpull_options)}
              pushpullPrices={parseOpts(p.pushpull_prices)}
            />
          </div>
        ))
      )}
    </div>
  </section>

  <!-- ════════════════════════════════════════════ STATEMENT -->
  <div class="statement-wrap reveal">
    <img
      src="/images/35mm-Strip.jpeg"
      alt=""
      aria-hidden="true"
      class="statement-film"
    />
    <blockquote class="statement">
      Every frame tells&nbsp;a&nbsp;story.<br/>
      <em>We develop yours.</em>
    </blockquote>
  </div>

  <!-- ══════════════════════════════════════════════ SERVICES -->
  <section class="services-section">
    <div class="services-img reveal">
      <div class="img-frame gallery-wrap">
        <img
          src={`${r2Base}/services/inspecting.jpg`}
          alt="Services"
          class="services-img-el gallery-img"
          loading="lazy"
        />
        <div class="gallery-overlay" aria-hidden="true"></div>
      </div>
    </div>

    <div class="services-copy reveal">
      <div class="services-heading-wrap">

        <h2 class="section-heading">Explore our<br/>services</h2>
      </div>
      <p class="section-body">
        We sell cameras and film, develop and scan your rolls, colour grade your scans, and rent
        out cameras and other photography equipment - everything you need, start to finish.
      </p>
      <div class="mt-10">
        <Button href="/services" size="lg">Learn more</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ GET TO KNOW US -->
  <section class="about-section mt-24 md:mt-32">
    <div class="about-header reveal">
      <div>
        <div class="services-heading-wrap">

          <h2 class="section-heading">Get to<br/>know us</h2>
        </div>
      </div>
      <div class="about-header-right">
        <p class="section-body" style="max-width: 320px;">
          Tell people about who you are, your origin, your process, or your inspirations.
        </p>
        <div class="mt-8">
          <Button href="/about" size="lg">Learn more</Button>
        </div>
      </div>
    </div>

    <div class="about-images mt-12 md:mt-16">
      <div class="about-img-a reveal">
        <div class="img-frame gallery-wrap">
          <img
            src={`${r2Base}/home/Gold200_025.dng.png`}
            alt="Film photograph"
            class="about-img-el gallery-img"
            loading="lazy"
          />
          <div class="gallery-overlay" aria-hidden="true"></div>
        </div>
      </div>

      <div class="about-img-b reveal">
        <div class="img-frame gallery-wrap">
          <img
            src={`${r2Base}/home/Ektar100_028.dng.png`}
            alt="Film photograph"
            class="about-img-el gallery-img"
            loading="lazy"
          />
          <div class="gallery-overlay" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════ FOLLOW US -->
  <section class="mt-24 md:mt-32 pb-16">
    <div class="follow-header reveal">
      <div>
        <div class="services-heading-wrap">

          <h2 class="section-heading">Follow Us</h2>
        </div>
      </div>
      <div class="pt-2">
        <a href={IG_URL} target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" class="ig-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
    </div>

    {igPosts.length > 0 ? (
      <div class="gallery-grid mt-10 reveal-stagger">
        {igPosts.map((post, i) => (
          <InstagramPost
            imageUrl={imgUrl(post.image_key) ?? ""}
            instagramUrl={post.instagram_url}
            caption={post.caption}
            class={`reveal gallery-${["a","b","c","d"][i] ?? "d"}`}
          />
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-3xl border p-10 text-center text-sm" style="border-color: var(--line); color: var(--muted);">
        Follow us on <a href={IG_URL} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--text);">Instagram</a> to see our work.
      </div>
    )}
  </section>

  <style>
    /* ─── HERO ──────────────────────────────────────────────────── */
    .hero-grid {
      display: grid;
      gap: 32px;
      align-items: start;
    }
    @media (min-width: 768px) {
      .hero-grid {
        grid-template-columns: 5fr 7fr;
        gap: 48px;
        align-items: stretch;
      }
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      padding-top: 8px;
    }
    @media (min-width: 768px) {
      .hero-copy {
        justify-content: space-between;
        min-height: 480px;
      }
    }

    .hero-h1 {
      font-size: clamp(52px, 9vw, 116px);
      line-height: 0.88;
      letter-spacing: 0.01em;
      animation: clipUp 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    }

    .hero-bottom {
      margin-top: 40px;
      animation: fadeUp 0.9s ease 0.75s both;
    }

    .hero-sub {
      max-width: 380px;
      font-size: 14px;
      line-height: 1.7;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 28px;
    }

    .hero-img-col {
      animation: fadeUp 1s ease 0.2s both;
    }

    .develop-wrapper {
      position: relative;
      overflow: hidden;
    }

    .hero-img {
      display: block;
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      animation: heroImgIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
      will-change: transform;
    }
    @media (min-width: 768px) {
      .hero-img {
        aspect-ratio: auto;
        height: 520px;
      }
    }

    @keyframes heroImgIn {
      from { opacity: 0; transform: scale(1.04); }
      to   { opacity: 1; transform: scale(1); }
    }

    .exposure-strip {
      display: flex;
      gap: 16px;
      padding: 6px 0 0;
      margin-top: 5px;
      font-family: var(--font-sans);
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
      border-top: 1px solid var(--line);
      animation: fadeUp 0.8s ease 2s both;
    }

    /* ─── FEATURED ────────────────────────────────────────────── */
    .featured-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 16px;
    }
    .featured-label {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 56px);
      line-height: 1;
      letter-spacing: 0.01em;
    }
    .featured-shopall {
      font-family: var(--font-sans);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.2s ease;
      white-space: nowrap;
    }
    .featured-shopall:hover { color: var(--text); }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    @media (min-width: 768px) {
      .product-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }
    }

    .card-lift {
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-lift:hover { transform: translateY(-5px); }

    /* ─── STATEMENT ───────────────────────────────────────────── */
    .statement-wrap {
      margin: 72px 0;
      padding: 60px 0;
      position: relative;
      overflow: hidden;
    }
    .statement-film {
      position: absolute;
      right: 0;
      top: 0;
      height: 100%;
      width: auto;
      object-fit: cover;
      opacity: 0.8;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 60%);
      mask-image: linear-gradient(to right, transparent 0%, black 60%);
      pointer-events: none;
    }
    .statement {
      font-family: var(--font-display);
      font-size: clamp(36px, 6vw, 80px);
      line-height: 1.0;
      letter-spacing: 0.01em;
      max-width: 900px;
      margin: 0;
      position: relative;
      z-index: 1;
    }
    .statement em {
      color: var(--red);
      font-style: italic;
    }

    .services-heading-wrap {
      border-bottom: 1px solid var(--line);
      padding-bottom: 16px;
      margin-bottom: 20px;
    }

    /* ─── SERVICES ────────────────────────────────────────────── */
    .services-section {
      display: grid;
      gap: 40px;
      align-items: center;
      margin-top: 24px;
    }
    @media (min-width: 768px) {
      .services-section {
        grid-template-columns: 6fr 5fr;
        gap: 64px;
        margin-top: 0;
      }
    }

    .services-img-el {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      display: block;
    }
    @media (min-width: 768px) {
      .services-img-el {
        aspect-ratio: auto;
        height: 540px;
      }
    }

    /* ─── SECTION SHARED ──────────────────────────────────────── */
    .section-heading {
      font-size: clamp(40px, 5vw, 64px);
      line-height: 0.95;
      letter-spacing: 0.01em;
      margin-bottom: 20px;
    }
    .section-body {
      font-size: 13px;
      line-height: 1.75;
      color: var(--muted);
    }

    /* ─── IMG FRAME ───────────────────────────────────────────── */
    .img-frame {
      position: relative;
      overflow: hidden;
    }

    /* ─── ABOUT ───────────────────────────────────────────────── */
    .about-header {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    @media (min-width: 768px) {
      .about-header {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
        gap: 64px;
      }
    }

    .about-images {
      display: grid;
      gap: 16px;
      align-items: end;
    }
    @media (min-width: 768px) {
      .about-images {
        grid-template-columns: 5fr 7fr;
        gap: 24px;
      }
    }

    .about-img-el {
      width: 100%;
      object-fit: cover;
      display: block;
    }
    .about-img-a .about-img-el { aspect-ratio: 3/4; }
    .about-img-b .about-img-el { aspect-ratio: 4/3; }

    @media (min-width: 768px) {
      .about-img-a { padding-top: 48px; }
    }

    /* ─── FOLLOW ──────────────────────────────────────────────── */
    .follow-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 4px;
    }
    .ig-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-radius: 999px;
      background: var(--btn);
      color: var(--btnText);
      font-family: var(--font-sans);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .ig-btn:hover { opacity: 0.85; transform: translateY(-2px); }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    @media (min-width: 768px) {
      .gallery-grid {
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 16px;
      }
      .gallery-a { grid-row: 1 / 3; }
    }

    /* ─── SHARED GALLERY HOVER (applied to all content images) ── */
    .gallery-wrap {
      position: relative;
      overflow: hidden;
    }
    .gallery-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }
    /* Follow grid images need aspect ratio */
    .gallery-grid .gallery-img { aspect-ratio: 4/3; }
    .gallery-a .gallery-img    { aspect-ratio: auto; min-height: 100%; }

    .gallery-wrap:hover .gallery-img {
      transform: scale(1.05);
    }
    .gallery-overlay {
      position: absolute; inset: 0;
      border: 2px solid transparent;
      transition: border-color 0.3s ease;
      pointer-events: none;
      z-index: 2;
    }
    .gallery-wrap:hover .gallery-overlay {
      border-color: color-mix(in srgb, var(--red) 50%, transparent);
    }


    /* ─── SCROLL REVEAL ───────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
    .reveal-stagger .reveal:nth-child(1) { transition-delay: 0s; }
    .reveal-stagger .reveal:nth-child(2) { transition-delay: 0.11s; }
    .reveal-stagger .reveal:nth-child(3) { transition-delay: 0.22s; }
    .reveal-stagger .reveal:nth-child(4) { transition-delay: 0.33s; }

    /* ─── KEYFRAMES ───────────────────────────────────────────── */
    @keyframes clipUp {
      from {
        opacity: 0;
        transform: translateY(32px);
        clip-path: inset(0 0 100% 0);
      }
      to {
        opacity: 1;
        transform: none;
        clip-path: inset(0 0 0% 0);
      }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: none; }
    }
  </style>

  <script is:inline>
    (function () {
      /* Scroll reveal */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll(".reveal").forEach(function (el) {
        io.observe(el);
      });

      /* Hero parallax — image drifts up slowly as page scrolls */
      var heroImg = document.getElementById("heroImg");
      var heroWrapper = document.getElementById("heroWrapper");
      if (heroImg && heroWrapper) {
        window.addEventListener("scroll", function () {
          var scrolled = window.scrollY;
          var limit = heroWrapper.offsetHeight;
          if (scrolled <= limit) {
            heroImg.style.transform = "translateY(" + (scrolled * 0.18) + "px)";
          }
        }, { passive: true });
      }
    })();
  </script>

</BaseLayout>
