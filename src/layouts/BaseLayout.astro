---
import "../styles/tailwind.css";
const { title = "DARKROOM" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      /* Apply saved theme before paint to avoid flash */
      (function () {
        const t = localStorage.getItem("dr_theme_v1") || "dark";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <script is:inline>
      (function () {
        const CART_KEY = "dr_cart_v1";

        function load() {
          try { return JSON.parse(localStorage.getItem(CART_KEY) || "{}") || {}; }
          catch { return {}; }
        }

        function save(cart) {
          localStorage.setItem(CART_KEY, JSON.stringify(cart));
          window.dispatchEvent(new CustomEvent("dr-cart-changed", { detail: cart }));
        }

        function getQty(id) {
          const cart = load();
          return Math.max(0, Number(cart[id] || 0));
        }

        function setQty(id, qty) {
          const cart = load();
          const q = Math.max(0, Number(qty || 0));
          if (q <= 0) delete cart[id];
          else cart[id] = q;
          save(cart);
        }

        function inc(id) { setQty(id, getQty(id) + 1); }
        function dec(id) { setQty(id, getQty(id) - 1); }

        function countItems() {
          const cart = load();
          let n = 0;
          for (const k in cart) n += Math.max(0, Number(cart[k] || 0));
          return n;
        }

        function formatMVR(cents) {
          const n = Number(cents || 0) / 100;
          return `MVR ${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function toast(msg) {
          const el = document.getElementById("drToast");
          if (!el) return;
          el.textContent = msg;
          el.style.display = "block";
          clearTimeout(el.__t);
          el.__t = setTimeout(() => (el.style.display = "none"), 1600);
        }

        window.DarkroomCart = { load, save, getQty, setQty, inc, dec, countItems, formatMVR, toast };

        // also update header cart count when cart changes
        function syncHeaderCount() {
          const el = document.getElementById("drCartCount");
          if (!el) return;
          const n = countItems();
          el.style.display = n > 0 ? "inline-flex" : "none";
          el.textContent = n > 0 ? String(n) : "";
        }

        window.addEventListener("dr-cart-changed", syncHeaderCount);
        window.addEventListener("DOMContentLoaded", syncHeaderCount);
      })();
    </script>
  </head>
  <body>
    <div class="min-h-screen">
      <header class="sticky top-0 z-30 px-6 py-4 bg-[var(--red)]">
        <div class="mx-auto flex max-w-[var(--container)] items-center justify-between">
          <a href="/" class="block" aria-label="Darkroom home">
            <img src="/images/logos/logo-dark.png" alt="darkroom by smolbo1" class="h-8 w-auto" />
          </a>

          <nav class="hidden gap-8 text-sm font-medium text-black md:flex items-center">
            <a href="/shop" class="hover:opacity-70">Shop</a>
            <a href="/about" class="hover:opacity-70">About</a>
            <a href="/cart" class="relative flex items-center hover:opacity-70">
              Cart
              <span id="drCartCount" class="ml-2 inline-flex min-w-[22px] items-center justify-center rounded-full bg-black px-2 py-0.5 text-xs text-white" style="display:none"></span>
            </a>

            <!-- Theme switcher (desktop) -->
            <div id="drThemeWrapper" class="relative">
              <button id="drThemeBtn" class="flex cursor-pointer items-center gap-1 rounded-xl border border-black/20 px-3 py-1.5 text-xs font-medium text-black hover:bg-black/10" aria-label="Switch theme">
                <span id="drThemeLabel">Dark</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="opacity-60"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div id="drThemeMenu" class="absolute right-0 top-full z-50 mt-1 hidden min-w-[100px] overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--bg)] text-[var(--text)] shadow-lg">
                <button data-theme-opt="dark" class="w-full cursor-pointer px-4 py-2.5 text-left text-xs hover:bg-[var(--panel)]">Dark</button>
                <button data-theme-opt="light" class="w-full cursor-pointer px-4 py-2.5 text-left text-xs hover:bg-[var(--panel)]">Light</button>
              </div>
            </div>
          </nav>

          <button id="drMenuBtn" class="md:hidden flex flex-col justify-center items-center gap-[5px] w-10 h-10 rounded-xl text-black" aria-label="Open menu">
            <span class="block h-[2px] w-6 bg-current"></span>
            <span class="block h-[2px] w-6 bg-current"></span>
            <span class="block h-[2px] w-6 bg-current"></span>
          </button>
        </div>
      </header>

      <main class="px-6">
        <div class="mx-auto max-w-[var(--container)]">
          <slot />
        </div>
      </main>

      <footer class="mt-24 px-6 pb-16 pt-12">
        <div class="mx-auto max-w-[var(--container)] border-t" style="border-color: var(--line);">
          <div class="grid gap-10 py-10 md:grid-cols-3">
            <div>
              <img src="/images/logos/logo-light.png" alt="darkroom by smolbo1" class="logo-for-dark h-7 w-auto" />
              <img src="/images/logos/logo-dark.png" alt="darkroom by smolbo1" class="logo-for-light h-7 w-auto" />
            </div>

            <div class="text-sm">
              <div class="mb-3 font-medium">Explore</div>
              <div class="grid gap-2">
                <a href="/about">About us</a>
                <a href="/about#contact">Contact</a>
                <a href="/shop">Shop</a>
                <a href="/services">Services</a>
              </div>
            </div>

            <div class="text-sm">
              <div class="mb-3 font-medium">Contact</div>
              <div class="grid gap-2" style="color: var(--muted);">
                <div>Email: hello@darkroom.mv</div>
                <div>Phone: +960 000-0000</div>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </div>
    <div id="drToast" class="fixed bottom-5 left-1/2 z-50 -translate-x-1/2 rounded-2xl px-4 py-3 text-sm font-medium shadow-lg" style="display:none;background:var(--text);color:var(--bg);"></div>

    <!-- Mobile menu drawer -->
    <div id="drMenuOverlay" class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm" style="display:none" aria-hidden="true"></div>
    <nav id="drMenuDrawer" class="fixed inset-y-0 right-0 z-50 flex w-72 flex-col bg-[var(--bg)] px-8 py-8 shadow-2xl" style="display:none" aria-label="Mobile navigation">
      <div class="flex items-center justify-between">
        <a href="/" aria-label="Darkroom home">
          <img src="/images/logos/logo-light.png" alt="darkroom by smolbo1" class="h-7 w-auto" />
        </a>
        <button id="drMenuClose" class="flex h-10 w-10 items-center justify-center rounded-xl text-2xl leading-none" aria-label="Close menu">×</button>
      </div>
      <div class="mt-12 flex flex-col gap-6 text-xl">
        <a href="/shop" class="hover:opacity-70">Shop</a>
        <a href="/about" class="hover:opacity-70">About</a>
        <a href="/cart" class="relative flex items-center gap-3 hover:opacity-70">
          Cart
          <span id="drCartCountMobile" class="inline-flex min-w-[22px] items-center justify-center rounded-full bg-[var(--red)] px-2 py-0.5 text-xs text-black" style="display:none"></span>
        </a>
      </div>

      <!-- Mobile theme switcher -->
      <div class="mt-auto pt-8 border-t border-[var(--line)]">
        <div class="text-xs mb-3" style="color:var(--muted);">Theme</div>
        <div class="flex gap-2">
          <button data-theme-opt="dark" class="cursor-pointer flex-1 rounded-xl border border-[var(--line)] px-3 py-2 text-sm hover:bg-[var(--panel)]">Dark</button>
          <button data-theme-opt="light" class="cursor-pointer flex-1 rounded-xl border border-[var(--line)] px-3 py-2 text-sm hover:bg-[var(--panel)]">Light</button>
        </div>
      </div>
    </nav>

    <script is:inline>
      /* Theme switcher */
      (function () {
        const THEME_KEY = "dr_theme_v1";
        const LABELS = { dark: "Dark", light: "Light" };

        function applyTheme(t) {
          document.documentElement.setAttribute("data-theme", t);
          localStorage.setItem(THEME_KEY, t);
          const lbl = document.getElementById("drThemeLabel");
          if (lbl) lbl.textContent = LABELS[t] || t;
        }

        // Init label from current theme
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        const lbl = document.getElementById("drThemeLabel");
        if (lbl) lbl.textContent = LABELS[current] || current;

        // Desktop dropdown toggle
        const themeBtn = document.getElementById("drThemeBtn");
        const themeMenu = document.getElementById("drThemeMenu");
        themeBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          themeMenu?.classList.toggle("hidden");
        });
        document.addEventListener("click", () => themeMenu?.classList.add("hidden"));

        // All theme option buttons (desktop + mobile)
        document.querySelectorAll("[data-theme-opt]").forEach((el) => {
          el.addEventListener("click", () => {
            applyTheme(el.getAttribute("data-theme-opt"));
            themeMenu?.classList.add("hidden");
          });
        });
      })();
    </script>

    <script is:inline>
      (function () {
        const btn = document.getElementById("drMenuBtn");
        const overlay = document.getElementById("drMenuOverlay");
        const drawer = document.getElementById("drMenuDrawer");
        const closeBtn = document.getElementById("drMenuClose");

        function open() {
          overlay.style.display = "block";
          drawer.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
        function close() {
          overlay.style.display = "none";
          drawer.style.display = "none";
          document.body.style.overflow = "";
        }

        btn?.addEventListener("click", open);
        closeBtn?.addEventListener("click", close);
        overlay?.addEventListener("click", close);

        // Keep mobile cart count in sync
        function syncMobileCount() {
          const n = window.DarkroomCart?.countItems() ?? 0;
          const el = document.getElementById("drCartCountMobile");
          if (!el) return;
          el.style.display = n > 0 ? "inline-flex" : "none";
          el.textContent = n > 0 ? String(n) : "";
        }
        window.addEventListener("dr-cart-changed", syncMobileCount);
        window.addEventListener("DOMContentLoaded", syncMobileCount);
      })();
    </script>
  </body>
</html>
